# Production domain, used for canonical URLs, the sitemap and robots.txt.
# Optional on Netlify: its own URL variable is used when this is unset.
SITE_URL=https://www.youragency.com

# Where the contact form POSTs its JSON (Formspree, Basin, your own API...).
# Leave empty to run the form in demo mode: it validates and shows the
# success state but sends nothing.
PUBLIC_CONTACT_ENDPOINT=
