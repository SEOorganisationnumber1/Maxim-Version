# Copy to .env for local work. On Netlify, set the same names under
# Project configuration > Environment variables, then redeploy.

# Production domain, used for canonical URLs, the sitemap, robots.txt and share images.
# Optional on Netlify: its own URL variable is used when this is unset.
SITE_URL=https://www.your-domain.com

# Password for /admin (at least 12 characters).
ADMIN_PASSWORD=

# Email alert for every new brief, sent with Resend (https://resend.com, free plan is enough).
# RESEND_API_KEY: an API key with "Sending access".
# BRIEF_NOTIFY_TO: where alerts go; several addresses can be separated by commas. Until a domain
#   is verified in Resend, this must be the email address of your Resend account.
# BRIEF_NOTIFY_FROM: optional, e.g. "Briefs <briefs@yourdomain.com>" once the domain is verified.
RESEND_API_KEY=
BRIEF_NOTIFY_TO=
BRIEF_NOTIFY_FROM=

# Cookie-free analytics with Umami Cloud (https://umami.is): the website ID from its settings.
UMAMI_WEBSITE_ID=

# HTML-tag verification codes: only the content="..." value.
# Google Search Console (URL prefix property) and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
