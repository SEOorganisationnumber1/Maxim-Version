# Production domain, used for canonical URLs, the sitemap and robots.txt.
# Optional on Netlify: its own URL variable is used when this is unset.
SITE_URL=https://www.youragency.com

# Password for /admin (at least 12 characters). On Netlify set it under
# Project configuration > Environment variables; locally put it in .env.
ADMIN_PASSWORD=

# Optional: send briefs somewhere else (Formspree, your own API...).
# Empty = the site's own inbox at /api/brief, read in /admin.
PUBLIC_CONTACT_ENDPOINT=
