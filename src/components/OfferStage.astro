---
// The picture next to an offer page's title: a still, drawn example of the kind of thing the page
// sells, in the look of Home's Workbench tiles, set in the tinted wave well of the project cards.
// Nothing moves. Screen readers get one sentence (the label) instead of the drawing.
import Icon from './Icon.astro';
import type { Offer } from '../data/offers';

interface Props {
  kind: Offer['stage'];
  tone: Offer['tone'];
}

const { kind, tone } = Astro.props;

const labels: Record<Offer['stage'], string> = {
  bot: 'Example: a Telegram bot that books a table, with reply buttons under its messages.',
  'mini-app': 'Example: a store opened as a Mini App inside Telegram, with an order button at the bottom.',
  extension: 'Example: a browser extension open from the toolbar, saving the page to a workspace.',
  desktop: 'Example: a desktop app window working offline, with an update ready to install.',
};

const gradients: Record<Offer['tone'], [string, string]> = {
  cyan: ['#22D3DD', '#2F8CF6'],
  blue: ['#2FB4F0', '#5B4FE9'],
  violet: ['#2F8CF6', '#5B4FE9'],
};
const [from, to] = gradients[tone];
const gradientId = `stage-${kind}`;
---

<div class:list={['stage', `stage--${tone}`, `stage--${kind}`]} role="img" aria-label={labels[kind]}>
  <svg class="stage__wave" aria-hidden="true" viewBox="0 0 600 560" preserveAspectRatio="xMidYMid slice" fill="none">
    <defs>
      <linearGradient id={gradientId} x1="0" y1="0" x2="600" y2="560" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color={from}></stop>
        <stop offset="1" stop-color={to}></stop>
      </linearGradient>
    </defs>
    <path
      d="M-60 470 C 110 330, 230 560, 380 400 C 500 270, 520 110, 680 130"
      stroke={`url(#${gradientId})`}
      stroke-width="76"
      stroke-linecap="round"></path>
  </svg>

  {
    kind === 'bot' && (
      <div class="chat">
        <div class="chat__head">
          <span class="chat__avatar">T</span>
          <span class="chat__who">
            <b>Table booking</b>
            <small>bot</small>
          </span>
        </div>
        <div class="chat__log">
          <p class="msg msg--bot">Hi! When would you like a table?</p>
          <div class="keys">
            <span>Tonight</span>
            <span>Tomorrow</span>
            <span>Pick a date</span>
          </div>
          <p class="msg msg--me">Tomorrow, 8 pm, for two</p>
          <p class="msg msg--bot">Booked: a table for two, tomorrow at 8 pm. We'll remind you an hour before.</p>
          <div class="keys">
            <span>Change</span>
            <span>Cancel</span>
          </div>
        </div>
        <div class="chat__input">
          <span>Message</span>
          <i />
        </div>
      </div>
    )
  }

  {
    kind === 'mini-app' && (
      <div class="phone">
        <div class="phone__screen">
          <div class="ma__bar">
            <span class="ma__close">Close</span>
            <span class="ma__title">
              <b>Shop</b>
              <small>mini app</small>
            </span>
            <span class="ma__more">
              <i />
              <i />
              <i />
            </span>
          </div>
          <div class="ma__search" />
          <div class="ma__chips">
            <i class="is-on" />
            <i />
            <i />
          </div>
          <div class="ma__grid">
            {(['cyan', 'blue', 'violet', 'cyan'] as const).map((tint, i) => (
              <div class="ma__card">
                <span class:list={['ma__img', `ma__img--${tint}`]} />
                <b />
                <i />
                <span class:list={['ma__add', { 'is-added': i < 2 }]}>{i < 2 ? '1' : '+'}</span>
              </div>
            ))}
          </div>
          <div class="ma__main">View order · 2 items</div>
        </div>
      </div>
    )
  }

  {
    kind === 'extension' && (
      <div class="browser">
        <div class="browser__bar">
          <span class="browser__dots">
            <i />
            <i />
            <i />
          </span>
          <span class="browser__url">example.com/article</span>
          <span class="browser__tools">
            <i />
            <i class="is-ours" />
          </span>
        </div>
        <div class="browser__page">
          <span class="pg pg--title" />
          <span class="pg" />
          <span class="pg pg--mark" />
          <span class="pg pg--short" />
          <span class="pg pg--image" />
          <span class="pg" />
          <span class="pg pg--short" />
        </div>
        <div class="popup">
          <div class="popup__head">
            <i />
            <b>Your extension</b>
          </div>
          <p class="popup__text">1 highlight on this page</p>
          <div class="popup__row">
            <span>Active on this site</span>
            <span class="popup__switch" />
          </div>
          <span class="popup__btn">Save to workspace</span>
        </div>
      </div>
    )
  }

  {
    kind === 'desktop' && (
      <div class="win">
        <div class="win__bar">
          <span class="win__dots">
            <i />
            <i />
            <i />
          </span>
          <b>Your app</b>
          <span class="win__status">
            <i />
            Saved offline
          </span>
        </div>
        <div class="win__body">
          <div class="win__side">
            <span class="is-on">
              <i />
              <b />
            </span>
            <span>
              <i />
              <b />
            </span>
            <span>
              <i />
              <b />
            </span>
            <span>
              <i />
              <b />
            </span>
          </div>
          <div class="win__main">
            <div class="win__head">
              <b />
              <span />
            </div>
            <div class="win__rows">
              {[0, 1, 2, 3].map((i) => (
                <span class:list={{ 'is-done': i < 2 }}>
                  <i>{i < 2 && <Icon name="check" size={10} strokeWidth={3.4} />}</i>
                  <b />
                  <em />
                </span>
              ))}
            </div>
          </div>
        </div>
        <div class="win__toast">
          <span>
            <b>Update ready</b>
            <small>Installs on restart</small>
          </span>
          <span class="win__restart">Restart</span>
        </div>
      </div>
    )
  }
</div>

<style>
  /* ---------- Well ---------- */

  .stage {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    min-height: 460px;
    padding: 40px 28px;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-tile);
    font-family: var(--font-body);
    color: var(--ink);
    user-select: none;
  }
  .stage--cyan {
    background: var(--tint-cyan);
  }
  .stage--blue {
    background: var(--tint-blue);
  }
  .stage--violet {
    background: var(--tint-violet);
  }
  .stage__wave {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .stage > :not(.stage__wave) {
    position: relative;
  }
  /* A shared drop shadow for every drawn device. */
  .chat,
  .phone,
  .browser,
  .win {
    box-shadow: 0 24px 50px -28px rgb(10 17 40 / 0.45);
  }

  /* ---------- Telegram bot ---------- */

  .chat {
    width: 100%;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    background: #e7eef4;
    border: 1px solid rgb(10 17 40 / 0.08);
    border-radius: 20px;
    overflow: hidden;
  }
  .chat__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--white);
    border-bottom: 1px solid var(--line-soft);
    font-size: 14px;
  }
  .chat__avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--teal);
    color: var(--white);
    font-weight: 800;
  }
  .chat__who {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .chat__who small {
    color: var(--muted);
    font-size: 12px;
  }
  .chat__log {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 12px;
  }
  .msg {
    margin: 0;
    max-width: 86%;
    padding: 8px 12px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.4;
  }
  .msg--bot {
    align-self: flex-start;
    background: var(--white);
    border-bottom-left-radius: 6px;
  }
  .msg--me {
    align-self: flex-end;
    margin-top: 6px;
    background: #d6f2df;
    border-bottom-right-radius: 6px;
  }
  /* Telegram's inline keyboard: buttons attached under the bot's message. */
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    max-width: 86%;
  }
  .keys span {
    flex: 1 1 auto;
    padding: 7px 10px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.7);
    color: var(--teal-ink);
    font-size: 13px;
    font-weight: 700;
    text-align: center;
  }
  .chat__input {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px;
    background: var(--white);
    border-top: 1px solid var(--line-soft);
    font-size: 14px;
    color: var(--muted);
  }
  .chat__input i {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--teal);
  }

  /* ---------- Mini App ---------- */

  .phone {
    width: 244px;
    padding: 7px;
    border-radius: 36px;
    background: var(--ink);
  }
  .phone__screen {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 452px;
    padding: 12px 12px 14px;
    border-radius: 30px;
    background: var(--white);
    overflow: hidden;
  }
  .ma__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 6px 2px 4px;
    font-size: 13px;
  }
  .ma__close {
    color: var(--teal-ink);
    font-weight: 600;
  }
  .ma__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.2;
  }
  .ma__title small {
    font-size: 11px;
    color: var(--muted);
  }
  .ma__more {
    justify-self: end;
    display: flex;
    gap: 3px;
  }
  .ma__more i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ink-2);
  }
  .ma__search {
    height: 30px;
    border-radius: 10px;
    background: var(--paper);
    border: 1px solid var(--line-soft);
  }
  .ma__chips {
    display: flex;
    gap: 6px;
  }
  .ma__chips i {
    width: 52px;
    height: 22px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line-soft);
  }
  .ma__chips i.is-on {
    background: var(--ink);
    border-color: var(--ink);
  }
  .ma__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .ma__card {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 6px 6px 10px;
    border-radius: 14px;
    background: var(--paper);
  }
  .ma__img {
    height: 74px;
    border-radius: 10px;
  }
  .ma__img--cyan {
    background: var(--tint-cyan);
  }
  .ma__img--blue {
    background: var(--tint-blue);
  }
  .ma__img--violet {
    background: var(--tint-violet);
  }
  .ma__card b {
    height: 8px;
    width: 76%;
    border-radius: 999px;
    background: var(--ink);
  }
  .ma__card i {
    height: 6px;
    width: 46%;
    border-radius: 999px;
    background: #cfd7e2;
  }
  .ma__add {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--line);
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
  }
  .ma__add.is-added {
    background: var(--teal);
    border-color: var(--teal);
    color: var(--white);
  }
  /* Telegram's main button, pinned to the bottom of the Mini App. */
  .ma__main {
    margin-top: auto;
    padding: 12px;
    border-radius: 14px;
    background: var(--teal);
    color: var(--white);
    font-size: 14px;
    font-weight: 700;
    text-align: center;
  }

  /* ---------- Browser extension ---------- */

  .browser {
    position: relative;
    width: 100%;
    max-width: 480px;
    background: var(--white);
    border: 1px solid rgb(10 17 40 / 0.1);
    border-radius: 16px;
  }
  .browser__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line-soft);
  }
  .browser__dots {
    display: flex;
    gap: 5px;
  }
  .browser__dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line);
  }
  .browser__url {
    flex: 1;
    min-width: 0;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--paper);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .browser__tools {
    display: flex;
    gap: 8px;
  }
  .browser__tools i {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: var(--line);
  }
  .browser__tools i.is-ours {
    background: var(--teal);
    box-shadow: 0 0 0 3px var(--tint-cyan);
  }
  .browser__page {
    display: grid;
    gap: 10px;
    padding: 24px 22px 28px;
  }
  .pg {
    height: 8px;
    width: 88%;
    border-radius: 999px;
    background: #dde3eb;
  }
  .pg--title {
    height: 14px;
    width: 58%;
    margin-bottom: 6px;
    background: var(--ink);
  }
  .pg--short {
    width: 52%;
  }
  /* The extension marks a line on the page. */
  .pg--mark {
    width: 74%;
    height: 12px;
    background: rgb(28 202 216 / 0.45);
  }
  .pg--image {
    height: 96px;
    width: 100%;
    margin: 6px 0;
    border-radius: 12px;
    background: var(--tint-violet);
  }
  .popup {
    position: absolute;
    top: 46px;
    right: 10px;
    width: 220px;
    display: grid;
    gap: 12px;
    padding: 16px;
    background: var(--white);
    border: 1px solid var(--line-soft);
    border-radius: 16px;
    box-shadow: 0 22px 46px -18px rgb(10 17 40 / 0.4);
    font-size: 13px;
  }
  .popup__head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }
  .popup__head i {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: var(--teal);
  }
  .popup__text {
    margin: 0;
    color: var(--ink-2);
  }
  .popup__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--line-soft);
    font-weight: 600;
  }
  .popup__switch {
    position: relative;
    flex: none;
    width: 34px;
    height: 20px;
    border-radius: 999px;
    background: var(--teal);
  }
  .popup__switch::after {
    content: '';
    position: absolute;
    top: 2px;
    right: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--white);
  }
  .popup__btn {
    padding: 10px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-weight: 700;
    text-align: center;
  }

  /* ---------- Desktop app ---------- */

  .win {
    position: relative;
    width: 100%;
    max-width: 500px;
    background: var(--white);
    border: 1px solid rgb(10 17 40 / 0.1);
    border-radius: 14px;
    overflow: hidden;
  }
  .win__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line-soft);
    background: var(--paper);
    font-size: 12px;
  }
  .win__dots {
    position: absolute;
    left: 12px;
    display: flex;
    gap: 6px;
  }
  .win__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }
  .win__body {
    display: grid;
    grid-template-columns: 30% 1fr;
    min-height: 300px;
  }
  .win__side {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 8px;
    border-right: 1px solid var(--line-soft);
    background: #f9fbfd;
  }
  .win__side span {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border-radius: 8px;
  }
  .win__side span.is-on {
    background: var(--tint-cyan);
  }
  .win__side i {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: #cfd7e2;
  }
  .win__side .is-on i {
    background: var(--teal);
  }
  .win__side b {
    height: 6px;
    width: 70%;
    border-radius: 999px;
    background: #cfd7e2;
  }
  .win__main {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px;
  }
  .win__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .win__head b {
    height: 12px;
    width: 42%;
    border-radius: 999px;
    background: var(--ink);
  }
  .win__head span {
    height: 24px;
    width: 64px;
    border-radius: 999px;
    background: var(--ink);
  }
  .win__rows {
    display: grid;
    gap: 6px;
  }
  .win__rows span {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border: 1px solid var(--line-soft);
    border-radius: 10px;
  }
  .win__rows i {
    flex: none;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 5px;
    border: 1.5px solid #cfd7e2;
    color: var(--white);
  }
  .win__rows .is-done i {
    background: var(--teal);
    border-color: var(--teal);
  }
  .win__rows b {
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: #cfd7e2;
  }
  .win__rows em {
    width: 36px;
    height: 6px;
    border-radius: 999px;
    background: var(--line-soft);
  }
  /* Offline-first: the title bar says the work is safe without a connection. */
  .win__status {
    position: absolute;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }
  .win__status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e3a008;
  }
  .win__toast {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 12px 12px 14px;
    background: var(--ink);
    color: var(--white);
    border-radius: 14px;
    box-shadow: 0 16px 34px -16px rgb(10 17 40 / 0.6);
    font-size: 13px;
  }
  .win__toast > span:first-child {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .win__toast small {
    font-size: 11px;
    color: var(--footer-text);
  }
  .win__restart {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--cyan);
    color: var(--ink);
    font-weight: 700;
  }

  /* ---------- Phones ---------- */

  @media (max-width: 639.98px) {
    .stage {
      min-height: 0;
      padding: 28px 16px;
    }
    .win__toast {
      right: 10px;
      bottom: 10px;
    }
    .popup {
      width: 200px;
    }
  }
</style>
