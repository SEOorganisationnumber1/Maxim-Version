---
// The call request (or, once a scheduling page is set, the written brief): one form, used on
// /contact and inside the Book a call dialog. Only one copy is ever on a page: the dialog is not
// rendered on /contact. It posts to /api/brief, which feeds the /admin inbox and the email alert.
import Icon from './Icon.astro';
import { services, site } from '../data/site';
import { proofLink } from '../data/projects';
import { CALL_TIMES } from '../lib/briefs';
import { bookingUrl } from '../lib/integrations';

const sendErrorText = `Something went wrong sending your request. Please try again${
  site.email ? `, or email us at ${site.email}` : ' in a moment'
}.`;
---

<div class="call-form" data-call-form-root>
  <div class="success" role="status" data-contact-success hidden>
    <span class="success__icon" aria-hidden="true">
      <Icon name="check" size={28} strokeWidth={2.6} />
    </span>
    <h2 class="success__title" tabindex="-1" data-success-title>Request received.</h2>
    <p class="success__text">
      Thanks, <span data-sent-name></span>. We will reply to <span data-sent-email></span>
      {site.responseTime ? `within ${site.responseTime}` : 'by email'}{bookingUrl ? '.' : ', with a time for the call.'}
    </p>
    <div class="success__actions">
      <a href={proofLink.href} class="btn btn--primary btn--sm">{proofLink.label} meanwhile</a>
      <button type="button" class="btn btn--outline btn--sm" data-contact-reset>Send another request</button>
    </div>
  </div>

  {/* With JavaScript the script validates, sends JSON to /api/brief and shows the success panel
      above. Without it the browser validates the required fields and posts the form itself;
      /api/brief then redirects to /contact/sent. */}
  <form class="form" method="post" action="/api/brief" data-contact-form>
    <div class="form__pair">
      <div class="field">
        <label for="c-name" class="field__label">Name</label>
        <input id="c-name" name="name" type="text" autocomplete="name" required maxlength="200" aria-invalid="false" class="field__control" />
        <p id="c-name-error" class="field__error" role="alert" hidden>Please enter your name.</p>
      </div>
      <div class="field">
        <label for="c-email" class="field__label">Email</label>
        <input id="c-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-invalid="false" class="field__control" />
        <p id="c-email-error" class="field__error" role="alert" hidden>Please enter a valid email address.</p>
      </div>
    </div>

    <fieldset class="needs">
      <legend class="needs__legend">What do you need? <span class="field__hint">(optional)</span></legend>
      <div class="needs__list">
        {
          services.map((service) => (
            <label class="check">
              <input type="checkbox" name="needs" value={service} />
              <Icon name="check" size={16} strokeWidth={2.6} class="check__icon" />
              {service}
            </label>
          ))
        }
      </div>
    </fieldset>

    {
      !bookingUrl && (
        <fieldset class="needs" aria-describedby="c-call-hint">
          <legend class="needs__legend">When suits you?</legend>
          <div class="needs__list">
            {Object.entries(CALL_TIMES).map(([value, label], i) => (
              <label class="check">
                <input type="radio" name="callTime" value={value} checked={i === 0} />
                <Icon name="check" size={16} strokeWidth={2.6} class="check__icon" />
                {label}
              </label>
            ))}
          </div>
          <p id="c-call-hint" class="field__note" data-tz-hint>In your time zone.</p>
          <input type="hidden" name="timezone" value="" data-tz />
        </fieldset>
      )
    }

    <div class="field">
      <label for="c-msg" class="field__label">Anything we should know? <span class="field__hint">(optional)</span></label>
      <textarea
        id="c-msg"
        name="message"
        rows="3"
        maxlength="5000"
        placeholder="A line or two about your idea is plenty."
        class="field__control field__control--area"></textarea>
    </div>

    {/* Honeypot: bots that fill it get a fake success. display:none (not a 1px clip) so browser
        autofill, which skips non-rendered fields, never fills it for a real visitor. */}
    <div class="honeypot" aria-hidden="true">
      <label for="c-hp">Leave this field empty</label>
      <input id="c-hp" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p class="field__error" role="alert" data-send-error data-default={sendErrorText} hidden>{sendErrorText}</p>

    <div class="form__send">
      <button type="submit" class="btn btn--primary btn--lg form__submit" data-contact-submit>
        <span data-submit-label>{bookingUrl ? 'Send brief' : 'Request a call'}</span><Icon name="arrow-right" />
      </button>
      <p class="form__consent">
        {bookingUrl ? 'We use your details only to reply to you.' : 'We use your details only to set up the call and reply to you.'}
        <a href="/privacy">Privacy policy</a>
      </p>
    </div>
  </form>
</div>

<style>
  [hidden] {
    display: none !important;
  }

  .success {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: 8px 0;
  }
  .success__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--cyan);
    color: var(--ink);
    animation: pop-in 420ms var(--ease-pop) both;
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  .success__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 3.2vw, 2.5rem);
    line-height: 1.08;
  }
  .success__title:focus {
    outline: none;
  }
  .success__text {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .success__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 6px;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .form__pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 20px 14px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field__label,
  .needs__legend {
    font-weight: 700;
    font-size: 15px;
  }
  .field__hint {
    font-weight: 500;
    color: var(--ink-2);
  }
  .field__note {
    margin: 0;
    font-size: 14px;
    color: var(--ink-2);
  }
  .field__control {
    width: 100%;
    min-height: 48px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    color: var(--ink);
    font-family: inherit;
    font-size: 16px;
    transition:
      border-color 160ms var(--ease-out),
      box-shadow 160ms var(--ease-out);
  }
  .field__control:hover {
    border-color: #b9c4d3;
  }
  .field__control:focus-visible {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 4px rgb(8 159 179 / 0.18);
  }
  .field__control[aria-invalid='true'] {
    border-color: var(--error);
  }
  .field__control.is-shaking {
    animation: shake 300ms var(--ease-out);
  }
  @keyframes shake {
    10%,
    90% {
      transform: translateX(-2px);
    }
    30%,
    70% {
      transform: translateX(4px);
    }
    50% {
      transform: translateX(-4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .field__control.is-shaking {
      animation: none;
    }
  }
  .field__control--area {
    min-height: 92px;
    padding: 12px 16px;
    line-height: 1.5;
    resize: vertical;
  }
  .field__error {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--error);
  }

  .needs {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .needs__legend {
    padding: 0;
    margin-bottom: 8px;
  }
  .needs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  /* Real checkboxes, drawn as pills: the input stays focusable but invisible. */
  .check {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    user-select: none;
    transition:
      background-color 160ms var(--ease-out),
      border-color 160ms var(--ease-out),
      color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .check:hover {
    border-color: var(--ink);
  }
  .check:active {
    transform: scale(0.97);
  }
  .check input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .check :global(.check__icon) {
    display: none;
  }
  .check:has(input:checked) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }
  .check:has(input:checked) :global(.check__icon) {
    display: block;
  }
  .needs .field__note {
    margin-top: 8px;
  }
  .check:has(input:focus-visible) {
    outline: 3px solid var(--teal);
    outline-offset: 2px;
  }

  .honeypot {
    display: none;
  }

  .form__send {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .form__consent {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .form__consent a {
    font-weight: 700;
    color: var(--ink);
  }
  .form__submit:disabled {
    cursor: progress;
    opacity: 0.75;
  }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  /** The site's own inbox: stored in Netlify Blobs, read in /admin, announced by email. */
  const ENDPOINT = '/api/brief';

  type Field = {
    input: HTMLInputElement;
    error: HTMLElement;
    isValid: (value: string) => boolean;
  };
  type Umami = { track: (event: string, data?: Record<string, string>) => void };

  const root = document.querySelector<HTMLElement>('[data-call-form-root]');
  const form = root?.querySelector<HTMLFormElement>('[data-contact-form]');
  const success = root?.querySelector<HTMLElement>('[data-contact-success]');

  if (form && success) initContact(form, success);

  function initContact(form: HTMLFormElement, success: HTMLElement) {
    const $ = <T extends Element>(scope: ParentNode, selector: string): T => {
      const el = scope.querySelector<T>(selector);
      if (!el) throw new Error(`Contact form: missing ${selector}`);
      return el;
    };

    const nameInput = $<HTMLInputElement>(form, '#c-name');
    const emailInput = $<HTMLInputElement>(form, '#c-email');

    // Only there while the form is the call request (no scheduling page set).
    const callTimes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="callTime"]'));
    const zoneInput = form.querySelector<HTMLInputElement>('[data-tz]');
    const zoneHint = form.querySelector<HTMLElement>('[data-tz-hint]');
    const messageInput = $<HTMLTextAreaElement>(form, '#c-msg');
    const honeypot = $<HTMLInputElement>(form, '#c-hp');
    const sendError = $<HTMLElement>(form, '[data-send-error]');
    const submitButton = $<HTMLButtonElement>(form, '[data-contact-submit]');
    const submitLabel = $<HTMLElement>(form, '[data-submit-label]');
    const needs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="needs"]'));

    const successTitle = $<HTMLElement>(success, '[data-success-title]');
    const sentName = $<HTMLElement>(success, '[data-sent-name]');
    const sentEmail = $<HTMLElement>(success, '[data-sent-email]');
    const resetButton = $<HTMLButtonElement>(success, '[data-contact-reset]');

    const idleLabel = submitLabel.textContent ?? 'Send';
    const defaultError = sendError.dataset.default ?? sendError.textContent ?? '';

    // The visitor's time zone, so "Afternoons" means their afternoon. Also sent by a plain form post.
    let timezone = '';
    try {
      timezone = Intl.DateTimeFormat().resolvedOptions().timeZone ?? '';
    } catch {
      timezone = '';
    }
    if (zoneInput) zoneInput.value = timezone;
    if (zoneHint && timezone) zoneHint.textContent = `In your time zone (${timezone.replace(/_/g, ' ')}).`;

    // The script validates with its own messages; without it the browser checks the required fields.
    form.noValidate = true;

    const fields: Field[] = [
      { input: nameInput, error: $<HTMLElement>(form, '#c-name-error'), isValid: (value) => value.trim().length > 0 },
      { input: emailInput, error: $<HTMLElement>(form, '#c-email-error'), isValid: (value) => EMAIL_RE.test(value.trim()) },
    ];

    let sending = false;

    function setInvalid(field: Field, invalid: boolean) {
      if (invalid && field.input.getAttribute('aria-invalid') !== 'true') {
        // A short shake beside the message, so the eye finds the field; never with reduced motion.
        field.input.classList.remove('is-shaking');
        void field.input.offsetWidth;
        field.input.classList.add('is-shaking');
      }
      field.input.setAttribute('aria-invalid', String(invalid));
      if (invalid) field.input.setAttribute('aria-describedby', field.error.id);
      else field.input.removeAttribute('aria-describedby');
      field.error.hidden = !invalid;
    }

    function setSending(on: boolean) {
      sending = on;
      submitButton.disabled = on;
      submitLabel.textContent = on ? 'Sending…' : idleLabel;
    }

    function showError(message: string) {
      sendError.textContent = message;
      sendError.hidden = false;
    }

    function showSuccess(name: string, email: string) {
      sentName.textContent = name;
      sentEmail.textContent = email;
      form.hidden = true;
      success.hidden = false;
      successTitle.focus();
    }

    // Once a field has been flagged, clear its error as soon as the value is fixed.
    for (const field of fields) {
      field.input.addEventListener('input', () => {
        if (field.input.getAttribute('aria-invalid') === 'true' && field.isValid(field.input.value)) setInvalid(field, false);
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;

      sendError.hidden = true;

      const invalid = fields.filter((field) => !field.isValid(field.input.value));
      for (const field of fields) setInvalid(field, invalid.includes(field));
      if (invalid.length > 0) {
        invalid[0]!.input.focus();
        return;
      }

      const payload = {
        name: nameInput.value.trim(),
        email: emailInput.value.trim(),
        needs: needs.filter((box) => box.checked).map((box) => box.value),
        ...(callTimes.length ? { callTime: callTimes.find((r) => r.checked)?.value ?? 'any', timezone } : {}),
        message: messageInput.value.trim(),
      };

      // Bots fill the honeypot: pretend it worked and send nothing.
      if (honeypot.value.trim() !== '') {
        showSuccess(payload.name, payload.email);
        return;
      }

      setSending(true);
      try {
        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) {
          // 413, 422 and 429 carry a message written for the visitor; anything else gets the generic one.
          const body = (await response.json().catch(() => null)) as { error?: unknown } | null;
          const message = response.status < 500 && typeof body?.error === 'string' ? body.error : defaultError;
          throw Object.assign(new Error(`Contact endpoint answered ${response.status}`), { visitorMessage: message });
        }
        setSending(false);
        showSuccess(payload.name, payload.email);
        (window as Window & { umami?: Umami }).umami?.track('Request sent', { needs: payload.needs.join(', ') || 'none' });
      } catch (error) {
        console.error('[contact] Sending the request failed.', error);
        setSending(false);
        showError((error as { visitorMessage?: string }).visitorMessage ?? defaultError);
        // Disabling the button can drop focus; put it back so keyboard users can retry.
        if (!document.activeElement || document.activeElement === document.body) submitButton.focus();
      }
    });

    resetButton.addEventListener('click', () => {
      form.reset();
      if (zoneInput) zoneInput.value = timezone;
      for (const field of fields) setInvalid(field, false);
      sendError.hidden = true;
      setSending(false);
      success.hidden = true;
      form.hidden = false;
      nameInput.focus();
    });
  }
</script>
