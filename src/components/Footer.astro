---
import Logo from './Logo.astro';
import { footerNav, services, site } from '../data/site';

// Each build stamps the current year; the site rebuilds on every deploy.
const year = new Date().getFullYear();
const hasContact = Boolean(site.email || site.socials.length || site.location);
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__cols">
      <div class="footer__brand">
        <Logo id="logo-f" class="footer__logo" />
        <p>{site.tagline}</p>
      </div>
      <nav aria-label="Footer" class="footer__nav">
        <span class="footer__head">Pages</span>
        {footerNav.map((item) => <><a href={item.href}>{item.label}</a>{'\n'}</>)}
      </nav>
      <div class="footer__list">
        <span class="footer__head">We do</span>
        {services.map((s) => <><span>{s}</span>{'\n'}</>)}
      </div>
      <div class="footer__list">
        <span class="footer__head">Get in touch</span>
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
        {site.socials.map((s) => <><a href={s.url} rel="me noopener" target="_blank">{s.label}</a>{'\n'}</>)}
        {site.location && <span>{site.location}</span>}
        {!hasContact && <a href="/contact" data-book-call data-umami-event="Book a call" data-umami-event-from="footer">Book a call</a>}
      </div>
    </div>
    <div class="footer__bottom">
      <span class="footer__legal">
        <span>© {year} {site.name}</span>
        <a href="/privacy">Privacy policy</a>
      </span>
      <span>{services.join(' · ')}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--white);
  }
  .footer__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 64px var(--gutter) 32px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 40px;
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .footer__brand :global(.footer__logo),
  .footer__brand :global(.footer__logo:hover) {
    color: var(--white);
  }
  .footer__brand p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--footer-text);
  }
  .footer__head {
    padding-bottom: 8px;
    font-weight: 700;
    font-size: 15px;
    color: var(--white);
  }
  .footer__nav {
    display: flex;
    flex-direction: column;
  }
  .footer__nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }
  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer__list > span:not(.footer__head),
  .footer__list > a {
    font-size: 15px;
    color: var(--footer-text);
  }
  .footer__list > a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .footer__list > a:hover {
    color: var(--white);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--footer-line);
    padding-top: 24px;
    font-size: 14px;
    color: var(--footer-text);
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
  }
  .footer__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
