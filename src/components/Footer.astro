---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { footerNav, services, site } from '../data/site';
import { projects } from '../data/projects';

interface Props {
  /** href of the current page's nav item, e.g. '/work'; picks the "Next" tile. */
  current?: string;
}

const { current } = Astro.props;

// Each build stamps the current year; the site rebuilds on every deploy.
const year = new Date().getFullYear();

/** The anchor of each service block on /services, as that page builds it. */
const serviceAnchor = (name: string) =>
  name
    .toLowerCase()
    .replace(/&/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

/** Where to go from here: Home leads to Work, Work to Services, Services to Company, the rest to Work. */
type Next = { href: string; label: string; text: string; look: 'shot' | 'bento' | 'ribbon' };
const work: Next = { href: '/work', label: 'Work', text: 'Real projects, with screenshots.', look: 'shot' };
const nextFor: Record<string, Next> = {
  '/work': { href: '/services', label: 'Services', text: 'What we build, and how each project runs.', look: 'bento' },
  '/services': { href: '/company', label: 'Company', text: 'How we work, in plain words.', look: 'ribbon' },
};
const next = (current && nextFor[current]) || work;
const workShot = projects.find((project) => !project.own && project.image)?.image ?? null;
---

{/* The last small bento: the name, where to go next, the pages, the call and what we build. */}
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <div class="tile brand">
        <Logo id="logo-f" />
        <p class="brand__line">{site.tagline}</p>
        <svg class="brand__art" aria-hidden="true" focusable="false" viewBox="0 0 320 240" preserveAspectRatio="xMaxYMax slice" fill="none">
          <defs>
            <linearGradient id="footer-ribbon" x1="0" y1="240" x2="320" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#22D3DD"></stop>
              <stop offset="0.55" stop-color="#2F8CF6"></stop>
              <stop offset="1" stop-color="#5B4FE9"></stop>
            </linearGradient>
          </defs>
          <path d="M20 250 C 60 120, 170 220, 210 120 S 290 10, 340 30" stroke="url(#footer-ribbon)" stroke-width="54" stroke-linecap="round"></path>
        </svg>
      </div>

      <a href={next.href} class="tile next">
        <span>
          <span class="next__title">Next: {next.label}<Icon name="arrow-right" size={22} /></span>
          <span class="next__text">{next.text}</span>
        </span>
        <span class="next__look" aria-hidden="true">
          {
            next.look === 'shot' && workShot && (
              <Image src={workShot.src} alt="" widths={[240, 480]} sizes="200px" loading="lazy" class="next__img" />
            )
          }
          {
            next.look === 'bento' && (
              <span class="next__bento">
                <i />
                <i />
                <i />
              </span>
            )
          }
          {
            next.look === 'ribbon' && (
              <svg viewBox="0 0 200 125" fill="none" preserveAspectRatio="xMidYMid slice">
                <path d="M-10 100 C 40 10, 100 130, 150 46 S 200 14, 214 24" stroke="url(#footer-ribbon)" stroke-width="22" stroke-linecap="round" />
              </svg>
            )
          }
        </span>
      </a>

      <div class="tile touch">
        <p class="tile__title">Get in touch</p>
        {site.responseTime && <p class="touch__text">We reply within {site.responseTime}.</p>}
        <a href="/contact" class="touch__book" data-book-call data-umami-event="Book a call" data-umami-event-from="footer">
          Book a call<Icon name="arrow-right" />
        </a>
        {site.email && <a href={`mailto:${site.email}`} class="touch__plain">{site.email}</a>}
        {
          site.socials.map((social) => (
            <a href={social.url} rel="me noopener" target="_blank" class="touch__plain">
              {social.label}
            </a>
          ))
        }
      </div>

      {/* On wide screens these are two tiles; on phones they share one. */}
      <div class="links">
      <nav class="tile pages" aria-label="Footer">
        <p class="tile__title">Pages</p>
        <ul>
          {
            footerNav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="tile build">
        <p class="tile__title">What we build</p>
        <ul>
          {
            services.map((service) => (
              <li>
                <a href={`/services#${serviceAnchor(service)}`}>{service}</a>
              </li>
            ))
          }
        </ul>
      </div>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© {year} {site.name}</span>
      <a href="/privacy">Privacy policy</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 8px 0;
    background: var(--paper);
    color: var(--ink);
  }
  .footer__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'brand next next'
      'brand pages touch'
      'brand build build';
    gap: 14px;
  }
  .tile {
    min-width: 0;
    padding: 26px;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-tile);
  }
  .tile__title {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }

  /* The name, the line, and the ribbon running out of the corner. */
  .brand {
    grid-area: brand;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-height: 340px;
    background: var(--tint-cyan);
    border-color: transparent;
  }
  .brand__line {
    margin: 0;
    max-width: 11em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .brand__art {
    position: absolute;
    left: -20px;
    bottom: -40px;
    z-index: -1;
    width: calc(100% + 60px);
    height: 62%;
    /* The tile's rounded edge cuts the ribbon, not the drawing's own box. */
    overflow: visible;
  }

  /* Where to go from here, with a look at it. */
  .next {
    grid-area: next;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px;
    align-items: center;
    gap: 18px;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 200ms var(--ease-out);
  }
  .next__title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .next__title :global(svg) {
    transition: transform 260ms var(--ease-out);
  }
  .next__text {
    display: block;
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .next__look {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--line-soft);
    background: var(--paper);
    box-shadow: 0 10px 24px -18px rgb(10 17 40 / 0.5);
    transition:
      transform 320ms var(--ease-out),
      box-shadow 320ms var(--ease-out);
  }
  .next__look :global(.next__img),
  .next__look svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  /* Services: the bento in miniature. */
  .next__bento {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 6px;
    height: 100%;
    padding: 10px;
  }
  .next__bento i {
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--line-soft);
  }
  .next__bento i:first-child {
    grid-row: span 2;
    background: var(--tint-cyan);
  }
  @media (hover: hover) and (pointer: fine) {
    .next:hover {
      border-color: var(--line);
    }
    .next:hover .next__look {
      transform: translateY(-4px) rotate(-1.5deg);
      box-shadow: 0 22px 36px -22px rgb(10 17 40 / 0.55);
    }
    .next:hover .next__title :global(svg) {
      transform: translateX(4px);
    }
  }

  .touch {
    grid-area: touch;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .touch__text {
    margin: -6px 0 16px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .touch__book {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-weight: 700;
    font-size: 16px;
    white-space: nowrap;
    text-decoration: none;
    transition:
      transform 160ms var(--ease-out),
      background-color 160ms var(--ease-out);
  }
  .touch__book:hover {
    color: var(--white);
    background: #1b2547;
  }
  .touch__book:active {
    transform: scale(0.97);
  }
  .touch__plain {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    margin-top: 6px;
    font-weight: 600;
    font-size: 15px;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .links {
    display: contents;
  }
  .pages {
    grid-area: pages;
  }
  .pages ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 12px;
  }
  .pages a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-weight: 600;
    font-size: 15px;
    color: var(--ink-2);
    text-decoration: none;
  }
  .pages a:hover {
    color: var(--teal-ink);
  }

  /* Every service goes to its own block on Services. */
  .build {
    grid-area: build;
  }
  .build ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .build a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper);
    font-weight: 600;
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 160ms var(--ease-out),
      background-color 160ms var(--ease-out);
  }
  .build a:hover {
    border-color: var(--ink);
    background: var(--surface);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 24px;
    padding: 10px 6px 12px;
    font-size: 14px;
    color: var(--muted);
  }
  .footer__bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-2);
  }

  @media (max-width: 999.98px) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'brand brand'
        'next next'
        'pages touch'
        'build build';
    }
    .brand {
      min-height: 240px;
    }
    .brand__art {
      left: auto;
      right: -40px;
      width: 70%;
      height: 90%;
    }
  }
  /* Phones: the ending above already asks for the call, so the footer does not ask again. The
     pages and what we build share one tile. */
  @media (max-width: 599.98px) {
    .footer {
      padding-top: 48px;
    }
    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'brand' 'next' 'links';
      gap: 12px;
    }
    .touch {
      display: none;
    }
    .links {
      grid-area: links;
      display: grid;
      gap: 22px;
      padding: 20px;
      background: var(--surface);
      border: 1px solid var(--line-soft);
      border-radius: var(--radius-tile);
      box-shadow: var(--shadow-tile);
    }
    .pages a {
      min-height: 44px;
    }
    .links > .tile {
      grid-area: auto;
      padding: 0;
      background: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }
    .tile {
      padding: 20px;
    }
    .brand {
      min-height: 160px;
      gap: 14px;
    }
    .brand__line {
      font-size: 22px;
    }
    .next {
      grid-template-columns: minmax(0, 1fr) 76px;
      gap: 14px;
    }
    .next__title {
      gap: 8px;
      font-size: 22px;
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .next__look,
    .next__title :global(svg) {
      transition: none;
    }
  }
</style>
