---
// Home's "What we build": one tile per kind of project, each a small working piece of that kind
// of thing, already alive at rest (a real café homepage, a conversation, a run half done).
// The tile with live numbers measures this very page in the visitor's browser. Demo content is
// invented and labelled as a demo (Lumen Coffee is not a client).
//
// Each tile's title comes first in the HTML, so screen readers hear what a demo is before its
// controls; CSS shows the title under the demo.
import Icon from './Icon.astro';

const home = new URL('/', Astro.site).href;
const pagespeed = `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(home)}`;

/** Where each tile's title leads: the offer page when there is one, else its block on Services. */
const more = {
  web: '/services#websites-landing-pages',
  bot: '/services/telegram-bots',
  app: '/services#web-apps-saas',
  phone: '/services#mobile-desktop-apps',
  ai: '/services#ai-automation',
  seo: '/services#search-growth',
};

const replies = [
  { say: 'Add a croissant', reply: 'Added. One warm croissant, ready with your coffee.' },
  { say: 'Are you open now?', reply: 'Yes, until 6 pm today. Want to order ahead?' },
  { say: 'Talk to a person', reply: 'Sure. A barista from Lumen will answer right here.' },
];

const steps = [
  'New Google review: 4 stars',
  'AI drafts a friendly reply',
  'You approve it with one tap',
  'Reply posted on Google',
];
/** Two of four steps are done at rest, so the tile reads as a run already under way. */
const DONE_AT_REST = 2;
---

<div class="bench" data-bench>
  <!-- Websites: one layout that works at every width -->
  <article class="tile tile--web" aria-labelledby="tile-web">
    <div class="tile__meta">
      <h3 class="tile__title" id="tile-web"><a href={more.web}>Websites & Landing <span class="tile__end">Pages<Icon name="arrow-right" size={16} strokeWidth={2.6} class="tile__go" /></span></a></h3>
      <p class="tile__text">Fast sites that work on every screen.</p>
    </div>
    <div class="tile__stage tile__stage--web">
      <div class="web__frame" data-web-frame>
        <div class="web__bar" aria-hidden="true"><i></i><i></i><i></i><span>lumencoffee.com</span></div>
        <div class="mini" data-size="desktop" aria-hidden="true">
          <div class="mini__nav">
            <b>Lumen</b>
            <span class="mini__links"><i>Menu</i><i>Order</i><i>Visit</i></span>
            <span class="mini__burger"><i></i><i></i></span>
          </div>
          <div class="mini__hero">
            <div class="mini__copy">
              <span class="mini__h">Fresh coffee, ready when you are.</span>
              <span class="mini__btn">Order ahead</span>
            </div>
            <svg class="mini__cup" viewBox="0 0 120 96" fill="none">
              <path d="M44 10c-4 6 4 9 0 15M60 8c-4 6 4 9 0 15M76 10c-4 6 4 9 0 15" stroke="#089FB3" stroke-width="3.5" stroke-linecap="round"></path>
              <path d="M26 36h64v18a28 28 0 0 1-28 28h-8a28 28 0 0 1-28-28V36z" fill="#0A1128"></path>
              <path d="M90 42h6a10 10 0 0 1 0 20h-7" stroke="#0A1128" stroke-width="6" stroke-linecap="round"></path>
              <path d="M14 86h92" stroke="#0A1128" stroke-width="5" stroke-linecap="round"></path>
            </svg>
          </div>
          <div class="mini__cards">
            <span><i class="mini__dot mini__dot--a"></i>Flat white</span>
            <span><i class="mini__dot mini__dot--b"></i>Croissant</span>
            <span><i class="mini__dot mini__dot--c"></i>Cold brew</span>
          </div>
        </div>
      </div>
      <div class="web__control">
        <label for="web-width" class="web__label">Screen width<span class="visually-hidden"> of the demo site</span> <output for="web-width" data-web-out>Desktop, 1280 px</output></label>
        <input id="web-width" type="range" min="320" max="1280" step="1" value="1280" data-web-range />
      </div>
    </div>
  </article>

  <!-- Telegram: a bot with yesterday's question and today's order -->
  <article class="tile tile--bot" aria-labelledby="tile-bot">
    <div class="tile__meta">
      <h3 class="tile__title" id="tile-bot"><a href={more.bot}>Telegram Bots & <span class="tile__end">Extensions<Icon name="arrow-right" size={16} strokeWidth={2.6} class="tile__go" /></span></a></h3>
      <p class="tile__text">Bots that take orders and answer customers.</p>
    </div>
    <div class="tile__stage tile__stage--bot">
      <div class="chat" data-chat>
        <div class="chat__head">
          <span class="chat__avatar" aria-hidden="true">L</span>
          <span><b>Lumen Coffee</b><small>bot · demo</small></span>
        </div>
        <div class="chat__log" data-chat-log aria-live="off">
          <p class="chat__day" aria-hidden="true">Yesterday</p>
          <p class="msg msg--bot">Hi! I take orders for Lumen Coffee. What would you like?</p>
          <p class="msg msg--me">Do you have oat milk?</p>
          <p class="msg msg--bot">Yes, oat and almond, at no extra cost.</p>
          <p class="chat__day" aria-hidden="true">Today</p>
          <div class="msg msg--bot msg--menu">
            <b>Today at Lumen</b>
            <span><i class="mini__dot mini__dot--a"></i>Flat white</span>
            <span><i class="mini__dot mini__dot--b"></i>Croissant</span>
            <span><i class="mini__dot mini__dot--c"></i>Cold brew</span>
          </div>
          <p class="msg msg--me">Two flat whites with oat milk, please</p>
          <p class="msg msg--bot">Ready in 10 minutes. Pay now or at pick-up?</p>
          <p class="msg msg--me" data-replay data-exchange="0">Pay now</p>
          <p class="msg msg--bot" data-replay data-exchange="0">Paid. Your order is ready at 8:40, we'll message you here.</p>
        </div>
        <div class="chat__chips" data-chat-chips role="group" aria-label="Demo replies">
          {
            replies.map((r) => (
              <button type="button" class="chat__chip" data-say={r.say} data-reply={r.reply}>
                {r.say}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </article>

  <!-- Web apps: an unsaved change, ready to save -->
  <article class="tile tile--app" aria-labelledby="tile-app">
    <div class="tile__meta">
      <h3 class="tile__title" id="tile-app"><a href={more.app}>Web Apps & <span class="tile__end">SaaS<Icon name="arrow-right" size={16} strokeWidth={2.6} class="tile__go" /></span></a></h3>
      <p class="tile__text">Order systems, bookings and dashboards.</p>
    </div>
    <div class="tile__stage">
      <div class="settings">
        <p class="settings__title">Lumen dashboard · demo</p>
        <p class="settings__stat"><b>12</b> orders today</p>
        <label class="switch">
          <input type="checkbox" role="switch" data-app-toggle checked />
          <span class="switch__track" aria-hidden="true"></span>
          <span>Take orders online<span class="visually-hidden"> (demo)</span></span>
        </label>
        <button type="button" class="save" data-app-save data-state="changed" aria-describedby="app-save-note">
          <span class="save__label" data-app-label>Save changes</span><span class="visually-hidden"> (demo)</span>
        </button>
        <p id="app-save-note" class="settings__note" data-app-note>You have one unsaved change.</p>
      </div>
    </div>
  </article>

  <!-- Mobile: a real screen that follows its dark mode switch -->
  <article class="tile tile--phone" aria-labelledby="tile-phone">
    <div class="tile__meta">
      <h3 class="tile__title" id="tile-phone"><a href={more.phone}>Mobile & Desktop <span class="tile__end">Apps<Icon name="arrow-right" size={16} strokeWidth={2.6} class="tile__go" /></span></a></h3>
      <p class="tile__text">Apps for iPhone, Android, Mac and Windows.</p>
    </div>
    <div class="tile__stage">
      <div class="phone" data-phone data-theme="light">
        <div class="phone__screen" aria-hidden="true">
          <span class="phone__notch"></span>
          <span class="phone__hi">Good morning</span>
          <span class="phone__card"><small>Your order</small><b>Ready at 8:40</b></span>
          <span class="phone__row"><i></i>2 × Flat white</span>
          <span class="phone__row"><i></i>Pick up at the counter</span>
        </div>
      </div>
      <label class="switch switch--center">
        <input type="checkbox" role="switch" data-phone-toggle />
        <span class="switch__track" aria-hidden="true"></span>
        <span>Dark mode<span class="visually-hidden"> on the demo phone</span></span>
      </label>
    </div>
  </article>

  <!-- AI: an automation, half way through a run, read left to right -->
  <article class="tile tile--ai" aria-labelledby="tile-ai">
    <div class="tile__meta">
      <h3 class="tile__title" id="tile-ai"><a href={more.ai}>AI & <span class="tile__end">Automation<Icon name="arrow-right" size={16} strokeWidth={2.6} class="tile__go" /></span></a></h3>
      <p class="tile__text">Routine replies drafted for you to approve.</p>
    </div>
    <div class="tile__stage tile__stage--ai">
      <ol class="flow" data-flow>
        {
          steps.map((step, i) => (
            <li class="flow__step" data-state={i < DONE_AT_REST ? 'done' : 'waiting'}>
              <span class="flow__dot" aria-hidden="true">
                <Icon name="check" size={14} strokeWidth={3} />
              </span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
      <button type="button" class="run" data-flow-run><span data-flow-label>Run it</span><span class="visually-hidden"> (demo)</span></button>
      <p class="visually-hidden" aria-live="polite" data-flow-status></p>
    </div>
  </article>

  <!-- Search: a café on top of the results, and this page measured now -->
  <article class="tile tile--seo" aria-labelledby="tile-seo">
    <div class="tile__meta">
      <h3 class="tile__title" id="tile-seo"><a href={more.seo}>Search & <span class="tile__end">Growth<Icon name="arrow-right" size={16} strokeWidth={2.6} class="tile__go" /></span></a></h3>
      <p class="tile__text">Get found on Google and in ChatGPT.</p>
    </div>
    <div class="tile__stage tile__stage--seo">
      <div class="serp" role="img" aria-label="Demo search result: Lumen Coffee first for coffee near me">
        <p class="serp__query" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
          coffee near me
        </p>
        <div class="serp__hit" aria-hidden="true">
          <b>Lumen Coffee</b>
          <span class="serp__stars">★★★★★ <i>4.8</i></span>
          <span>Open until 6 pm · Order ahead</span>
        </div>
        <div class="serp__miss" aria-hidden="true"><i></i><i></i></div>
      </div>
      <p class="seo__live" data-live hidden>
        <span class="seo__dot" aria-hidden="true"></span>
        <span>
          This page loaded in <b data-stat="load"></b> on your device.
          <a href={pagespeed} target="_blank" rel="noopener" data-umami-event="Site check" data-umami-event-check="PageSpeed">
            Check our speed on Google<span class="visually-hidden"> (opens in a new tab)</span>
            <Icon name="arrow-up-right" size={14} />
          </a>
        </span>
      </p>
    </div>
  </article>
</div>
{/* Phones swipe through the tiles; these marks show where you are. */}
<div class="bench__marks" aria-hidden="true" data-bench-marks>{Array.from({ length: 6 }, (_, i) => <i class:list={{ on: i === 0 }} />)}</div>

<style>
  /* ---------- Grid: one wide tile, one tall tile, the rest standard ---------- */

  .bench {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      'web web bot'
      'app phone bot'
      'ai ai seo';
    gap: 14px;
  }
  .tile--web { grid-area: web; }
  .tile--bot { grid-area: bot; }
  .tile--app { grid-area: app; }
  .tile--phone { grid-area: phone; }
  .tile--ai { grid-area: ai; }
  .tile--seo { grid-area: seo; }
  @media (max-width: 1023.98px) {
    .bench {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'web web'
        'bot app'
        'bot phone'
        'ai ai'
        'seo seo';
    }
  }
  .tile {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-tile);
    overflow: hidden;
  }
  .tile__stage {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    gap: 16px;
    min-height: 220px;
    padding: 24px;
    background: var(--paper);
    border-bottom: 1px solid var(--line-soft);
  }
  /* The title is first in the HTML for screen readers; on screen it sits under the demo. */
  .tile__meta {
    order: 2;
  }
  .tile {
    transition: border-color 240ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover {
      border-color: var(--line);
    }
  }
  .tile__meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 24px 22px;
  }
  .tile__title a {
    color: inherit;
    text-decoration: none;
  }
  /* Always visible, so touch screens can tell the title is a link too. */
  .tile__title :global(.tile__go) {
    display: inline-block;
    margin-left: 6px;
    vertical-align: -1px;
    color: var(--muted);
    transition:
      transform 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }
  .tile__title a:hover,
  .tile__title a:focus-visible {
    color: var(--teal-ink);
  }
  /* The arrow stays with the last word, so it never drops onto a line of its own. */
  .tile__end {
    white-space: nowrap;
  }
  .tile__title a:hover :global(.tile__go),
  .tile__title a:focus-visible :global(.tile__go) {
    color: var(--teal-ink);
    transform: translateX(3px);
  }
  .tile__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.2;
  }
  .tile__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* ---------- Websites ---------- */

  .tile__stage--web {
    align-content: center;
    min-height: 300px;
  }
  .web__frame {
    width: 100%;
    max-width: 640px;
    justify-self: center;
    background: var(--white);
    border: 1px solid rgb(10 17 40 / 0.12);
    border-radius: 14px;
    box-shadow: 0 18px 40px -26px rgb(10 17 40 / 0.4);
    overflow: hidden;
    transition: width 120ms linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .web__frame {
      transition: none;
    }
  }
  .web__bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--line-soft);
    font-size: 11px;
    color: var(--muted);
  }
  .web__bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }
  .web__bar span {
    margin-left: 6px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--paper);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The mini site is a real café homepage that takes the layout of the width the slider simulates. */
  .mini {
    padding: 12px 14px 16px;
    display: grid;
    gap: 12px;
    font-size: 11px;
    color: var(--ink);
  }
  .mini__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mini__nav b {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .mini__links {
    display: flex;
    gap: 12px;
  }
  .mini__links i {
    font-style: normal;
    font-weight: 600;
    color: var(--ink-2);
  }
  .mini__burger {
    display: none;
    flex-direction: column;
    gap: 3px;
  }
  .mini__burger i {
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
  }
  .mini__hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border-radius: 12px;
    background: var(--tint-cyan);
  }
  .mini__copy {
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .mini__h {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .mini__btn {
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-weight: 700;
    font-size: 10px;
  }
  .mini__cup {
    width: 100%;
    max-width: 120px;
    justify-self: center;
  }
  /* The menu cards wrap when the frame itself is narrow, so nothing is ever cut off. */
  .mini__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(92px, 1fr));
    gap: 8px;
  }
  .mini__cards span {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
    border-radius: 9px;
    background: var(--paper);
    border: 1px solid var(--line-soft);
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
  }
  .mini__dot {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }
  .mini__dot--a { background: var(--teal); }
  .mini__dot--b { background: var(--g-blue); }
  .mini__dot--c { background: var(--g-violet); }
  .mini[data-size='phone'] .mini__links {
    display: none;
  }
  .mini[data-size='phone'] .mini__burger {
    display: flex;
  }
  .mini[data-size='phone'] .mini__hero {
    grid-template-columns: 1fr;
  }
  .mini[data-size='phone'] .mini__cup {
    display: none;
  }
  .mini[data-size='phone'] .mini__h {
    font-size: 16px;
  }
  .mini[data-size='phone'] .mini__cards {
    grid-template-columns: 1fr;
  }
  .mini[data-size='tablet'] .mini__cards {
    grid-template-columns: repeat(2, 1fr);
  }
  .mini[data-size='tablet'] .mini__cards span:last-child {
    display: none;
  }
  .web__control {
    width: 100%;
    max-width: 640px;
    justify-self: center;
    display: grid;
    gap: 8px;
  }
  .web__label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    font-weight: 700;
  }
  .web__label output {
    font-weight: 600;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  input[type='range'] {
    width: 100%;
    height: 28px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 999px;
    background: var(--line);
  }
  input[type='range']::-moz-range-track {
    height: 6px;
    border-radius: 999px;
    background: var(--line);
  }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -8px;
    border-radius: 50%;
    background: var(--ink);
    border: 3px solid var(--white);
    box-shadow: 0 1px 4px rgb(10 17 40 / 0.35);
    transition: transform 160ms var(--ease-pop);
  }
  input[type='range']::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--ink);
    border: 3px solid var(--white);
    box-shadow: 0 1px 4px rgb(10 17 40 / 0.35);
  }
  input[type='range']:active::-webkit-slider-thumb {
    transform: scale(1.15);
  }
  input[type='range']:focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 2px;
    border-radius: 999px;
  }

  /* ---------- Telegram chat ---------- */

  .tile__stage--bot {
    align-content: stretch;
    place-items: stretch;
  }
  .chat {
    display: flex;
    flex-direction: column;
    min-height: 470px;
    background: #e7eef4;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line-soft);
  }
  .chat__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--white);
    border-bottom: 1px solid var(--line-soft);
    font-size: 14px;
  }
  .chat__head b {
    display: block;
    line-height: 1.2;
  }
  .chat__head small {
    color: var(--muted);
    font-size: 12px;
  }
  .chat__avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--teal-ink);
    color: var(--white);
    font-weight: 800;
  }
  /* The history never sets the tile's height: it fills the space there is, newest at the bottom,
     and older messages slide out of view at the top, as in a real chat. */
  .chat__log {
    flex: 1 1 0;
    min-height: 0;
    contain: size;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 14px 12px;
    overflow: hidden;
    /* Older messages fade out under the header instead of being cut in half. */
    mask-image: linear-gradient(to bottom, transparent, #000 32px);
  }
  .chat__log :global(.msg) {
    margin: 0;
    max-width: 84%;
    padding: 8px 12px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.4;
    animation: msg-in 260ms var(--ease-out) both;
  }
  .chat__log :global(.msg--bot) {
    align-self: flex-start;
    background: var(--white);
    border-bottom-left-radius: 6px;
    transform-origin: bottom left;
  }
  .chat__day {
    align-self: center;
    margin: 0 0 4px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(10 17 40 / 0.06);
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-2);
  }
  .chat__day:not(:first-child) {
    margin-top: 8px;
  }
  .chat__log :global(.msg--menu) {
    display: grid;
    gap: 6px;
    min-width: 62%;
  }
  .msg--menu b {
    font-size: 13px;
  }
  .msg--menu span {
    display: flex;
