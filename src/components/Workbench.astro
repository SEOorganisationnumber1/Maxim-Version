</style>

<script>
  const bench = document.querySelector<HTMLElement>('[data-bench]');
  if (bench) initBench(bench);

  function initBench(root: HTMLElement) {
    const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, reduce() ? Math.min(ms, 120) : ms));
    /** Busy controls keep focus (aria-disabled), so keyboard users are never thrown back to the top. */
    const setBusy = (el: HTMLElement, busy: boolean) => el.setAttribute('aria-disabled', String(busy));
    const isBusy = (el: HTMLElement) => el.getAttribute('aria-disabled') === 'true';
    /** Runs once, the first time an element is mostly on screen. */
    const onFirstView = (el: Element, run: () => void) => {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            run();
          }
        },
        { threshold: 0.5 },
      );
      io.observe(el);
    };

    // ---------- Websites: the slider sets the frame width and the mini site takes that layout.
    const range = root.querySelector<HTMLInputElement>('[data-web-range]');
    const frame = root.querySelector<HTMLElement>('[data-web-frame]');
    const out = root.querySelector<HTMLOutputElement>('[data-web-out]');
    const mini = root.querySelector<HTMLElement>('.mini');
    if (range && frame && out && mini) {
      const min = Number(range.min);
      const max = Number(range.max);
      const update = () => {
        const px = Number(range.value);
        frame.style.width = `${34 + ((px - min) / (max - min)) * 66}%`;
        const device = px < 600 ? 'Phone' : px < 1000 ? 'Tablet' : 'Desktop';
        out.textContent = `${device}, ${px} px`;
        mini.dataset.size = device.toLowerCase();
      };
      range.addEventListener('input', update);
      update();
      // A one-time demonstration drag shows the tile is alive; any touch of the slider stops it.
      let touched = false;
      const stop = () => (touched = true);
      range.addEventListener('pointerdown', stop);
      range.addEventListener('keydown', stop);
      onFirstView(frame, () => {
        if (reduce() || touched) return;
        const path = [1280, 470, 470, 1280];
        const times = [0, 900, 1500, 2400];
        const start = performance.now();
        const ease = (t: number) => 1 - Math.pow(1 - t, 3);
        const tick = (now: number) => {
          if (touched) return;
          const t = now - start;
          let i = 0;
          while (i < times.length - 2 && t > times[i + 1]!) i++;
          const span = times[i + 1]! - times[i]!;
          const k = Math.min(1, Math.max(0, (t - times[i]!) / span));
          range.value = String(Math.round(path[i]! + (path[i + 1]! - path[i]!) * ease(k)));
          update();
          if (t < times[times.length - 1]!) requestAnimationFrame(tick);
        };
        window.setTimeout(() => requestAnimationFrame(tick), 300);
      });
    }

    // ---------- Telegram: the conversation replays once on first view; replies answer after typing.
    const log = root.querySelector<HTMLElement>('[data-chat-log]');
    const chips = root.querySelector<HTMLElement>('[data-chat-chips]');
    if (log && chips) {
      const buttons = [...chips.querySelectorAll<HTMLButtonElement>('button')];
      let chatting = false;
      let exchange = 0;
      /** Keeps the two latest exchanges, removed as whole question-and-answer pairs. */
      const prune = () => {
        const ids = [...new Set([...log.querySelectorAll<HTMLElement>('[data-exchange]')].map((el) => el.dataset.exchange))];
        while (ids.length > 2) {
          const oldest = ids.shift();
          log.querySelectorAll(`[data-exchange="${oldest}"]`).forEach((el) => el.remove());
        }
      };
      const bubble = (text: string, who: 'me' | 'bot') => {
        const p = document.createElement('p');
        p.className = `msg msg--${who}`;
        p.dataset.exchange = String(exchange);
        p.textContent = text;
        log.appendChild(p);
        return p;
      };
      const typing = () => {
        const t = bubble('', 'bot');
        t.classList.add('typing');
        t.setAttribute('aria-hidden', 'true');
        t.innerHTML = '<i></i><i></i><i></i>';
        return t;
      };
      const say = async (mine: string, reply: string) => {
        chatting = true;
        exchange += 1;
        buttons.forEach((b) => setBusy(b, true));
        bubble(mine, 'me');
        prune();
        await wait(260);
        const t = typing();
        await wait(900);
        t.remove();
        bubble(reply, 'bot');
        buttons.forEach((b) => setBusy(b, false));
        chatting = false;
      };
      chips.addEventListener('click', (event) => {
        const b = (event.target as Element).closest<HTMLButtonElement>('button');
        if (!b || chatting || isBusy(b)) return;
        // Announce replies only once the visitor is the one talking, never the automatic replay.
        log.setAttribute('aria-live', 'polite');
        void say(b.dataset.say ?? '', b.dataset.reply ?? '');
      });
      onFirstView(log, () => {
        if (reduce() || chatting) return;
        const replay = [...log.querySelectorAll<HTMLElement>('[data-replay]')];
        const [mine, answer] = replay.map((el) => el.textContent ?? '');
        replay.forEach((el) => el.remove());
        exchange = -1;
        void say(mine ?? '', answer ?? '');
      });
    }

    // ---------- Web app: changed, saving, saved. The button keeps focus throughout.
    const toggle = root.querySelector<HTMLInputElement>('[data-app-toggle]');
    const save = root.querySelector<HTMLButtonElement>('[data-app-save]');
    const label = root.querySelector<HTMLElement>('[data-app-label]');
    const note = root.querySelector<HTMLElement>('[data-app-note]');
    if (toggle && save && label && note) {
      let savedValue = !toggle.checked;
      const sync = () => {
        if (save.dataset.state === 'saving') return;
        const changed = toggle.checked !== savedValue;
        save.dataset.state = changed ? 'changed' : 'saved';
        setBusy(save, !changed);
        label.innerHTML = changed ? 'Save changes' : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Saved';
        note.textContent = changed ? 'You have one unsaved change.' : 'All changes saved.';
      };
      toggle.addEventListener('change', sync);
      save.addEventListener('click', async () => {
        if (isBusy(save) || save.dataset.state !== 'changed') return;
        save.dataset.state = 'saving';
        setBusy(save, true);
        label.innerHTML = '<i class="spin" aria-hidden="true"></i>Saving';
        note.textContent = 'Saving…';
        await wait(900);
        savedValue = toggle.checked;
        save.dataset.state = 'idle';
        sync();
      });
    }

    // ---------- Mobile: the screen follows its dark mode switch.
    const phone = root.querySelector<HTMLElement>('[data-phone]');
    const phoneToggle = root.querySelector<HTMLInputElement>('[data-phone-toggle]');
    phoneToggle?.addEventListener('change', () => {
      if (phone) phone.dataset.theme = phoneToggle.checked ? 'dark' : 'light';
    });

    // ---------- AI: four steps run in order; the button keeps focus while it runs.
    const flow = root.querySelector<HTMLElement>('[data-flow]');
    const run = root.querySelector<HTMLButtonElement>('[data-flow-run]');
    const status = root.querySelector<HTMLElement>('[data-flow-status]');
    if (flow && run) {
      const steps = [...flow.querySelectorAll<HTMLElement>('.flow__step')];
      run.addEventListener('click', async () => {
        if (isBusy(run)) return;
        setBusy(run, true);
        steps.forEach((s) => (s.dataset.state = 'waiting'));
        if (status) status.textContent = 'Running.';
        for (const step of steps) {
          step.dataset.state = 'running';
          await wait(650);
          step.dataset.state = 'done';
        }
        if (status) status.textContent = 'All four steps are done.';
        const runLabel = run.querySelector<HTMLElement>('[data-flow-label]');
        if (runLabel) runLabel.textContent = 'Run again';
        setBusy(run, false);
      });
    }

    // ---------- Phones: the marks under the row follow the tile in view.
    const marks = [...document.querySelectorAll<HTMLElement>('[data-bench-marks] i')];
    const tiles = [...root.querySelectorAll<HTMLElement>('.tile')];
    if (marks.length && tiles.length) {
      const seen = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const at = tiles.indexOf(entry.target as HTMLElement);
            marks.forEach((mark, i) => mark.classList.toggle('on', i === at));
          }
        },
        { root, threshold: 0.6 },
      );
      tiles.forEach((tile) => seen.observe(tile));
    }

    // ---------- Search: real numbers for this page load, from the browser's own timing data.
    const set = (key: string, value: string) => {
      const el = root.querySelector<HTMLElement>(`[data-stat="${key}"]`);
      if (el) el.textContent = value;
    };
    const live = root.querySelector<HTMLElement>('[data-live]');
    const measure = () => {
      const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      // Shown only once there is a real number to show.
      if (nav && nav.loadEventStart > 0 && live) {
        set('load', `${(nav.loadEventStart / 1000).toFixed(2)} s`);
        live.hidden = false;
      }
    };
    if (document.readyState === 'complete') window.setTimeout(measure, 0);
    else window.addEventListener('load', () => window.setTimeout(measure, 0), { once: true });
  }
</script>
