---
// Home's "What we build": one tile per kind of project, each a small working piece of that kind
// of thing, already alive at rest (a real café homepage, a conversation, a run half done).
// The tile with live numbers measures this very page in the visitor's browser. Demo content is
// invented and labelled as a demo (Lumen Coffee is not a client).
import Icon from './Icon.astro';

const home = new URL('/', Astro.site).href;
const checks = [
  { label: 'PageSpeed', href: `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(home)}`, external: true },
  { label: 'Schema', href: `https://validator.schema.org/#url=${encodeURIComponent(home)}`, external: true },
  { label: 'llms.txt', href: '/llms.txt', external: false },
];

const replies = [
  { say: 'Two flat whites, please', reply: 'Two flat whites, ready in 10 minutes. Pay now or at pick-up?' },
  { say: 'Are you open now?', reply: 'Yes, until 6 pm today. Want to order ahead?' },
  { say: 'Talk to a person', reply: "Sure, I've passed you to the team. They reply right here." },
];

const steps = [
  'New enquiry from your website',
  'AI sorts it: redesign, this month',
  'Added to your CRM, details filled in',
  'Reply drafted for you to approve',
];
/** Two of four steps are done at rest, so the tile reads as a run in progress. */
const DONE_AT_REST = 2;
---

<div class="bench" data-bench>
  <!-- Websites: one layout that works at every width -->
  <article class="tile tile--web">
    <div class="tile__stage tile__stage--web">
      <div class="web__frame" data-web-frame>
        <div class="web__bar" aria-hidden="true"><i></i><i></i><i></i><span>lumencoffee.com</span></div>
        <div class="mini" data-size="desktop" aria-hidden="true">
          <div class="mini__nav">
            <b>Lumen</b>
            <span class="mini__links"><i>Menu</i><i>Order</i><i>Visit</i></span>
            <span class="mini__burger"><i></i><i></i></span>
          </div>
          <div class="mini__hero">
            <div class="mini__copy">
              <span class="mini__h">Fresh coffee, ready when you are.</span>
              <span class="mini__btn">Order ahead</span>
            </div>
            <svg class="mini__cup" viewBox="0 0 120 96" fill="none">
              <path d="M44 10c-4 6 4 9 0 15M60 8c-4 6 4 9 0 15M76 10c-4 6 4 9 0 15" stroke="#089FB3" stroke-width="3.5" stroke-linecap="round"></path>
              <path d="M26 36h64v18a28 28 0 0 1-28 28h-8a28 28 0 0 1-28-28V36z" fill="#0A1128"></path>
              <path d="M90 42h6a10 10 0 0 1 0 20h-7" stroke="#0A1128" stroke-width="6" stroke-linecap="round"></path>
              <path d="M14 86h92" stroke="#0A1128" stroke-width="5" stroke-linecap="round"></path>
            </svg>
          </div>
          <div class="mini__cards">
            <span><i class="mini__dot mini__dot--a"></i>Flat white</span>
            <span><i class="mini__dot mini__dot--b"></i>Croissant</span>
            <span><i class="mini__dot mini__dot--c"></i>Cold brew</span>
          </div>
        </div>
      </div>
      <div class="web__control">
        <label for="web-width" class="web__label">Screen width <output for="web-width" data-web-out>Desktop, 1280 px</output></label>
        <input id="web-width" type="range" min="320" max="1280" step="1" value="1280" data-web-range />
      </div>
    </div>
    <div class="tile__meta">
      <div class="tile__row"><h3 class="tile__title">Websites & Landing Pages</h3><span class="tile__hint" aria-hidden="true">Drag</span></div>
      <p class="tile__text">Fast sites that work on every screen.</p>
    </div>
  </article>

  <!-- Telegram: a bot mid-conversation -->
  <article class="tile tile--bot">
    <div class="tile__stage tile__stage--bot">
      <div class="chat" data-chat>
        <div class="chat__head">
          <span class="chat__avatar" aria-hidden="true">L</span>
          <span><b>Lumen Coffee</b><small>bot · demo</small></span>
        </div>
        <div class="chat__log" data-chat-log aria-live="polite">
          <p class="chat__day" aria-hidden="true">Today</p>
          <div class="msg msg--bot msg--menu">
            <b>Today at Lumen</b>
            <span><i class="mini__dot mini__dot--a"></i>Flat white</span>
            <span><i class="mini__dot mini__dot--b"></i>Croissant</span>
            <span><i class="mini__dot mini__dot--c"></i>Cold brew</span>
          </div>
          <p class="msg msg--bot">Hi! I take orders for Lumen Coffee. What would you like?</p>
          <p class="msg msg--me" data-replay>Two flat whites, please</p>
          <p class="msg msg--bot" data-replay>Two flat whites, ready in 10 minutes. Pay now or at pick-up?</p>
        </div>
        <div class="chat__chips" data-chat-chips>
          {
            replies.map((r) => (
              <button type="button" class="chat__chip" data-say={r.say} data-reply={r.reply}>
                {r.say}
              </button>
            ))
          }
        </div>
      </div>
    </div>
    <div class="tile__meta">
      <div class="tile__row"><h3 class="tile__title">Telegram Bots & Extensions</h3><span class="tile__hint" aria-hidden="true">Tap</span></div>
      <p class="tile__text">Bots that take orders and answer customers.</p>
    </div>
  </article>

  <!-- Web apps: an unsaved change, ready to save -->
  <article class="tile tile--app">
    <div class="tile__stage">
      <div class="settings">
        <p class="settings__title">Notifications</p>
        <label class="switch">
          <input type="checkbox" role="switch" data-app-toggle checked />
          <span class="switch__track" aria-hidden="true"></span>
          <span>Weekly report by email</span>
        </label>
        <button type="button" class="save" data-app-save data-state="changed" aria-describedby="app-save-note">
          <span class="save__label" data-app-label>Save changes</span>
        </button>
        <p id="app-save-note" class="settings__note" data-app-note>You have one unsaved change.</p>
      </div>
    </div>
    <div class="tile__meta">
      <div class="tile__row"><h3 class="tile__title">Web Apps & SaaS</h3><span class="tile__hint" aria-hidden="true">Save</span></div>
      <p class="tile__text">Bookings, dashboards and client portals.</p>
    </div>
  </article>

  <!-- Mobile: a real screen that follows its dark mode switch -->
  <article class="tile tile--phone">
    <div class="tile__stage">
      <div class="phone" data-phone data-theme="light">
        <div class="phone__screen" aria-hidden="true">
          <span class="phone__notch"></span>
          <span class="phone__hi">Good morning</span>
          <span class="phone__card"><small>Your order</small><b>Ready at 8:40</b></span>
          <span class="phone__row"><i></i>2 × Flat white</span>
          <span class="phone__row"><i></i>Pick up at the counter</span>
        </div>
      </div>
      <label class="switch switch--center">
        <input type="checkbox" role="switch" data-phone-toggle />
        <span class="switch__track" aria-hidden="true"></span>
        <span>Dark mode</span>
      </label>
    </div>
    <div class="tile__meta">
      <div class="tile__row"><h3 class="tile__title">Mobile & Desktop Apps</h3><span class="tile__hint" aria-hidden="true">Switch</span></div>
      <p class="tile__text">Apps for iPhone, Android, Mac and Windows.</p>
    </div>
  </article>

  <!-- AI: an automation, half way through a run -->
  <article class="tile tile--ai">
    <div class="tile__stage tile__stage--ai">
      <ol class="flow" data-flow>
        {
          steps.map((step, i) => (
            <li class="flow__step" data-state={i < DONE_AT_REST ? 'done' : i === DONE_AT_REST ? 'running' : 'waiting'}>
              <span class="flow__dot" aria-hidden="true">
                <Icon name="check" size={14} strokeWidth={3} />
              </span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
      <button type="button" class="run" data-flow-run>Run it</button>
      <p class="visually-hidden" aria-live="polite" data-flow-status></p>
    </div>
    <div class="tile__meta">
      <div class="tile__row"><h3 class="tile__title">AI & Automation</h3><span class="tile__hint" aria-hidden="true">Run</span></div>
      <p class="tile__text">Replies, sorting and data entry, automated.</p>
    </div>
  </article>

  <!-- Search: this page, measured now -->
  <article class="tile tile--seo">
    <div class="tile__stage tile__stage--seo">
      <p class="seo__intro">This page, measured live in your browser</p>
      <dl class="seo__stats">
        <div><dt>Loaded in</dt><dd data-stat="load">...</dd></div>
        <div><dt>Page weight</dt><dd data-stat="weight">...</dd></div>
        <div><dt>Requests</dt><dd data-stat="requests">...</dd></div>
      </dl>
      <ul class="seo__checks" aria-label="Check this site yourself">
        {
          checks.map((check) => (
            <li>
              <a
                href={check.href}
                {...(check.external ? { target: '_blank', rel: 'noopener' } : {})}
                data-umami-event="Site check"
                data-umami-event-check={check.label}
              >
                {check.label}
                {check.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                <Icon name={check.external ? 'arrow-up-right' : 'arrow-right'} size={14} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="tile__meta">
      <div class="tile__row"><h3 class="tile__title">Search & Growth</h3><span class="tile__hint tile__hint--live" aria-hidden="true">Live</span></div>
      <p class="tile__text">Get found on Google and in ChatGPT.</p>
    </div>
  </article>
</div>

<style>
  /* ---------- Grid: one wide tile, one tall tile, the rest standard ---------- */

  .bench {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      'web web bot'
      'app phone bot'
      'ai ai seo';
    gap: 14px;
  }
  .tile--web { grid-area: web; }
  .tile--bot { grid-area: bot; }
  .tile--app { grid-area: app; }
  .tile--phone { grid-area: phone; }
  .tile--ai { grid-area: ai; }
  .tile--seo { grid-area: seo; }
  @media (max-width: 1023.98px) {
    .bench {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'web web'
        'bot app'
        'bot phone'
        'ai ai'
        'seo seo';
    }
  }
  @media (max-width: 639.98px) {
    .bench {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'web' 'bot' 'app' 'phone' 'ai' 'seo';
    }
  }

  .tile {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-tile);
    overflow: hidden;
  }
  .tile__stage {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    gap: 16px;
    min-height: 220px;
    padding: 24px;
    /* Two faint brand tints, placed differently per tile, so no two stages look the same. */
    background:
      radial-gradient(70% 60% at var(--g1, 0% 0%), rgb(28 202 216 / 0.09), transparent 70%),
      radial-gradient(60% 55% at var(--g2, 100% 100%), rgb(47 140 246 / 0.07), transparent 70%),
      var(--paper);
    border-bottom: 1px solid var(--line-soft);
  }
  .tile--bot .tile__stage { --g1: 100% 0%; --g2: 0% 100%; }
  .tile--app .tile__stage { --g1: 50% 0%; --g2: 100% 80%; }
  .tile--phone .tile__stage { --g1: 0% 100%; --g2: 100% 0%; }
  .tile--ai .tile__stage { --g1: 20% 100%; --g2: 90% 10%; }
  .tile--seo .tile__stage { --g1: 100% 50%; --g2: 0% 0%; }
  /* One verb next to the title says how to play with the demo. */
  .tile__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .tile__hint {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 11px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line-soft);
    font-size: 12px;
    font-weight: 700;
    color: var(--ink-2);
  }
  .tile__hint {
    transition:
      background-color 200ms var(--ease-out),
      border-color 200ms var(--ease-out),
      color 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }
  .tile {
    transition: border-color 240ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover {
      border-color: var(--line);
    }
    .tile:hover .tile__hint:not(.tile__hint--live) {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--white);
      transform: translateY(-1px);
    }
  }
  .tile__hint--live::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #12b76a;
    box-shadow: 0 0 0 3px rgb(18 183 106 / 0.18);
    animation: live 2s ease-in-out infinite;
  }
  @keyframes live {
    50% {
      box-shadow: 0 0 0 5px rgb(18 183 106 / 0.08);
    }
  }
  .tile__meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 24px 22px;
  }
  .tile__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.2;
  }
  .tile__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* ---------- Websites ---------- */

  .tile__stage--web {
    align-content: center;
    min-height: 300px;
  }
  .web__frame {
    width: 100%;
    max-width: 640px;
    justify-self: center;
    background: var(--white);
    border: 1px solid rgb(10 17 40 / 0.12);
    border-radius: 14px;
    box-shadow: 0 18px 40px -26px rgb(10 17 40 / 0.4);
    overflow: hidden;
    transition: width 120ms linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .web__frame {
      transition: none;
    }
  }
  .web__bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--line-soft);
    font-size: 11px;
    color: var(--muted);
  }
  .web__bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }
  .web__bar span {
    margin-left: 6px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--paper);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The mini site is a real café homepage that takes the layout of the width the slider simulates. */
  .mini {
    padding: 12px 14px 16px;
    display: grid;
    gap: 12px;
    font-size: 11px;
    color: var(--ink);
  }
  .mini__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mini__nav b {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .mini__links {
    display: flex;
    gap: 12px;
  }
  .mini__links i {
    font-style: normal;
    font-weight: 600;
    color: var(--ink-2);
  }
  .mini__burger {
    display: none;
    flex-direction: column;
    gap: 3px;
  }
  .mini__burger i {
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
  }
  .mini__hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border-radius: 12px;
    background: var(--tint-cyan);
  }
  .mini__copy {
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .mini__h {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .mini__btn {
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-weight: 700;
    font-size: 10px;
  }
  .mini__cup {
    width: 100%;
    max-width: 120px;
    justify-self: center;
  }
  /* The menu cards wrap when the frame itself is narrow, so nothing is ever cut off. */
  .mini__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(92px, 1fr));
    gap: 8px;
  }
  .mini__cards span {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
    border-radius: 9px;
    background: var(--paper);
    border: 1px solid var(--line-soft);
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
  }
  .mini__dot {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }
  .mini__dot--a { background: var(--teal); }
  .mini__dot--b { background: var(--g-blue); }
  .mini__dot--c { background: var(--g-violet); }
  .mini[data-size='phone'] .mini__links {
    display: none;
  }
  .mini[data-size='phone'] .mini__burger {
    display: flex;
  }
  .mini[data-size='phone'] .mini__hero {
    grid-template-columns: 1fr;
  }
  .mini[data-size='phone'] .mini__cup {
    display: none;
  }
  .mini[data-size='phone'] .mini__h {
    font-size: 16px;
  }
  .mini[data-size='phone'] .mini__cards {
    grid-template-columns: 1fr;
  }
  .mini[data-size='tablet'] .mini__cards {
    grid-template-columns: repeat(2, 1fr);
  }
  .mini[data-size='tablet'] .mini__cards span:last-child {
    display: none;
  }
  .web__control {
    width: 100%;
    max-width: 640px;
    justify-self: center;
    display: grid;
    gap: 8px;
  }
  .web__label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    font-weight: 700;
  }
  .web__label output {
    font-weight: 600;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  input[type='range'] {
    width: 100%;
    height: 28px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 999px;
    background: var(--line);
  }
  input[type='range']::-moz-range-track {
    height: 6px;
    border-radius: 999px;
    background: var(--line);
  }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -8px;
    border-radius: 50%;
    background: var(--ink);
    border: 3px solid var(--white);
    box-shadow: 0 1px 4px rgb(10 17 40 / 0.35);
    transition: transform 160ms var(--ease-pop);
  }
  input[type='range']::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--ink);
    border: 3px solid var(--white);
    box-shadow: 0 1px 4px rgb(10 17 40 / 0.35);
  }
  input[type='range']:active::-webkit-slider-thumb {
    transform: scale(1.15);
  }
  input[type='range']:focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 2px;
    border-radius: 999px;
  }

  /* ---------- Telegram chat ---------- */

  .tile__stage--bot {
    align-content: stretch;
    place-items: stretch;
  }
  .chat {
    display: flex;
    flex-direction: column;
    min-height: 420px;
    background: #e7eef4;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line-soft);
  }
  .chat__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--white);
    border-bottom: 1px solid var(--line-soft);
    font-size: 14px;
  }
  .chat__head b {
    display: block;
    line-height: 1.2;
  }
  .chat__head small {
    color: var(--muted);
    font-size: 12px;
  }
  .chat__avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--teal-ink);
    color: var(--white);
    font-weight: 800;
  }
  .chat__log {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 14px 12px;
    overflow: hidden;
  }
  .chat__log :global(.msg) {
    margin: 0;
    max-width: 84%;
    padding: 8px 12px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.4;
    animation: msg-in 260ms var(--ease-out) both;
  }
  .chat__log :global(.msg--bot) {
    align-self: flex-start;
    background: var(--white);
    border-bottom-left-radius: 6px;
    transform-origin: bottom left;
  }
  .chat__day {
    align-self: center;
    margin: 0 0 4px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(10 17 40 / 0.06);
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-2);
  }
  .chat__log :global(.msg--menu) {
    display: grid;
    gap: 6px;
    min-width: 62%;
  }
  .msg--menu b {
    font-size: 13px;
  }
  .msg--menu span {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }
  .chat__log :global(.msg--me) {
    align-self: flex-end;
    background: #d6f2df;
    border-bottom-right-radius: 6px;
    transform-origin: bottom right;
  }
  @keyframes msg-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.96);
    }
  }
  .chat__log :global(.typing) {
    display: inline-flex;
    gap: 4px;
    padding: 12px 14px;
  }
  .chat__log :global(.typing i) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    animation: dot 1s infinite ease-in-out;
  }
  .chat__log :global(.typing i:nth-child(2)) {
    animation-delay: 0.15s;
  }
  .chat__log :global(.typing i:nth-child(3)) {
    animation-delay: 0.3s;
  }
  @keyframes dot {
    0%,
    60%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }
  .chat__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 10px 12px 12px;
    background: var(--white);
    border-top: 1px solid var(--line-soft);
  }
  .chat__chip {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink);
    font: 600 13px/1 var(--font-body);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      border-color 160ms var(--ease-out);
  }
  .chat__chip:hover {
    border-color: var(--ink);
  }
  .chat__chip:active {
    transform: scale(0.96);
  }
  .chat__chip[aria-disabled='true'] {
    opacity: 0.45;
    cursor: default;
  }

  /* ---------- Switches (app and phone tiles) ---------- */

  .switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .switch input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .switch__track {
    position: relative;
    flex: none;
    width: 46px;
    height: 28px;
    border-radius: 999px;
    background: #cfd7e2;
    transition: background-color 200ms var(--ease-out);
  }
  .switch__track::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 1px 3px rgb(10 17 40 / 0.3);
    transition: transform 260ms var(--ease-pop);
  }
  .switch input:checked + .switch__track {
    background: var(--teal);
  }
  .switch input:checked + .switch__track::after {
    transform: translateX(18px);
  }
  .switch input:focus-visible + .switch__track {
    outline: 3px solid var(--teal);
    outline-offset: 2px;
  }

  /* ---------- Web app settings ---------- */

  .settings {
    width: 100%;
    max-width: 300px;
    display: grid;
    gap: 10px;
    padding: 18px;
    background: var(--white);
    border: 1px solid var(--line-soft);
    border-radius: 18px;
    box-shadow: 0 12px 30px -22px rgb(10 17 40 / 0.4);
  }
  .settings__title {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
  }
  .settings__note {
    margin: 0;
    font-size: 12px;
    color: var(--muted);
  }
  .save {
    justify-self: start;
    min-width: 150px;
    min-height: 42px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font: 700 14px/1 var(--font-body);
    cursor: pointer;
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out),
      transform 160ms var(--ease-out),
      opacity 200ms var(--ease-out);
  }
  .save:active {
    transform: scale(0.97);
  }
  .save[aria-disabled='true'] {
    cursor: default;
  }
  .save[data-state='saving'] {
    background: #cfd7e2;
    color: var(--ink);
  }
  /* Saved reads as a confirmation, not as a broken button. */
  .save[data-state='saved'] {
    background: var(--tint-cyan);
    color: var(--teal-ink);
  }
  .save[data-state='saved'] :global(svg) {
    animation: pop 320ms var(--ease-pop);
  }
  .save__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .save :global(.spin) {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid currentColor;
    border-right-color: transparent;
    animation: spin 700ms linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ---------- Phone ---------- */

  .phone {
    width: 132px;
    padding: 6px;
    border-radius: 28px;
    background: var(--ink);
    box-shadow: 0 18px 40px -24px rgb(10 17 40 / 0.6);
  }
  .phone__screen {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: start;
    height: 200px;
    padding: 26px 12px 12px;
    border-radius: 22px;
    background: #f5fafc;
    transition: background-color 320ms var(--ease-out);
  }
  .phone__notch {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 40px;
    height: 8px;
    margin-left: -20px;
    border-radius: 999px;
    background: var(--ink);
  }
  .phone__hi {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 800;
    color: var(--ink);
    transition: color 320ms var(--ease-out);
  }
  .phone__card {
    display: grid;
    gap: 2px;
    padding: 9px 10px;
    border-radius: 12px;
    background: var(--teal-ink);
    color: var(--white);
  }
  .phone__card small {
    font-size: 8.5px;
    opacity: 0.85;
  }
  .phone__card b {
    font-size: 12px;
  }
  .phone__row {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 8px;
    border-radius: 10px;
    background: var(--white);
    font-size: 9px;
    font-weight: 600;
    color: var(--ink-2);
    transition:
      background-color 320ms var(--ease-out),
      color 320ms var(--ease-out);
  }
  .phone__row i {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 5px;
    background: var(--tint-cyan);
    transition: background-color 320ms var(--ease-out);
  }
  .phone[data-theme='dark'] .phone__screen {
    background: #0e1530;
  }
  .phone[data-theme='dark'] .phone__hi {
    color: #e8edf7;
  }
  .phone[data-theme='dark'] .phone__row {
    background: #1b2547;
    color: #c9d3ea;
  }
  .phone[data-theme='dark'] .phone__row i {
    background: #2a3866;
  }
  .switch--center {
    justify-self: center;
  }

  /* ---------- AI flow ---------- */

  .tile__stage--ai {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    justify-items: start;
    gap: 20px 28px;
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .flow__step {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    transition: color 200ms var(--ease-out);
  }
  .flow__dot {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px dashed #b9c4d3;
    color: transparent;
    transition:
      background-color 200ms var(--ease-out),
      border-color 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }
  .flow__step[data-state='running'] {
    color: var(--ink);
  }
  .flow__step[data-state='running'] .flow__dot {
    border: 2px solid var(--teal);
    border-right-color: transparent;
    animation: spin 700ms linear infinite;
  }
  .flow__step[data-state='done'] {
    color: var(--ink);
  }
  .flow__step[data-state='done'] .flow__dot {
    border: 0;
    background: var(--teal);
    color: var(--white);
    animation: pop 320ms var(--ease-pop);
  }
  @keyframes pop {
    from {
      transform: scale(0.6);
    }
  }
  .run {
    min-height: 44px;
    padding: 0 22px;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font: 700 15px/1 var(--font-body);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      opacity 160ms var(--ease-out);
  }
  .run:active {
    transform: scale(0.97);
  }
  .run[aria-disabled='true'] {
    opacity: 0.55;
    cursor: progress;
  }
  @media (max-width: 639.98px) {
    .tile__stage--ai {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Search ---------- */

  .tile__stage--seo {
    place-items: stretch;
    align-content: center;
  }
  .seo__intro {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .seo__stats {
    margin: 0;
    display: grid;
    gap: 2px;
  }
  .seo__stats div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .seo__stats dt {
    font-size: 14px;
    color: var(--ink-2);
  }
  .seo__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .seo__checks {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .seo__checks a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition:
      border-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .seo__checks a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .seo__checks a:active {
    transform: scale(0.96);
  }

  @media (prefers-reduced-motion: reduce) {
    .chat__log :global(.msg),
    .flow__step .flow__dot,
    .chat__log :global(.typing i) {
      animation: none !important;
    }
  }
</style>

<script>
  const bench = document.querySelector<HTMLElement>('[data-bench]');
  if (bench) initBench(bench);

  function initBench(root: HTMLElement) {
    const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, reduce() ? Math.min(ms, 120) : ms));
    /** Busy controls keep focus (aria-disabled), so keyboard users are never thrown back to the top. */
    const setBusy = (el: HTMLElement, busy: boolean) => el.setAttribute('aria-disabled', String(busy));
    const isBusy = (el: HTMLElement) => el.getAttribute('aria-disabled') === 'true';
    /** Runs once, the first time an element is mostly on screen. */
    const onFirstView = (el: Element, run: () => void) => {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            run();
          }
        },
        { threshold: 0.5 },
      );
      io.observe(el);
    };

    // ---------- Websites: the slider sets the frame width and the mini site takes that layout.
    const range = root.querySelector<HTMLInputElement>('[data-web-range]');
    const frame = root.querySelector<HTMLElement>('[data-web-frame]');
    const out = root.querySelector<HTMLOutputElement>('[data-web-out]');
    const mini = root.querySelector<HTMLElement>('.mini');
    if (range && frame && out && mini) {
      const min = Number(range.min);
      const max = Number(range.max);
      const update = () => {
        const px = Number(range.value);
        frame.style.width = `${34 + ((px - min) / (max - min)) * 66}%`;
        const device = px < 600 ? 'Phone' : px < 1000 ? 'Tablet' : 'Desktop';
        out.textContent = `${device}, ${px} px`;
        mini.dataset.size = device.toLowerCase();
      };
      range.addEventListener('input', update);
      update();
      // A one-time demonstration drag shows the tile is alive; any touch of the slider stops it.
      let touched = false;
      const stop = () => (touched = true);
      range.addEventListener('pointerdown', stop);
      range.addEventListener('keydown', stop);
      onFirstView(frame, () => {
        if (reduce() || touched) return;
        const path = [1280, 470, 470, 1280];
        const times = [0, 900, 1500, 2400];
        const start = performance.now();
        const ease = (t: number) => 1 - Math.pow(1 - t, 3);
        const tick = (now: number) => {
          if (touched) return;
          const t = now - start;
          let i = 0;
          while (i < times.length - 2 && t > times[i + 1]!) i++;
          const span = times[i + 1]! - times[i]!;
          const k = Math.min(1, Math.max(0, (t - times[i]!) / span));
          range.value = String(Math.round(path[i]! + (path[i + 1]! - path[i]!) * ease(k)));
          update();
          if (t < times[times.length - 1]!) requestAnimationFrame(tick);
        };
        window.setTimeout(() => requestAnimationFrame(tick), 300);
      });
    }

    // ---------- Telegram: the conversation replays once on first view; replies answer after typing.
    const log = root.querySelector<HTMLElement>('[data-chat-log]');
    const chips = root.querySelector<HTMLElement>('[data-chat-chips]');
    if (log && chips) {
      const buttons = [...chips.querySelectorAll<HTMLButtonElement>('button')];
      let chatting = false;
      const bubble = (text: string, who: 'me' | 'bot') => {
        const p = document.createElement('p');
        p.className = `msg msg--${who}`;
        p.textContent = text;
        log.appendChild(p);
        while (log.children.length > 5) log.firstElementChild?.remove();
        return p;
      };
      const typing = () => {
        const t = bubble('', 'bot');
        t.classList.add('typing');
        t.setAttribute('aria-hidden', 'true');
        t.innerHTML = '<i></i><i></i><i></i>';
        return t;
      };
      const say = async (mine: string, reply: string) => {
        chatting = true;
        buttons.forEach((b) => setBusy(b, true));
        bubble(mine, 'me');
        await wait(260);
        const t = typing();
        await wait(900);
        t.remove();
        bubble(reply, 'bot');
        buttons.forEach((b) => setBusy(b, false));
        chatting = false;
      };
      chips.addEventListener('click', (event) => {
        const b = (event.target as Element).closest<HTMLButtonElement>('button');
        if (!b || chatting || isBusy(b)) return;
        void say(b.dataset.say ?? '', b.dataset.reply ?? '');
      });
      onFirstView(log, () => {
        if (reduce() || chatting) return;
        const replay = [...log.querySelectorAll<HTMLElement>('[data-replay]')];
        const [mine, answer] = replay.map((el) => el.textContent ?? '');
        replay.forEach((el) => el.remove());
        void say(mine ?? '', answer ?? '');
      });
    }

    // ---------- Web app: changed, saving, saved. The button keeps focus throughout.
    const toggle = root.querySelector<HTMLInputElement>('[data-app-toggle]');
    const save = root.querySelector<HTMLButtonElement>('[data-app-save]');
    const label = root.querySelector<HTMLElement>('[data-app-label]');
    const note = root.querySelector<HTMLElement>('[data-app-note]');
    if (toggle && save && label && note) {
      let savedValue = !toggle.checked;
      const sync = () => {
        if (save.dataset.state === 'saving') return;
        const changed = toggle.checked !== savedValue;
        save.dataset.state = changed ? 'changed' : 'saved';
        setBusy(save, !changed);
        label.innerHTML = changed ? 'Save changes' : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Saved';
        note.textContent = changed ? 'You have one unsaved change.' : 'All changes saved.';
      };
      toggle.addEventListener('change', sync);
      save.addEventListener('click', async () => {
        if (isBusy(save) || save.dataset.state !== 'changed') return;
        save.dataset.state = 'saving';
        setBusy(save, true);
        label.innerHTML = '<i class="spin" aria-hidden="true"></i>Saving';
        note.textContent = 'Saving…';
        await wait(900);
        savedValue = toggle.checked;
        save.dataset.state = 'idle';
        sync();
      });
    }

    // ---------- Mobile: the screen follows its dark mode switch.
    const phone = root.querySelector<HTMLElement>('[data-phone]');
    const phoneToggle = root.querySelector<HTMLInputElement>('[data-phone-toggle]');
    phoneToggle?.addEventListener('change', () => {
      if (phone) phone.dataset.theme = phoneToggle.checked ? 'dark' : 'light';
    });

    // ---------- AI: four steps run in order; the button keeps focus while it runs.
    const flow = root.querySelector<HTMLElement>('[data-flow]');
    const run = root.querySelector<HTMLButtonElement>('[data-flow-run]');
    const status = root.querySelector<HTMLElement>('[data-flow-status]');
    if (flow && run) {
      const steps = [...flow.querySelectorAll<HTMLElement>('.flow__step')];
      run.addEventListener('click', async () => {
        if (isBusy(run)) return;
        setBusy(run, true);
        steps.forEach((s) => (s.dataset.state = 'waiting'));
        if (status) status.textContent = 'Running.';
        for (const step of steps) {
          step.dataset.state = 'running';
          await wait(650);
          step.dataset.state = 'done';
        }
        if (status) status.textContent = 'All four steps are done.';
        run.textContent = 'Run again';
        setBusy(run, false);
      });
    }

    // ---------- Search: real numbers for this page load, from the browser's own timing data.
    const set = (key: string, value: string) => {
      const el = root.querySelector<HTMLElement>(`[data-stat="${key}"]`);
      if (el) el.textContent = value;
    };
    const kb = (bytes: number) => (bytes >= 1048576 ? `${(bytes / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`);
    const measure = () => {
      const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      const resources = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
      if (nav && nav.loadEventStart > 0) set('load', `${(nav.loadEventStart / 1000).toFixed(2)} s`);
      const bytes = (nav?.transferSize ?? 0) + resources.reduce((sum, r) => sum + (r.transferSize || 0), 0);
      set('weight', bytes > 0 ? kb(bytes) : 'from cache');
      set('requests', String(resources.length + 1));
    };
    if (document.readyState === 'complete') window.setTimeout(measure, 0);
    else window.addEventListener('load', () => window.setTimeout(measure, 0), { once: true });
  }
</script>
