---
import Icon from './Icon.astro';

interface Props {
  title: string;
  text?: string;
  /**
   * 'ink' = dark copy and a dark button (most pages).
   * 'white' = white copy and a white button (Home).
   */
  tone?: 'ink' | 'white';
  /** 'full' pads 96px above and below; 'bottom' only below (when it follows a section on paper). */
  pad?: 'full' | 'bottom';
  borderTop?: boolean;
  /** Optional second, outlined button, e.g. "More work". */
  secondary?: { href: string; label: string };
  /** The kind of project the page is about, ticked in the call request form (one of `services`). */
  need?: string;
}

const {
  title,
  text = 'A free 30-minute call about what you want to launch. You leave with a clear next step.',
  tone = 'ink',
  pad = 'full',
  borderTop = false,
  secondary,
  need,
} = Astro.props;
---

<section class:list={['cta', `cta--${pad}`, { 'border-top': borderTop }]}>
  <div class:list={['cta__band', `cta__band--${tone}`]}>
    <svg
      aria-hidden="true"
      viewBox="0 0 600 300"
      preserveAspectRatio="xMaxYMid slice"
      fill="none"
      class="cta__art"
    >
      <path
        d="M120 340 C 200 180, 340 300, 420 160 C 480 60, 560 40, 680 80"
        stroke="#FFFFFF"
        stroke-opacity="0.35"
        stroke-width="80"
        stroke-linecap="round"></path>
    </svg>
    <div class="cta__copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <a
        href="/contact"
        class="btn btn--lg btn--accent"
        data-book-call
        data-book-need={need}
        data-umami-event="Book a call"
        data-umami-event-from="cta-band"
      >
        Book a call<Icon name="arrow-right" />
      </a>
      {
        secondary && (
          <a href={secondary.href} class="btn btn--lg cta__secondary">
            {secondary.label}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--paper);
    padding: 96px var(--gutter);
  }
  .cta--bottom {
    padding-top: 0;
  }
  /* One closing tile in ink, on every page; the button is the site's only cyan pill. */
  .cta__band {
    position: relative;
    overflow: hidden;
    max-width: 1192px;
    margin: 0 auto;
    background: var(--ink);
    color: var(--white);
    border-radius: var(--radius-tile);
    padding: 64px clamp(24px, 5%, 72px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .cta__art {
    position: absolute;
    right: 0;
    top: 0;
    width: 60%;
    height: 100%;
  }
  .cta__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 660px;
  }
  .cta__copy h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .cta__copy p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    font-weight: 500;
  }
  .cta__copy p {
    color: var(--footer-text);
  }
  .cta__art :global(path) {
    stroke: var(--cyan);
    stroke-opacity: 0.14;
  }
  .cta__secondary {
    background: transparent;
    color: var(--white);
    border: 1px solid rgb(255 255 255 / 0.35);
  }
  .cta__secondary:hover {
    color: var(--white);
    border-color: var(--white);
  }
  .cta__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ---------- Phones: 64px above it like every section, a compact band, the button across ---------- */
  @media (max-width: 639.98px) {
    .cta,
    .cta--bottom {
      padding: 64px var(--gutter) 0;
    }
    .cta__band {
      gap: 22px;
      padding: 30px 22px;
    }
    .cta__copy h2 {
      font-size: 30px;
      line-height: 1.1;
    }
    .cta__copy p {
      font-size: 16px;
    }
    .cta__actions {
      width: 100%;
    }
  }
</style>
