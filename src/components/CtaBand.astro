---
import Icon from './Icon.astro';

interface Props {
  title: string;
  text?: string;
  /**
   * 'ink' = dark copy and a dark button (most pages).
   * 'white' = white copy and a white button (Home).
   */
  tone?: 'ink' | 'white';
  /** 'full' pads 96px above and below; 'bottom' only below (when it follows a section on paper). */
  pad?: 'full' | 'bottom';
  borderTop?: boolean;
  /** Optional second, outlined button, e.g. "More work". */
  secondary?: { href: string; label: string };
  /** The kind of project the page is about, ticked in the call request form (one of `services`). */
  need?: string;
}

const {
  title,
  text = 'A free 30-minute call about what you want to launch. You leave with a clear next step.',
  tone = 'ink',
  pad = 'full',
  borderTop = false,
  secondary,
  need,
} = Astro.props;
---

<section class:list={['cta', `cta--${pad}`, { 'border-top': borderTop }]}>
  <div class:list={['cta__band', `cta__band--${tone}`]} data-cta-band>
    <span class="cta__dots" aria-hidden="true"></span>
    <svg
      aria-hidden="true"
      viewBox="0 0 600 300"
      preserveAspectRatio="xMaxYMid slice"
      fill="none"
      class="cta__art"
    >
      <path
        d="M120 340 C 200 180, 340 300, 420 160 C 480 60, 560 40, 680 80"
        stroke="#FFFFFF"
        stroke-opacity="0.35"
        stroke-width="80"
        stroke-linecap="round"></path>
    </svg>
    <div class="cta__copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <a
        href="/contact"
        class="btn btn--lg btn--accent"
        data-book-call
        data-book-need={need}
        data-umami-event="Book a call"
        data-umami-event-from="cta-band"
      >
        Book a call<Icon name="arrow-right" />
      </a>
      {
        secondary && (
          <a href={secondary.href} class="btn btn--lg cta__secondary">
            {secondary.label}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--paper);
    padding: 96px var(--gutter);
  }
  .cta--bottom {
    padding-top: 0;
  }
  /* One closing tile in ink, on every page; the button is the site's only cyan pill. */
  .cta__band {
    position: relative;
    overflow: hidden;
    max-width: 1192px;
    margin: 0 auto;
    background: var(--ink);
    color: var(--white);
    border-radius: var(--radius-tile);
    padding: 64px clamp(24px, 5%, 72px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  /* A field of ink-blue dots, lit only around the pointer (resting on the right when there is none). */
  .cta__dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle, rgb(255 255 255 / 0.22) 0.9px, transparent 1.1px) 0 0 / 14px 14px;
    -webkit-mask-image: radial-gradient(circle 260px at var(--mx, 78%) var(--my, 50%), #000, transparent 75%);
    mask-image: radial-gradient(circle 260px at var(--mx, 78%) var(--my, 50%), #000, transparent 75%);
  }
  .cta__art {
    position: absolute;
    right: 0;
    top: 0;
    width: 60%;
    height: 100%;
  }
  .cta__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 660px;
  }
  .cta__copy h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .cta__copy p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    font-weight: 500;
  }
  .cta__copy p {
    color: var(--footer-text);
  }
  .cta__art :global(path) {
    stroke: var(--cyan);
    stroke-opacity: 0.14;
  }
  .cta__secondary {
    background: transparent;
    color: var(--white);
    border: 1px solid rgb(255 255 255 / 0.35);
  }
  .cta__secondary:hover {
    color: var(--white);
    border-color: var(--white);
  }
  .cta__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>

<script>
  // Moves the dots' light with the pointer: two custom properties, at most once a frame.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-cta-band]').forEach((band) => {
    let queued = false;
    let x = 0;
    let y = 0;
    band.addEventListener('pointermove', (event) => {
      if (!fine.matches || still.matches) return;
      const r = band.getBoundingClientRect();
      x = event.clientX - r.left;
      y = event.clientY - r.top;
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        band.style.setProperty('--mx', `${Math.round(x)}px`);
        band.style.setProperty('--my', `${Math.round(y)}px`);
      });
    });
    band.addEventListener('pointerleave', () => {
      band.style.removeProperty('--mx');
      band.style.removeProperty('--my');
    });
  });
</script>
