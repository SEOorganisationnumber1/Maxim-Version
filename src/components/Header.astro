---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { mainNav, site } from '../data/site';

interface Props {
  /** href of the nav item to mark as the current page, e.g. '/work'. */
  current?: string;
}

const { current } = Astro.props;
const isCurrent = (href: string) => (href === current ? 'page' : undefined);

/** The nav underline: one soft wave that ends rising, the hero ribbons in miniature. */
const CURVE = 'M3 8 C 22 2, 38 2, 52 6.5 S 80 11, 97 4';
---

<header class="header">
  {/* The brand gradient for every nav curve, defined once (header and menu sheet). */}
  <svg class="nav-curve-defs" aria-hidden="true" focusable="false" width="0" height="0">
    <defs>
      <linearGradient id="nav-curve-gradient" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#22D3DD"></stop>
        <stop offset="0.55" stop-color="#2F8CF6"></stop>
        <stop offset="1" stop-color="#5B4FE9"></stop>
      </linearGradient>
    </defs>
  </svg>
  <div class="header__inner">
    <Logo id="logo-h" />
    <nav aria-label="Main" class="header__nav">
      {
        mainNav.map((item) => (
          <a href={item.href} class="header__link" aria-current={isCurrent(item.href)}>
            {item.label}
            <svg class="nav-curve" aria-hidden="true" focusable="false" viewBox="0 0 100 12" preserveAspectRatio="none">
              <path d={CURVE}></path>
            </svg>
          </a>
        ))
      }
      <a
        href="/contact"
        class="header__cta"
        aria-current={isCurrent('/contact')}
        data-umami-event="Book a call"
        data-umami-event-from="header"
      >
        Book a call
      </a>
    </nav>
    {/* Below 900px the links move into the menu sheet. The Popover API opens and closes it,
        Esc and the back button included, without JavaScript. */}
    <button type="button" class="header__menu-btn" popovertarget="site-menu" aria-label="Menu">
      <Icon name="menu" size={22} />
    </button>
  </div>
</header>

<div id="site-menu" class="menu" popover>
  <div class="menu__top">
    <Logo id="logo-m" class="menu__logo" />
    <button
      type="button"
      class="menu__close"
      popovertarget="site-menu"
      popovertargetaction="hide"
      aria-label="Close menu"
      autofocus
    >
      <Icon name="close" size={20} />
    </button>
  </div>
  <nav aria-label="Main">
    <ul class="menu__links">
      {
        mainNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href)}>
              <span class="menu__label">
                {item.label}
                <svg class="nav-curve nav-curve--menu" aria-hidden="true" focusable="false" viewBox="0 0 100 12" preserveAspectRatio="none">
                  <path d={CURVE}></path>
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menu__foot">
    <a
      href="/contact"
      class="btn btn--primary btn--lg"
      aria-current={isCurrent('/contact')}
      data-umami-event="Book a call"
      data-umami-event-from="menu"
    >
      Book a call<Icon name="arrow-right" />
    </a>
    {
      site.email && (
        <p class="menu__mail">
          Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      )
    }
  </div>
</div>

<script>
  // The sheet covers the page, so while it is open the page behind it is inert for keyboard and
  // screen reader users. It also closes when the window grows past the breakpoint and when a
  // page comes back from the back/forward cache with the sheet still open.
  const menu = document.getElementById('site-menu');
  if (menu && 'hidePopover' in menu) {
    const behind = [...document.querySelectorAll<HTMLElement>('.site > :not(#site-menu)')];
    menu.addEventListener('beforetoggle', (event) => {
      const open = (event as ToggleEvent).newState === 'open';
      for (const el of behind) el.inert = open;
    });
    const close = () => {
      if (menu.matches(':popover-open')) menu.hidePopover();
    };
    window.matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
      if (event.matches) close();
    });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) close();
    });
  }
</script>

<style>
  .header {
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    max-width: var(--container);
    margin: 0 auto;
    padding: 16px var(--gutter);
  }
  .header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
  }
  .header__link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }
  .header__link:hover {
    color: var(--ink);
  }

  /* ---------- Nav curve ---------- */

  .nav-curve-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  /* Under the link text. Hidden by a clip that covers it from the right; hover, keyboard focus
     and the current page open the clip, so the wave draws in from the left. A transition, so a
     quick hover in and out turns back from where it is instead of restarting. */
  .nav-curve {
    position: absolute;
    left: 12px;
    bottom: 1px;
    width: calc(100% - 24px);
    height: 10px;
    overflow: visible;
    pointer-events: none;
    clip-path: inset(-4px 100% -4px -4px);
    transition: clip-path 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .nav-curve path {
    fill: none;
    stroke: url(#nav-curve-gradient);
    stroke-width: 2.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .header__link[aria-current='page'] .nav-curve,
  .header__link:focus-visible .nav-curve {
    clip-path: inset(-4px);
  }
  @media (hover: hover) and (pointer: fine) {
    .header__link:hover .nav-curve {
      clip-path: inset(-4px);
      transition-duration: 240ms;
    }
  }
  /* Reduced motion: the wave fades in place instead of drawing. */
  @media (prefers-reduced-motion: reduce) {
    .nav-curve {
      clip-path: inset(-4px);
      opacity: 0;
      transition: opacity 150ms ease;
    }
    .header__link[aria-current='page'] .nav-curve,
    .header__link:focus-visible .nav-curve {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) and (hover: hover) and (pointer: fine) {
    .header__link:hover .nav-curve {
      opacity: 1;
    }
  }
  .header__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-left: 8px;
    padding: 0 18px;
    background: var(--cyan);
    color: var(--ink);
    font-weight: 700;
    font-size: 15px;
    border-radius: 8px;
    text-decoration: none;
  }
  .header__cta:hover {
    color: var(--ink);
    background: #3fd5e1;
  }
  .header__cta[aria-current='page'],
  .header__cta[aria-current='page']:hover {
    background: var(--ink);
    color: var(--white);
  }

  /* ---------- Menu button and sheet (below 900px) ---------- */

  .header__menu-btn,
  .menu__close {
    flex: none;
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .header__menu-btn:active,
  .menu__close:active {
    transform: scale(0.96);
  }
  .menu__close {
    display: grid;
    background: transparent;
    color: var(--white);
    border-color: rgb(255 255 255 / 0.55);
  }

  @media (max-width: 899.98px) {
    .header__inner {
      flex-wrap: nowrap;
      gap: 16px;
    }
    .header__nav {
      display: none;
    }
    .header__menu-btn {
      display: grid;
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--white);
    overflow-y: auto;
    overscroll-behavior: contain;
    flex-direction: column;
    opacity: 0;
    transition:
      opacity 140ms ease-out,
      display 140ms allow-discrete,
      overlay 140ms allow-discrete;
  }
  .menu:popover-open {
    display: flex;
    opacity: 1;
    transition-duration: 200ms;
    transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
    }
  }
  @media (min-width: 900px) {
    .menu {
      display: none !important;
    }
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px var(--gutter);
    border-bottom: 1px solid var(--footer-line);
  }
  .menu :global(.menu__logo),
  .menu :global(.menu__logo:hover) {
    color: var(--white);
  }

  .menu__links {
    list-style: none;
    margin: 0;
    padding: 24px var(--gutter) 0;
  }
  .menu__links a {
    display: flex;
    align-items: center;
    min-height: 64px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 40px;
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--white);
    text-decoration: none;
  }
  .menu__links a:hover,
  .menu__links a[aria-current='page'] {
    color: var(--cyan);
  }
  /* The current page in the sheet carries the same wave, static and heavier, under its name. */
  .menu__label {
    position: relative;
    display: inline-block;
  }
  .nav-curve--menu {
    display: none;
    left: 0;
    bottom: -8px;
    width: 100%;
    height: 14px;
    clip-path: none;
    transition: none;
  }
  .nav-curve--menu path {
    stroke-width: 4;
  }
  .menu__links a[aria-current='page'] .nav-curve--menu {
    display: block;
    opacity: 1;
  }
  /* The sheet's one moment: links rise into place, 30 ms apart. Closing is quicker and all at once. */
  .menu__links li {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 120ms ease-out,
      transform 120ms ease-out;
  }
  .menu:popover-open .menu__links li {
    opacity: 1;
    transform: none;
    transition-duration: 260ms;
    transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
  }
  .menu:popover-open .menu__links li:nth-child(1) { transition-delay: 40ms; }
  .menu:popover-open .menu__links li:nth-child(2) { transition-delay: 70ms; }
  .menu:popover-open .menu__links li:nth-child(3) { transition-delay: 100ms; }
  .menu:popover-open .menu__links li:nth-child(4) { transition-delay: 130ms; }
  .menu:popover-open .menu__links li:nth-child(5) { transition-delay: 160ms; }
  @starting-style {
    .menu:popover-open .menu__links li {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .menu__foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px var(--gutter) max(32px, env(safe-area-inset-bottom));
  }
  .menu__foot .btn {
    width: 100%;
  }
  .menu__foot .btn[aria-current='page'] {
    background: var(--white);
  }
  .menu__mail {
    margin: 0;
    font-size: 15px;
    color: var(--footer-text);
  }
  .menu__mail a {
    color: var(--white);
    font-weight: 700;
  }

  /* Browsers without the Popover API keep the wrapped link row instead of the menu. */
  @supports not selector(:popover-open) {
    .header__nav {
      display: flex;
    }
    .header__inner {
      flex-wrap: wrap;
    }
    .header__menu-btn,
    .menu {
      display: none !important;
    }
  }
</style>
