---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import { services } from '../../data/site';
import { cardLine, projects, projectUrl } from '../../data/projects';

// Filtering only helps with two or more projects, and only by services that have a project.
const showFilters = projects.length > 1;
const filters = ['All', ...services.filter((s) => projects.some((p) => p.services.includes(s)))];
const countLabel = (n: number) => (n === 1 ? '1 project' : `${n} projects`);
---

<Base
  title="Work"
  current="/work"
  og="work"
  description="Websites, web apps, stores and other products we designed and built, and what we did for each of them."
>
  <section class="hero">
    <div class="hero__art" aria-hidden="true">
      <svg viewBox="0 0 520 420" preserveAspectRatio="xMinYMid slice" fill="none">
        <defs>
          <linearGradient id="top-a" x1="520" y1="0" x2="80" y2="420" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#5B4FE9"></stop>
            <stop offset="0.5" stop-color="#2F8CF6"></stop>
            <stop offset="1" stop-color="#22D3DD"></stop>
          </linearGradient>
        </defs>
        <path d="M560 -20 C 380 -10, 240 110, 330 220 C 410 320, 300 420, 560 460 Z" fill="#DFF6F9"></path>
        <path
          d="M580 30 C 400 30, 250 130, 350 230 C 430 310, 380 400, 560 440"
          stroke="url(#top-a)"
          stroke-width="72"
          stroke-linecap="round"></path>
      </svg>
    </div>
    <div class="container hero__inner">
      <h1 class="h1 hero__title">Products we <span class="highlight">built.</span></h1>
      <p class="lede hero__lede">Design, engineering and growth work.{showFilters && ' Filter by what we did.'}</p>
    </div>
  </section>

  <section class="bg-paper">
    <div class="container work">
      {
        showFilters && (
          <div class="work__bar">
            <div class="work__filters" role="group" aria-label="Filter by service">
              {filters.map((f) => (
                <button type="button" class="toggle" data-filter={f} aria-pressed={f === 'All' ? 'true' : 'false'}>
                  {f}
                </button>
              ))}
            </div>
            <p class="work__count" aria-live="polite" data-count>
              {countLabel(projects.length)}
            </p>
          </div>
        )
      }
      <div class="work__grid">
        {
          projects.map((p) => {
            const url = projectUrl(p);
            const Card = url ? 'a' : 'article';
            return (
              <Card href={url ?? undefined} class="card work-card" data-services={p.services.join('|')}>
                <div class:list={['shot', `shot--${p.look.tone}`, 'work-card__shot']}>
                  <svg aria-hidden="true" viewBox="0 0 600 240" preserveAspectRatio="xMidYMid slice" fill="none">
                    <path d={p.look.path} stroke={p.look.stroke} stroke-width="60" stroke-linecap="round" />
                  </svg>
                  {p.image && (
                    <Image
                      src={p.image.src}
                      alt={p.image.alt}
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 1240px) 380px, (min-width: 800px) 45vw, 88vw"
                      class="shot__img"
                    />
                  )}
                </div>
                <div class="work-card__body">
                  <span class="tagline">{cardLine(p)}</span>
                  <h2 class="work-card__name">{p.name}</h2>
                  {p.summary && <p class="work-card__summary">{p.summary}</p>}
                  {url ? (
                    <span class="work-card__more">
                      Read the case
                      <Icon name="arrow-right" />
                    </span>
                  ) : (
                    p.site && (
                      <a href={p.site} class="work-card__more" target="_blank" rel="noopener">
                        Visit {new URL(p.site).hostname}
                        <span class="visually-hidden"> (opens in a new tab)</span>
                        <Icon name="arrow-up-right" />
                      </a>
                    )
                  )}
                </div>
              </Card>
            );
          })
        }
      </div>
    </div>
  </section>

  <CtaBand title="Want to be the next one here?" pad="bottom" />
</Base>

<script>
  // Service filters (rendered from two projects up). A processed script, not is:inline, so it is
  // covered by the CSP hashes. A ?service= deep link is applied as soon as the page is parsed.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-services]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const valid = buttons.map((b) => b.dataset.filter ?? '').filter((f) => f && f !== 'All');

  function apply(filter: string, updateUrl: boolean) {
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
    let shown = 0;
    for (const card of cards) {
      const match = filter === 'All' || (card.dataset.services ?? '').split('|').includes(filter);
      card.hidden = !match;
      if (match) shown++;
    }
    if (count) count.textContent = shown === 1 ? '1 project' : `${shown} projects`;
    if (updateUrl) {
      const url = new URL(window.location.href);
      if (filter === 'All') url.searchParams.delete('service');
      else url.searchParams.set('service', filter);
      history.replaceState(history.state, '', url);
    }
  }

  for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.filter ?? 'All', true));
  const initial = new URLSearchParams(window.location.search).get('service');
  if (initial && valid.includes(initial)) apply(initial, false);
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--paper);
  }
  .hero__art {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: max(0px, calc(100% - 860px));
    max-width: 520px;
  }
  .hero__art svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__inner {
    position: relative;
    padding-top: 88px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero__title {
    max-width: 760px;
  }
  .hero__lede {
    max-width: 620px;
  }

  /* ---------- Filter and grid ---------- */
  .work {
    padding-top: 24px;
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .work__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
  }
  .work__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .work__count {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 24px;
  }

  /* ---------- Project card ---------- */
  /* .card sets display:flex, which would override the UA [hidden] rule. */
  .work-card[hidden] {
    display: none;
  }
  /* A 2:1 well keeps the screenshot's sides in view at every width; only the bottom bleeds off. */
  .work-card__shot {
    min-height: 0;
    aspect-ratio: 2 / 1;
  }
  .work-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
  }
  .work-card__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.1;
  }
  .work-card__summary {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .work-card__more {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 700;
    font-size: 15px;
  }
</style>
