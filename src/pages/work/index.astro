---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import RibbonEnd from '../../components/RibbonEnd.astro';
import { Image, getImage } from 'astro:assets';
import { projects, projectUrl, type Project } from '../../data/projects';

// Work is one page: a grid of project tiles, each on its own tint with the real screens in the
// frame that fits the kind (a browser for sites and web apps, phones for apps and bots) and one
// true line in our highlight box. A tile opens the project large, on the same page.
// Work we built for others first, our own products next.
const log = [...projects.filter((p) => !p.own), ...projects.filter((p) => p.own)];
const fan = projects.filter((p) => !p.own && p.image && p.frame.kind === 'browser').slice(0, 3);

const kindSlug = (kind: string) => kind.toLowerCase().replace(/[^a-z0-9]+/g, '-');
/** "Website" to "Websites" for the filter buttons. */
const plural = (kind: string) => (kind.endsWith('s') ? kind : `${kind}s`);
const kinds = [...new Set(log.map((p) => p.kind))].map((kind) => ({ kind, count: log.filter((p) => p.kind === kind).length }));
const kindLine = (p: Project) => (p.own ? `${p.kind} · Our own product` : p.kind);
/** How many columns the last tile takes so the grid ends on a full row: 1 when it already does. */
const lastSpan = (cols: number) => cols - ((log.length - 1) % cols);
const span3 = lastSpan(3) > 1 ? lastSpan(3) : undefined;
const span2 = lastSpan(2) > 1 ? lastSpan(2) : undefined;

/**
 * Phone frames show one screen cut from the screenshot. The crop is set in percentages, so it holds
 * at any frame size: the image is scaled so the screen fills the frame's width, then shifted to it.
 */
const PHONE_RATIO = 19 / 9;
const phoneUrls = new Map<string, string>();
for (const p of log) {
  if (p.frame.kind === 'phones' && p.image) phoneUrls.set(p.slug, (await getImage({ src: p.image.src, width: 1600 })).src);
}
const phoneStyle = (p: Project, screen: { x: number; y: number; width: number }) => {
  const w = p.image?.src.width ?? 1600;
  const h = p.image?.src.height ?? 1000;
  const x = (screen.x / (w - screen.width)) * 100;
  const y = (screen.y / (h - PHONE_RATIO * screen.width)) * 100;
  return `background-image: url(${phoneUrls.get(p.slug)}); background-size: ${((w / screen.width) * 100).toFixed(1)}% auto; background-position: ${x.toFixed(1)}% ${y.toFixed(1)}%`;
};
---

<Base
  title="Work"
  current="/work"
  og="work"
  description="Websites, web apps, stores and other products we designed and built, and what we did for each of them."
>
  <section class="hero container">
    <div class="hero__copy">
      <h1 class="h1 hero__title">Products we <span class="highlight">built.</span></h1>
      <p class="lede hero__lede">Websites, apps and bots, each one real and named. Open one to see it up close.</p>
    </div>
    {
      fan.length === 3 && (
        <div class="fan" aria-hidden="true">
          {fan.map((p) => (
            <div class="browser fan__item">
              <span class="browser__bar">
                <i />
                <i />
                <i />
              </span>
              <span class="browser__shot">
                <Image src={p.image!.src} alt="" widths={[480, 800]} sizes="(min-width: 900px) 330px, 60vw" loading="eager" />
              </span>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <section class="container work" aria-label="Projects" data-work>
    {
      kinds.length > 1 && (
        <div class="filters" role="group" aria-label="Filter by kind">
          <button type="button" class="filter" data-filter="all" aria-pressed="true">
            All<small>{log.length}</small>
          </button>
          {kinds.map(({ kind, count }) => (
            <button type="button" class="filter" data-filter={kindSlug(kind)} aria-pressed="false">
              {plural(kind)}
              <small>{count}</small>
            </button>
          ))}
        </div>
      )
    }

    <ul class="grid" role="list">
      {
        log.map((p, i) => (
          <li
            class="project"
            data-kind={kindSlug(p.kind)}
            data-span3={i === log.length - 1 ? span3 : undefined}
            data-span2={i === log.length - 1 ? span2 : undefined}
          >
            <button type="button" class="project__open" data-open={i} aria-haspopup="dialog" aria-controls="work-open">
              <span class:list={['project__stage', `tint-${p.tint}`]}>
                <svg class="project__ribbon" aria-hidden="true" viewBox="0 0 400 200" preserveAspectRatio="none">
                  <path d="M-20 170 C 80 40, 180 200, 280 90 S 400 10, 440 40" />
                </svg>
                {p.callout && <span class="callout">{p.callout}</span>}
                {p.frame.kind === 'phones' && p.image ? (
                  <span class="phones" aria-hidden="true">
                    {p.frame.screens.map((screen) => (
                      <span class="phone">
                        <span class="phone__screen" style={phoneStyle(p, screen)} />
                      </span>
                    ))}
                  </span>
                ) : (
                  p.image && (
                    <span class="browser" aria-hidden="true">
                      <span class="browser__bar">
                        <i />
                        <i />
                        <i />
                      </span>
                      <span class="browser__shot">
                        <Image src={p.image.src} alt="" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 46vw, 92vw" loading="lazy" />
                      </span>
                    </span>
                  )
                )}
              </span>
              <span class="project__meta">
                <span class="project__name">
                  {p.name}
                </span>
                <span class="project__kind">{kindLine(p)}</span>
                <span class="project__go" aria-hidden="true">
                  <Icon name="arrow-right" />
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  {/* The opened project. One article per project; the script shows the one you opened. */}
  <dialog id="work-open" class="open" data-open-dialog>
    <button type="button" class="open__close" data-open-close aria-label="Close">
      <Icon name="close" size={20} />
    </button>
    {
      log.map((p, i) => {
        const url = projectUrl(p);
        return (
          <article class="open__item" data-item={i} aria-labelledby={`open-title-${i}`} hidden>
            <div class:list={['open__stage', `tint-${p.tint}`]}>
              <svg class="project__ribbon" aria-hidden="true" viewBox="0 0 400 200" preserveAspectRatio="none">
                <path d="M-20 170 C 80 40, 180 200, 280 90 S 400 10, 440 40" />
              </svg>
              {p.frame.kind === 'phones' && p.image ? (
                <span class="phones phones--big" aria-hidden="true">
                  {p.frame.screens.map((screen) => (
                    <span class="phone">
                      <span class="phone__screen" style={phoneStyle(p, screen)} />
                    </span>
                  ))}
                </span>
              ) : (
                p.image && (
                  <span class="browser">
                    <span class="browser__bar">
                      <i />
                      <i />
                      <i />
                    </span>
                    <span class="browser__shot browser__shot--open">
                      <Image src={p.image.src} alt={p.image.alt} widths={[800, 1200, 1600]} sizes="(min-width: 1080px) 940px, 92vw" loading="lazy" />
                    </span>
                  </span>
                )
              )}
            </div>
            <div class="open__body">
              <div>
                <h2 class="open__name" id={`open-title-${i}`}>{p.name}</h2>
                <p class="open__kind">
                  {kindLine(p)}
                </p>
              </div>
              <div>
                {p.summary && <p class="open__text">{p.summary}</p>}
                {(url || p.site) && (
                  <div class="open__links">
                    {url && (
                      <a href={url} class="btn btn--primary">
                        Read the case
                        <Icon name="arrow-right" />
                      </a>
                    )}
                    {p.site && (
                      <a href={p.site} class="btn btn--primary" target="_blank" rel="noopener">
                        Visit {new URL(p.site).hostname}
                        <span class="visually-hidden"> (opens in a new tab)</span>
                        <Icon name="arrow-up-right" />
                      </a>
                    )}
                  </div>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
    <div class="open__nav">
      <button type="button" class="btn btn--outline btn--sm" data-open-step="-1"><Icon name="arrow-left" />Previous</button>
      <button type="button" class="btn btn--outline btn--sm" data-open-step="1">Next<Icon name="arrow-right" /></button>
    </div>
  </dialog>

  <RibbonEnd from="work-end">Want yours up here <span class="highlight">next?</span></RibbonEnd>
</Base>

<script>
  const work = document.querySelector<HTMLElement>('[data-work]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-open-dialog]');
  if (work && dialog) {
    const items = [...dialog.querySelectorAll<HTMLElement>('[data-item]')];
    const tiles = [...work.querySelectorAll<HTMLElement>('.project')];
    let at = 0;
    let opener: HTMLElement | null = null;

    /** Shows project i in the dialog; Previous and Next only step through the tiles in view. */
    const show = (i: number) => {
      at = i;
      items.forEach((item) => (item.hidden = Number(item.dataset.item) !== i));
      dialog.setAttribute('aria-labelledby', `open-title-${i}`);
    };
    const visible = () => tiles.map((tile, i) => (tile.hidden ? -1 : i)).filter((i) => i >= 0);

    work.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-open]');
      if (!button) return;
      opener = button;
      show(Number(button.dataset.open));
      dialog.showModal();
    });
    dialog.querySelectorAll<HTMLButtonElement>('[data-open-step]').forEach((button) =>
      button.addEventListener('click', () => {
        const order = visible();
        const next = order[(order.indexOf(at) + Number(button.dataset.openStep) + order.length) % order.length];
        if (next !== undefined) show(next);
      }),
    );
    dialog.querySelector('[data-open-close]')?.addEventListener('click', () => dialog.close());
    // A click on the dimmed page around the card closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());

    // Filters by kind. A ?kind= link opens the page filtered.
    const buttons = [...work.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const apply = (filter: string, updateUrl: boolean) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      tiles.forEach((tile) => (tile.hidden = !(filter === 'all' || tile.dataset.kind === filter)));
      tiles[0]?.parentElement?.toggleAttribute('data-filtered', filter !== 'all');
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (filter === 'all') url.searchParams.delete('kind');
        else url.searchParams.set('kind', filter);
        history.replaceState(history.state, '', url);
      }
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all', true)));
    const initial = new URLSearchParams(window.location.search).get('kind');
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial, false);
  }
</script>

<style>
  /* ---------- Hero: the title, and three real projects fanned like cards ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: 32px;
    padding-top: 64px;
    padding-bottom: 32px;
  }
  .hero__lede {
    max-width: 30em;
    margin-top: 18px;
  }
  .fan {
    position: relative;
    height: 330px;
  }
  .fan__item {
    position: absolute;
    width: 62%;
    transition: transform 500ms var(--ease-out);
  }
  .fan__item:nth-child(1) {
    left: 2%;
    top: 48px;
    transform: rotate(-7deg);
  }
  .fan__item:nth-child(2) {
    left: 36%;
    top: 96px;
    transform: rotate(6deg);
  }
  .fan__item:nth-child(3) {
    left: 18%;
    top: 4px;
    z-index: 2;
    transform: rotate(-1deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .fan:hover .fan__item:nth-child(1) {
      transform: rotate(-10deg) translate(-14px, 6px);
    }
    .fan:hover .fan__item:nth-child(2) {
      transform: rotate(9deg) translate(14px, 6px);
    }
  }

  /* ---------- Frames ---------- */
  .browser {
    display: block;
    overflow: hidden;
    border-radius: 12px;
    background: var(--surface);
    box-shadow:
      0 24px 44px -24px rgb(10 17 40 / 0.55),
      0 0 0 1px rgb(10 17 40 / 0.06);
  }
  .browser__bar {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 22px;
    padding: 0 10px;
    border-bottom: 1px solid var(--line-soft);
  }
  .browser__bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }
  .browser__shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .browser__shot :global(img) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 1600ms var(--ease-out);
  }
  .phones {
    display: flex;
    justify-content: center;
    align-self: end;
    width: 100%;
  }
  .phone {
    display: block;
    width: 46%;
    max-width: 190px;
    aspect-ratio: 9 / 19;
    overflow: hidden;
    border: 6px solid var(--ink);
    border-radius: 30px;
    background: var(--surface);
    box-shadow: 0 24px 44px -24px rgb(10 17 40 / 0.55);
    transition: transform 500ms var(--ease-out);
  }
  .phone__screen {
    display: block;
    width: 100%;
    height: 100%;
    background-repeat: no-repeat;
  }

  /* ---------- Filters, with real counts ---------- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0 28px;
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px 0 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: 600 15px/1 var(--font-body);
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out),
      border-color 160ms var(--ease-out),
      color 160ms var(--ease-out);
  }
  .filter small {
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
  }
  .filter:hover {
    border-color: var(--ink);
  }
  .filter[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }
  .filter[aria-pressed='true'] small {
    color: #b9c4dd;
  }

  /* ---------- The tiles ---------- */
  .work {
    padding-bottom: 24px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 22px;
  }
  .project {
    container-type: inline-size;
  }
  .project[hidden] {
    display: none;
  }
  .project__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-tile);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .project__stage,
  .open__stage {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .project__stage {
    aspect-ratio: var(--stage-ratio, 1 / 0.86);
    height: var(--stage-h, auto);
    padding: 66px 24px 0;
    border-radius: var(--radius-tile);
  }
  .project__stage::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(10 17 40 / 0.05);
    pointer-events: none;
  }
  .tint-cyan {
    background: linear-gradient(160deg, #e3f8fb 0%, #bdeef5 100%);
  }
  .tint-blue {
    background: linear-gradient(160deg, #e8f0ff 0%, #c6d9ff 100%);
  }
  .tint-violet {
    background: linear-gradient(160deg, #efecfe 0%, #d6cefb 100%);
  }
  .tint-ink {
    background: linear-gradient(160deg, #1b2547 0%, #0a1128 100%);
  }
  /* A ribbon from the hero runs behind every frame. */
  .project__ribbon {
    position: absolute;
    inset: auto -10% -18% -10%;
    z-index: -1;
    width: 120%;
    height: 70%;
  }
  .project__ribbon path {
    fill: none;
    stroke: var(--white);
    stroke-opacity: 0.75;
    stroke-width: 46;
    stroke-linecap: round;
  }
  .tint-ink .project__ribbon path {
    stroke: #2f8cf6;
    stroke-opacity: 0.35;
  }
  .project__stage .browser {
    width: var(--browser-w, 100%);
    align-self: end;
    border-radius: 12px 12px 0 0;
    transform: translateY(18px);
    transition: transform 500ms var(--ease-out);
  }
  .project__stage .phone {
    width: var(--phone-w, 46%);
    align-self: end;
    transform: translateY(26px);
  }
  .project__stage .phone + .phone {
    margin-left: var(--phone-gap, -14%);
    transform: translateY(var(--phone-drop, 46px)) rotate(var(--phone-tilt, 5deg));
  }
  .project__stage .phone:nth-child(n + 3) {
    display: var(--phone-more, none);
  }
  /*
   * The grid never ends on a lone tile or a gap: the last tile takes the rest of its row (data-span3
   * at three columns, data-span2 at two), at the height of the others, and shows more of the
   * project: every phone screen, a wider page. --col is one column; cqw is the tile's own width.
   * Not while a filter is on.
   */
  @media (min-width: 1024px) {
    .grid:not([data-filtered]) [data-span3='3'] {
      grid-column: 1 / -1;
      --col: calc((100cqw - 44px) / 3);
    }
    .grid:not([data-filtered]) [data-span3='2'] {
      grid-column: span 2;
      --col: calc((100cqw - 22px) / 2);
    }
    .grid:not([data-filtered]) [data-span3] {
      --stage-ratio: auto;
      --stage-h: calc(0.86 * var(--col));
      --browser-w: calc(1.7 * var(--col));
      --phone-w: calc(0.46 * (var(--col) - 48px));
      --phone-gap: 5%;
      --phone-drop: 26px;
      --phone-tilt: 0deg;
      --phone-more: block;
    }
  }
  @media (min-width: 640px) and (max-width: 1023.98px) {
    .grid:not([data-filtered]) [data-span2] {
      grid-column: 1 / -1;
      --col: calc((100cqw - 22px) / 2);
      --stage-ratio: auto;
      --stage-h: calc(0.86 * var(--col));
      --browser-w: calc(1.7 * var(--col));
      --phone-w: calc(0.46 * (var(--col) - 48px));
      --phone-gap: 5%;
      --phone-drop: 26px;
      --phone-tilt: 0deg;
      --phone-more: block;
    }
  }
  /* The one thing worth knowing, in our highlight box. */
  .callout {
    position: absolute;
    left: 22px;
    top: 20px;
    z-index: 3;
    max-width: calc(100% - 44px);
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--teal);
    color: var(--white);
    font: 700 15px/1.3 var(--font-display);
    transform: rotate(-2deg);
    transform-origin: left;
    box-shadow: 0 6px 14px -8px rgb(8 159 179 / 0.7);
  }
  .tint-ink .callout {
    background: var(--cyan);
    color: var(--ink);
  }
  .project__meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2px 16px;
    padding: 16px 6px 0;
  }
  .project__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .project__kind {
    grid-column: 1;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .project__go {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out),
      transform 300ms var(--ease-out);
  }
  .project__open:focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 4px;
  }
  @media (hover: hover) and (pointer: fine) {
    .project__open:hover .project__stage .browser {
      transform: translateY(6px);
    }
    .project__open:hover .browser__shot :global(img) {
      transform: translateY(-8%);
    }
    .project__open:hover .project__stage .phone {
      transform: translateY(14px);
    }
    .project__open:hover .project__go {
      background: var(--ink);
      color: var(--white);
      transform: rotate(-45deg);
    }
  }

  /* ---------- The opened project ---------- */
  .open {
    width: min(1040px, calc(100% - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: var(--radius-tile);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 40px 90px -40px rgb(10 17 40 / 0.6);
    overflow: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transition:
      opacity 260ms var(--ease-out),
      transform 360ms var(--ease-out),
      display 360ms allow-discrete,
      overlay 360ms allow-discrete;
  }
  .open[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .open[open] {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }
  .open::backdrop {
    background: rgb(10 17 40 / 0.45);
  }
  .open__close {
    position: sticky;
    top: 14px;
    z-index: 5;
    float: right;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 14px 14px -58px 0;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 4px 12px -6px rgb(10 17 40 / 0.4);
    cursor: pointer;
  }
  .open__item[hidden] {
    display: none;
  }
  .open__stage {
    padding: 56px 56px 0;
  }
  .open__stage .browser {
    width: 100%;
    border-radius: 14px 14px 0 0;
  }
  .phones--big .phone {
    width: 30%;
    max-width: 230px;
    transform: translateY(20px);
