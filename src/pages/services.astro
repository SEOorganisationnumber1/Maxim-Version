---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { type PlanName, type Service } from '../data/site';
import { offersFor, offerUrl } from '../data/offers';

type ServiceBlock = { name: Service; description: string; deliverables: string[] };
type StackRow = { label: string; tools: string[] };
type Plan = { name: PlanName; summary: string; period: string; featured: boolean; items: string[] };
type Faq = { question: string; answer: string };
type Term = { title: string; text: string };

const jumpLinks = [
  { href: '#services', label: 'What we do' },
  { href: '#stack', label: 'Stack & tools' },
  { href: '#plans', label: 'Plans' },
  { href: '#terms', label: 'Terms' },
  { href: '#faq', label: 'FAQ' },
];

// How every project works, approved by the owner on 2026-10-16. These are promises the studio
// keeps: change them here first if the way of working changes.
const terms: Term[] = [
  {
    title: 'Free estimate',
    text: 'Book a call or send a brief, and within two business days you get our approach and a fixed price in writing. It costs nothing.',
  },
  {
    title: 'Fixed price, written scope',
    text: 'The price is fixed for the scope we agree in writing. Anything new gets its own price and timeline, and you approve it before we start.',
  },
  {
    title: 'Pay in stages',
    text: '50% to start and 50% at launch. Larger projects pay in three stages: 30% to start, 40% when the design is approved and 30% at launch.',
  },
  {
    title: 'You own everything',
    text: 'Code, design files and accounts are yours once the final payment is made. Domain, hosting and app store accounts are in your name from day one.',
  },
  { title: 'Two rounds of design changes', text: 'Two rounds of changes on the design are included in the price.' },
  { title: '30 days of free fixes', text: 'For 30 days after launch, we fix any bug in what we built, free.' },
  {
    title: 'Support if you want it',
    text: "Monthly care for websites and apps, optional. Cancel any time with 30 days' notice.",
  },
  {
    title: 'No hidden costs',
    text: 'Hosting, domains, AI and API usage and app store fees are paid by you directly, at cost.',
  },
  {
    title: 'SEO month to month',
    text: "No long contract: cancel with 30 days' notice. Nobody can guarantee rankings, so we don't.",
  },
];

// One block per kind of project. UI and UX design is in every one of them, so it has no block of its own.
const serviceBlocks: ServiceBlock[] = [
  {
    name: 'Websites & Landing Pages',
    description:
      'Company websites, landing pages and blogs on modern frameworks. Server-rendered and fast by default. Core Web Vitals are a build requirement, not an afterthought.',
    deliverables: [
      'Design of every page, for desktop and mobile',
      'Company sites, landing pages and blogs',
      'A headless CMS your team can edit',
      'Analytics, tracking and SEO foundations built in',
    ],
  },
  {
    name: 'Web Apps & SaaS',
    description:
      'Custom web applications and SaaS products, from the first version to scale. Full-stack and typed end to end, with the unglamorous parts done properly.',
    deliverables: [
      'MVPs and new SaaS products',
      'Internal tools, portals and dashboards',
      'Accounts, roles, payments and integrations',
      'Tests, CI/CD and monitoring from day one',
    ],
  },
  {
    name: 'Mobile & Desktop Apps',
    description:
      'Mobile apps for iOS and Android and desktop apps for Windows, macOS and Linux, designed and built from the first version to release.',
    deliverables: [
      'Interface design for every screen',
      'iOS and Android apps',
      'Desktop apps for Windows, macOS and Linux',
      'Help with publishing to the App Store and Google Play',
    ],
  },
  {
    name: 'Telegram Bots & Extensions',
    description:
      'Telegram bots and Mini Apps that take orders, answer customers or run a workflow inside the chat, and browser extensions that add a feature where your users already work.',
    deliverables: [
      'Telegram bots with commands, menus and payments',
      'Telegram Mini Apps',
      'Extensions for Chrome, Firefox and Edge',
      'The admin panel, database and integrations behind them',
    ],
  },
  {
    name: 'AI & Automation',
    description:
      'AI features that do real work inside your product or your operations, built on your own data and measured like any other feature.',
    deliverables: [
      'Assistants and copilots inside your product',
      'Search and answers over your own data',
      'Workflow automation that removes manual steps',
      'Evaluation, guardrails and cost control',
    ],
  },
  {
    name: 'Search & Growth',
    description:
      'SEO, GEO and AEO, so what we launch gets found: in Google, in AI Overviews and in answers from ChatGPT, Gemini and Perplexity.',
    deliverables: [
      'Technical SEO audit and fixes',
      'Search-intent and question research',
      'Structured data and an llms.txt file',
      'A monthly report on rankings, AI citations and leads',
    ],
  },
];

const stack: StackRow[] = [
  { label: 'Design', tools: ['Figma', 'Design tokens', 'Component libraries'] },
  {
    label: 'Build',
    tools: ['Next.js', 'Astro', 'TypeScript', 'Tailwind CSS', 'Headless CMS'],
  },
  {
    label: 'AI',
    tools: ['LLM APIs', 'Retrieval over your data', 'Agents and automation', 'Evaluation'],
  },
  {
    label: 'Growth',
    tools: ['Google Search Console', 'Ahrefs', 'Schema.org markup', 'llms.txt', 'Citation tracking: ChatGPT, Gemini, Perplexity'],
  },
  { label: 'Measure', tools: ['GA4', 'Looker Studio', 'Form and call tracking'] },
];

const plans: Plan[] = [
  {
    name: 'Launch',
    summary: 'Design and build. A new website or product, ready on launch day.',
    period: 'One project',
    featured: false,
    items: [
      'Product and UI design in Figma',
      'Built on a modern, typed stack',
      'Launch-ready: SEO foundations, structured data, Core Web Vitals',
      'Analytics and conversion tracking set up',
      'Handover and training for your team',
    ],
  },
  {
    name: 'Growth',
    summary: 'SEO, GEO and AEO, run every month on the product you have.',
    period: 'Month to month',
    featured: true,
    items: [
      'Technical SEO audit and fixes',
      'Search-intent content plan and production',
      'GEO: structured, citable content for AI engines',
      'AEO: snippet and AI Overview targeting',
      'Monthly report on rankings, citations and leads',
    ],
  },
  {
    name: 'Full stack',
    summary: 'Everything, as one ongoing product team for design, code, AI and growth.',
    period: 'Month to month',
    featured: false,
    items: [
      'Everything in Launch and Growth',
      'Ongoing design and engineering',
      'AI features and automation',
      'A shared roadmap, reviewed every month',
      'Priority support',
    ],
  },
];

const faqs: Faq[] = [
  {
    question: 'What do you build?',
    answer:
      'Websites and landing pages, web apps and SaaS, mobile and desktop apps, Telegram bots and Mini Apps, browser extensions and AI features, plus the search work that gets them found. Design is part of every project, and one team covers design, engineering and growth.',
  },
  {
    question: 'How long does a project take?',
    answer:
      'It depends on the scope. A landing page takes weeks; a first version of a web app or SaaS product usually takes a few months. You get a timeline with the proposal, and we report progress as we go.',
  },
  {
    question: 'Do we need a full specification to start?',
    answer:
      'No. We start with a short discovery and scope the smallest version worth launching. Clear goals matter more than a long document.',
  },
  {
    question: 'What is the difference between SEO, GEO and AEO?',
    answer:
      'SEO gets your pages ranked in classic search results. AEO shapes your content so a search engine can lift a direct answer from it: featured snippets, AI Overviews, voice. GEO makes your brand readable and citable for generative engines such as ChatGPT, Gemini and Perplexity. All three share one foundation: a fast, well-structured site with content people actually want.',
  },
  {
    question: 'Can you work with our in-house team?',
    answer:
      'Yes. We can own the whole project, or plug into your designers, developers or content team and cover only the gaps.',
  },
  {
    question: 'What happens after we book a call?',
    answer:
      'On a free 30-minute call we go through what you want to launch and what you have so far. Within two business days after it you get our approach and a fixed price in writing, free. If it fits, we confirm the scope together and start.',
  },
  {
    question: 'How much does a project cost?',
    answer:
      'It depends on what you need, so every project is priced on its own. After a free 30-minute call you get a fixed price for a written scope within two business days, before you commit to anything.',
  },
  {
    question: 'How do payments work?',
    answer:
      '50% to start and 50% at launch. Larger projects pay in three stages: 30% to start, 40% when the design is approved and 30% at launch.',
  },
  {
    question: 'Who owns the code and the design?',
    answer:
      'You do. Code, design files and accounts are yours once the final payment is made, and the domain, hosting and app store accounts are in your name from day one.',
  },
  {
    question: 'Do you guarantee rankings or AI citations?',
    answer:
      'No. Nobody controls how Google or AI assistants rank and cite pages, so we do not promise positions. We promise the work: technical fixes, structured content and a monthly report on rankings, citations and leads.',
  },
];

const faqPageJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<Base
  title="Services"
  current="/services"
  og="services"
  description="Websites, web apps and SaaS, mobile and desktop apps, Telegram bots and browser extensions, AI and automation, and search-led growth. One team designs, builds and grows your product."
  jsonLd={[faqPageJsonLd]}
>
  <section class="hero bg-paper">
    <div class="hero__art" aria-hidden="true">
      <svg viewBox="0 0 480 460" preserveAspectRatio="xMinYMid slice" fill="none">
        <defs>
          <linearGradient
            id="top-a"
            x1="480"
            y1="0"
            x2="60"
            y2="460"
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0" stop-color="#22D3DD"></stop>
            <stop offset="0.5" stop-color="#2F8CF6"></stop>
            <stop offset="1" stop-color="#5B4FE9"></stop>
          </linearGradient>
        </defs>
        <path d="M520 -20 C 340 0, 200 120, 300 230 C 380 320, 280 440, 520 500 Z" fill="#E4EEFF"
        ></path>
        <path
          d="M540 40 C 360 40, 220 140, 320 240 C 400 320, 330 420, 540 480"
          stroke="url(#top-a)"
          stroke-width="72"
          stroke-linecap="round"></path>
      </svg>
    </div>
    <div class="container hero__inner">
      <h1 class="h1 hero__title">
        Design, code and growth. <span class="highlight">Built as one.</span>
      </h1>
      <p class="lede hero__lede">
        One team designs your product, engineers it, launches it and helps it grow. No handoffs
        between agencies, no lost context.
      </p>
      <nav aria-label="On this page" class="jump">
        {
          jumpLinks.map((link) => (
            <a href={link.href} class="jump__link">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section id="services" class="anchor bg-paper">
    <div class="container services__inner">
      {
        serviceBlocks.map((service) => (
          <article class="service anchor" id={service.name.toLowerCase().replace(/&/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}>
            <div class="service__col">
              <h2 class="service__title">{service.name}</h2>
              <p class="service__text">{service.description}</p>
            </div>
            <div class="service__col">
              <h3 class="service__label">What you get</h3>
              <ul class="service__list">
                {service.deliverables.map((item) => (
                  <li>
                    <Icon name="check" size={16} strokeWidth={2.6} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            {offersFor(service.name).length > 0 && (
              <ul class="service__pages" aria-label={`More on ${service.name}`}>
                {offersFor(service.name).map((offer) => (
                  <li>
                    <a href={offerUrl(offer)} class="service__page">
                      {offer.name}
                      <Icon name="arrow-right" size={16} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section id="stack" class="anchor bg-paper">
    <div class="container stack__inner">
      <div class="section-head">
        <h2 class="h2">A modern stack, chosen for speed.</h2>
        <p class="section-head__text">
          Every tool here earns its place by saving time or improving results. When something
          better appears, we switch.
        </p>
      </div>
      <dl class="stack">
        {
          stack.map((row) => (
            <div class="stack__row">
              <dt class="stack__label">{row.label}</dt>
              <dd class="stack__tools">
                {row.tools.map((tool) => (
                  <>
                    <span class="chip">{tool}</span>{'\n'}
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="plans" class="anchor bg-paper">
    <div class="container pricing__inner">
      <div class="section-head">
        <h2 class="h2">Three ways to work with us.</h2>
      </div>
      <div class="plans">
        {
          plans.map((plan) => (
            <div class:list={['plan', { 'plan--featured': plan.featured }]}>
              <div class="plan__head">
                <h3 class="plan__name">{plan.name}</h3>
                <p class="plan__summary">{plan.summary}</p>
              </div>
              <p class="plan__period">{plan.period}</p>
              <ul class="plan__list">
                {plan.items.map((item) => (
                  <li>
                    <Icon name="check" size={16} strokeWidth={2.6} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <a
                href="/contact"
                class:list={['btn', 'btn--sm', 'plan__cta', plan.featured ? 'btn--primary' : 'btn--outline']}
                data-book-call
                data-book-from={`plan-${plan.name}`}
              >
                Ask about {plan.name}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="terms" class="anchor bg-paper">
    <div class="container terms__inner">
      <div class="section-head">
        <h2 class="h2">Clear terms. No surprises.</h2>
        <p class="section-head__text">How every project works, before you sign anything.</p>
      </div>
      <dl class="terms">
        {
          terms.map((term) => (
            <div class="terms__row">
              <dt class="terms__title">{term.title}</dt>
              <dd class="terms__text">{term.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="faq" class="anchor bg-paper">
    <div class="container faq__inner">
      <div class="section-head section-head--wide">
        <h2 class="h2">Questions we hear first.</h2>
      </div>
      <div class="faq">
        {
          faqs.map((faq, i) => (
            <details name="faq" class="faq__item" open={i === 0}>
              <summary class="faq__summary">
                <h3 class="faq__question">{faq.question}</h3>
                <Icon name="plus" size={24} strokeWidth={2.4} />
              </summary>
              <p class="faq__answer">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Not sure which one fits?"
    text="Tell us where you are. We will point you to the smallest scope that gets results."
    pad="bottom"
  />
</Base>

<style>
  /* Anchored sections: keep the top edge off the viewport edge after a jump. */
  .anchor {
    scroll-margin-top: 16px;
  }

  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero__art {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: max(0px, calc(100% - 900px));
    max-width: 480px;
  }
  .hero__art svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__inner {
    position: relative;
    padding-top: 88px;
    padding-bottom: 56px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero__title {
    max-width: 820px;
  }
  .hero__lede {
    max-width: 640px;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 8px;
  }
  .jump__link {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition:
      border-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .jump__link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .jump__link:active {
    transform: scale(0.97);
  }

  /* ---------- Shared: section heads and tiles ---------- */

  .section-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 760px;
  }
  .section-head--wide {
    max-width: none;
  }
  .section-head__text {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .services__inner,
  .stack__inner,
  .pricing__inner,
  .terms__inner,
  .faq__inner {
    padding-top: 64px;
    padding-bottom: 64px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .service,
  .stack,
  .plan,
  .terms,
  .faq {
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-tile);
  }
  .checks-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
    line-height: 1.5;
  }
  .checks-list li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 12px;
  }
  .checks-list :global(svg) {
    margin-top: 4px;
    color: var(--teal);
  }

  /* ---------- Services: a tile each, two to a row ---------- */

  .services__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr));
    gap: 14px;
    padding-top: 16px;
  }
  .service {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(24px, 3vw, 36px);
  }
  .service__col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .service__col + .service__col {
    padding-top: 20px;
    border-top: 1px solid var(--line-soft);
  }
  .service__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 2.6vw, 2.3rem);
    line-height: 1.08;
  }
  .service__text {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .service__label {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--muted);
  }
  .service__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
    line-height: 1.5;
  }
  .service__list li,
  .plan__list li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 12px;
  }
  .service__list :global(svg),
  .plan__list :global(svg) {
    margin-top: 4px;
    color: var(--teal);
  }
  /* Links to the offer pages of a block (src/data/offers.ts), at the foot of its tile. */
  .service__pages {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .service__page {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition:
      border-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .service__page:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .service__page:active {
    transform: scale(0.97);
  }
  .service__page :global(svg) {
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .service__page:hover :global(svg) {
      transform: translateX(3px);
    }
  }

  /* ---------- Stack ---------- */

  .stack {
    margin: 0;
    padding: 6px clamp(20px, 3vw, 36px);
  }
  .stack__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 32px;
    padding: 18px 0;
  }
  .stack__row + .stack__row {
    border-top: 1px solid var(--line-soft);
  }
  .stack__label {
    flex: 0 0 180px;
    font-size: 16px;
    font-weight: 700;
  }
  .stack__tools {
    flex: 1 1 320px;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* ---------- Plans ---------- */

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 14px;
    align-items: stretch;
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px;
  }
  .plan--featured {
    border-color: var(--teal);
    box-shadow: 0 0 0 1px var(--teal), var(--shadow-tile);
  }
  .plan__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .plan__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.1;
  }
  .plan__summary {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .plan__period {
    align-self: flex-start;
    margin: 0;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--paper);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-2);
  }
  .plan__list {
    flex: 1 1 auto;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
    line-height: 1.5;
  }
  .plan__cta {
    align-self: flex-start;
  }

  /* ---------- Terms ---------- */

  .terms {
    margin: 0;
    padding: 6px clamp(20px, 3vw, 36px);
  }
  .terms__row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 40px;
    padding: 20px 0;
  }
  .terms__row + .terms__row {
    border-top: 1px solid var(--line-soft);
  }
  .terms__title {
    flex: 1 1 260px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
  }
  .terms__text {
    flex: 2 1 380px;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
