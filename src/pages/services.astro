---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Agreement from '../components/Agreement.astro';
import RibbonEnd from '../components/RibbonEnd.astro';
import ServiceDemo, { type DemoKind } from '../components/ServiceDemo.astro';
import { Image } from 'astro:assets';
import { type Service } from '../data/site';
import { offersFor, offerUrl } from '../data/offers';
import { projects, type Tint } from '../data/projects';
import { keyTerms, termsUrl } from '../data/terms';

type ServiceBlock = {
  name: Service;
  /** What it gets you, in a few plain words, under the tile's name (as on Home's bench). */
  line: string;
  /** One true promise in the teal box on the tile. */
  callout: string;
  tint: Tint;
  demo: DemoKind;
  description: string;
  deliverables: string[];
  /** The tools behind it, in one line. */
  tools: string;
  /** The verb for its Book a call button: "Book a call about a site". */
  about: string;
};
type Faq = { question: string; answer: string };

// One tile per kind of project. UI and UX design is in every one of them, so it has no tile of its own.
const serviceBlocks: ServiceBlock[] = [
  {
    name: 'Websites & Landing Pages',
    line: 'Fast sites that work on every screen.',
    callout: 'Fast on every screen',
    tint: 'cyan',
    demo: 'web',
    description: 'Company websites, landing pages and blogs that load fast and bring in customers, on every screen.',
    deliverables: [
      'Design of every page, for desktop and mobile',
      'Company sites, landing pages and blogs',
      'A content editor your team can use',
      'Analytics, tracking and SEO foundations built in',
    ],
    tools: 'Figma, Astro, Next.js, a headless CMS',
    about: 'a site',
  },
  {
    name: 'Web Apps & SaaS',
    line: 'Order systems, bookings and dashboards.',
    callout: 'Orders, bookings, dashboards',
    tint: 'blue',
    demo: 'app',
    description: 'Custom web applications and SaaS products, from the first version to scale, with the unglamorous parts done properly.',
    deliverables: [
      'MVPs and new SaaS products',
      'Internal tools, portals and dashboards',
      'Accounts, roles, payments and integrations',
      'Tests and monitoring from day one',
    ],
    tools: 'Next.js, TypeScript, Supabase',
    about: 'a web app',
  },
  {
    name: 'Mobile & Desktop Apps',
    line: 'Apps for iPhone, Android, Mac and Windows.',
    callout: 'iPhone, Android, Mac, Windows',
    tint: 'violet',
    demo: 'phone',
    description:
      'Mobile apps for iOS and Android and desktop apps for Windows, macOS and Linux, designed and built from the first version to release.',
    deliverables: [
      'Interface design for every screen',
      'iOS and Android apps',
      'Desktop apps for Windows, macOS and Linux',
      'Help with publishing to the App Store and Google Play',
    ],
    tools: 'Figma, React Native, Electron',
    about: 'an app',
  },
  {
    name: 'Telegram Bots & Extensions',
    line: 'Bots that take orders and answer customers.',
    callout: 'Orders paid inside the chat',
    tint: 'ink',
    demo: 'bot',
    description:
      'Telegram bots and Mini Apps that take orders, answer customers or run a workflow inside the chat, and browser extensions that add a feature where your users already work.',
    deliverables: [
      'Telegram bots with commands, menus and payments',
      'Telegram Mini Apps',
      'Extensions for Chrome, Firefox and Edge',
      'The admin panel, database and integrations behind them',
    ],
    tools: 'Telegram Bot API, TypeScript, Supabase',
    about: 'a bot',
  },
  {
    name: 'AI & Automation',
    line: 'Routine replies drafted for you to approve.',
    callout: 'Replies drafted, you approve',
    tint: 'cyan',
    demo: 'ai',
    description:
      'AI features that do real work inside your product or your operations, built on your own data and checked like any other feature.',
    deliverables: [
      'Assistants inside your product',
      'Search and answers over your own data',
      'Automation that removes manual steps',
      'Checks, limits and cost control',
    ],
    tools: 'LLM APIs, retrieval over your data, evaluation',
    about: 'AI',
  },
  {
    name: 'Search & Growth',
    line: 'Get found on Google and in ChatGPT.',
    callout: 'Found on Google and in ChatGPT',
    tint: 'blue',
    demo: 'seo',
    description:
      'We make what we launch easy to find: in Google (SEO), in Google’s AI answers (AEO), and in answers from ChatGPT, Gemini and Perplexity (GEO).',
    deliverables: [
      'A technical audit, and the fixes',
      'Research into what your customers search and ask',
      'Structured data and an llms.txt file',
      'A monthly report on rankings, AI citations and leads',
    ],
    tools: 'Google Search Console, Ahrefs, GA4',
    about: 'search',
  },
];

/** The anchor each service keeps, so links from Home, the footer and elsewhere land on its tile. */
const anchor = (name: string) =>
  name
    .toLowerCase()
    .replace(/&/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const kindSlug = (kind: string) => kind.toLowerCase().replace(/[^a-z0-9]+/g, '-');
/** Real projects that used this service, with a screenshot, our own product last. */
const builtWith = (service: Service) =>
  projects
    .filter((p) => p.services.includes(service) && p.image)
    .sort((a, b) => Number(a.own) - Number(b.own))
    .slice(0, 3);

// The questions that add something the terms and tiles do not already say.
const faqs: Faq[] = [
  {
    question: 'How long does a project take?',
    answer:
      'It depends on the scope. A landing page takes weeks; a first version of a web app or SaaS product usually takes a few months. You get a timeline with the proposal, and we report progress as we go.',
  },
  {
    question: 'How much does a project cost?',
    answer:
      'It depends on what you need, so every project is priced on its own. After a free 30-minute call you get a fixed price for a written scope within two business days, before you commit to anything.',
  },
  {
    question: 'Do we need a full specification to start?',
    answer:
      'No. We start with a short discovery and scope the smallest version worth launching. Clear goals matter more than a long document.',
  },
  {
    question: 'What is the difference between SEO, GEO and AEO?',
    answer:
      'SEO gets your pages ranked in classic search results. AEO shapes your content so a search engine can lift a direct answer from it: featured snippets, AI Overviews, voice. GEO makes your brand readable and citable for generative engines such as ChatGPT, Gemini and Perplexity. All three share one foundation: a fast, well-structured site with content people actually want.',
  },
  {
    question: 'Can you work with our in-house team?',
    answer:
      'Yes. We can own the whole project, or plug into your designers, developers or content team and cover only the gaps.',
  },
  {
    question: 'Do you guarantee rankings or AI citations?',
    answer:
      'No. Nobody controls how Google or AI assistants rank and cite pages, so we do not promise positions. We promise the work: technical fixes, structured content and a monthly report on rankings, citations and leads.',
  },
];

const faqPageJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<Base
  title="Services"
  current="/services"
  og="services"
  description="Websites, web apps and SaaS, mobile and desktop apps, Telegram bots and browser extensions, AI and automation, and search-led growth. One team designs, builds and grows your product."
  jsonLd={[faqPageJsonLd]}
>
  <section class="hero container">
    <h1 class="h1 hero__title">Design, code and growth. <span class="highlight">Built as one.</span></h1>
    <p class="lede hero__lede">
      One team designs your product, builds it, launches it and helps it grow. Open a service to see what you get.
    </p>
  </section>

  <!-- Six services: each shown in its own frame, opened large on the same page -->
  <section class="container" aria-label="What we build" data-services>
    <ul class="grid" role="list">
      {
        serviceBlocks.map((service, i) => (
          <li class="tile">
            <button
              type="button"
              class="tile__open"
              id={anchor(service.name)}
              data-open={i}
              aria-haspopup="dialog"
              aria-controls="service-open"
            >
              <span class:list={['stage', `tint-${service.tint}`]}>
                <svg class="ribbon" aria-hidden="true" viewBox="0 0 400 200" preserveAspectRatio="none">
                  <path d="M-20 170 C 80 40, 180 200, 280 90 S 400 10, 440 40" />
                </svg>
                <span class="callout">{service.callout}</span>
                <span class="tile__demo">
                  <ServiceDemo kind={service.demo} />
                </span>
              </span>
              <span class="tile__meta">
                <span class="tile__name">{service.name}</span>
                <span class="tile__line">{service.line}</span>
                <span class="tile__go" aria-hidden="true">
                  <Icon name="arrow-right" />
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  {/* The opened service. One article per service; the script shows the one you opened. */}
  <dialog id="service-open" class="open" data-open-dialog>
    <button type="button" class="open__close" data-open-close aria-label="Close">
      <Icon name="close" size={20} />
    </button>
    {
      serviceBlocks.map((service, i) => {
        const pages = offersFor(service.name);
        const built = builtWith(service.name);
        return (
          <article class="open__item" data-item={i} aria-labelledby={`service-title-${i}`} hidden>
            <div class:list={['stage', 'open__stage', `tint-${service.tint}`]}>
              <svg class="ribbon" aria-hidden="true" viewBox="0 0 400 200" preserveAspectRatio="none">
                <path d="M-20 170 C 80 40, 180 200, 280 90 S 400 10, 440 40" />
              </svg>
              <span class="open__demo">
                <ServiceDemo kind={service.demo} large />
              </span>
            </div>
            <div class="open__body">
              <div>
                <h2 class="open__name" id={`service-title-${i}`}>
                  {service.name}
                </h2>
                <p class="open__text">{service.description}</p>
                {pages.length > 0 && (
                  <ul class="open__pages" aria-label={`More on ${service.name}`}>
                    {pages.map((offer) => (
                      <li>
                        <a href={offerUrl(offer)}>
                          {offer.name}
                          <Icon name="arrow-right" size={16} />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                {built.length > 0 && (
                  <>
                    <p class="open__label open__label--built">Built like this</p>
                    <ul class="built">
                      {built.map((p) => (
                        <li>
                          <a href={`/work?kind=${kindSlug(p.kind)}`}>
                            <Image src={p.image!.src} alt="" widths={[240, 480]} sizes="160px" loading="lazy" />
                            <span>{p.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
              <div>
                <h3 class="open__label">What you get</h3>
                <ul class="gets">
                  {service.deliverables.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <p class="tools">Tools: {service.tools}</p>
              </div>
            </div>
            <div class="open__foot">
              <a
                href="/contact"
                class="btn btn--primary"
                data-book-call
                data-book-need={service.name}
                data-umami-event="Book a call"
                data-umami-event-from={`services-${anchor(service.name)}`}
              >
                Book a call about {service.about}
                <Icon name="arrow-right" />
              </a>
            </div>
          </article>
        );
      })
    }
    <div class="open__nav">
      <button type="button" class="btn btn--outline btn--sm" data-open-step="-1">
        <Icon name="arrow-left" />Previous
      </button>
      <button type="button" class="btn btn--outline btn--sm" data-open-step="1">
        Next<Icon name="arrow-right" />
      </button>
    </div>
  </dialog>

  <!-- Terms: the four that matter most; the full agreement lives on How we work -->
  <section id="terms" class="anchor" aria-labelledby="terms-title">
    <div class="container terms">
      <div class="terms__side">
        <h2 class="h2" id="terms-title">What you get in <span class="highlight">writing.</span></h2>
        <p class="terms__intro">How every project works, before you sign anything.</p>
        <a href={termsUrl} class="text-link see-all">All terms<Icon name="arrow-right" /></a>
      </div>
      <Agreement terms={keyTerms} />
    </div>
  </section>

  <section id="faq" class="anchor" aria-labelledby="faq-title">
    <div class="container faq">
      <div>
        <h2 class="h2" id="faq-title">Questions we hear <span class="highlight">first.</span></h2>
        <div class="faq__list">
          {
            faqs.map((faq) => (
              <details class="faq__item">
                <summary class="faq__summary">
                  <span class="faq__question">{faq.question}</span>
                  <span class="faq__sign" aria-hidden="true" />
                </summary>
                <p class="faq__answer">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
      <aside class="ask" aria-labelledby="ask-title">
        <h3 class="ask__title" id="ask-title">Still have a question?</h3>
        <p class="ask__text">Ask it on a free 30-minute call. You leave with a clear next step.</p>
        <a href="/contact" class="btn btn--accent" data-book-call data-umami-event="Book a call" data-umami-event-from="services-faq">
          Book a call<Icon name="arrow-right" />
        </a>
      </aside>
    </div>
  </section>

  <RibbonEnd from="services-end">Not sure which one <span class="highlight">fits?</span></RibbonEnd>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-services]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-open-dialog]');
  if (root && dialog) {
    const items = [...dialog.querySelectorAll<HTMLElement>('[data-item]')];
    let at = 0;
    let opener: HTMLElement | null = null;
    const show = (i: number) => {
      at = (i + items.length) % items.length;
      items.forEach((item) => (item.hidden = Number(item.dataset.item) !== at));
      dialog.setAttribute('aria-labelledby', `service-title-${at}`);
    };
    root.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-open]');
      if (!button) return;
      opener = button;
      show(Number(button.dataset.open));
      dialog.showModal();
    });
    dialog.querySelectorAll<HTMLButtonElement>('[data-open-step]').forEach((button) =>
      button.addEventListener('click', () => show(at + Number(button.dataset.openStep))),
    );
    dialog.querySelector('[data-open-close]')?.addEventListener('click', () => dialog.close());
    // A click on the dimmed page around the card closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    // Book a call opens its own dialog: close this one first so the two never stack.
    dialog.querySelectorAll('[data-book-call]').forEach((link) => link.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>

<style>
  .anchor {
    scroll-margin-top: 96px;
  }

  /* ---------- Hero ---------- */
  .hero {
    padding-top: 72px;
    padding-bottom: 40px;
  }
  .hero__title {
    max-width: 13em;
  }
  .hero__lede {
    max-width: 34em;
    margin-top: 18px;
  }

  /* ---------- Six tiles ---------- */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 22px;
  }
  .tile__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-tile);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    scroll-margin-top: 96px;
  }
  .tile__open:focus-visible {
    outline: 3px solid var(--teal-ink);
    outline-offset: 4px;
  }
  .stage {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: end center;
    overflow: hidden;
  }
  .tile .stage {
    aspect-ratio: 1 / 0.86;
    padding: 66px 24px 0;
    border-radius: var(--radius-tile);
    transition: box-shadow 300ms var(--ease-out);
  }
  .tile .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(10 17 40 / 0.05);
    pointer-events: none;
  }
  /* Arriving from Home or the footer at #ai-automation and the like: that tile is marked. */
  .tile__open:target .stage {
    box-shadow: 0 0 0 3px var(--teal);
  }
  .tint-cyan {
    background: linear-gradient(160deg, #e3f8fb 0%, #bdeef5 100%);
  }
  .tint-blue {
    background: linear-gradient(160deg, #e8f0ff 0%, #c6d9ff 100%);
  }
  .tint-violet {
    background: linear-gradient(160deg, #efecfe 0%, #d6cefb 100%);
  }
  .tint-ink {
    background: linear-gradient(160deg, #1b2547 0%, #0a1128 100%);
  }
  .ribbon {
    position: absolute;
    inset: auto -10% -18% -10%;
    z-index: -1;
    width: 120%;
    height: 70%;
  }
  .ribbon path {
    fill: none;
    stroke: var(--white);
    stroke-opacity: 0.75;
    stroke-width: 46;
    stroke-linecap: round;
  }
  .tint-ink .ribbon path {
    stroke: #2f8cf6;
    stroke-opacity: 0.35;
  }
  .callout {
    position: absolute;
    left: 22px;
    top: 20px;
    z-index: 3;
    max-width: calc(100% - 44px);
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--teal-ink); /* 5.05:1 for the white 15px text; --teal is 3.17:1 */
    color: var(--white);
    font: 700 15px/1.3 var(--font-display);
    transform: rotate(-2deg);
    transform-origin: left;
    box-shadow: 0 6px 14px -8px rgb(7 122 138 / 0.7);
  }
  .tint-ink .callout {
    background: var(--cyan);
    color: var(--ink);
  }
  .tile__demo {
    display: block;
    width: 100%;
    transform: translateY(16px);
    transition: transform 500ms var(--ease-out);
  }
  .tile__meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2px 16px;
    padding: 16px 6px 0;
  }
  .tile__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .tile__line {
    grid-column: 1;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .tile__go {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out),
      transform 300ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile__open:hover .tile__demo {
      transform: translateY(6px);
    }
    .tile__open:hover .tile__go {
      background: var(--ink);
      color: var(--white);
      transform: rotate(-45deg);
    }
  }

  /* ---------- The opened service ---------- */
  .open {
    width: min(1040px, calc(100% - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: var(--radius-tile);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 40px 90px -40px rgb(10 17 40 / 0.6);
    overflow: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transition:
      opacity 260ms var(--ease-out),
      transform 360ms var(--ease-out),
      display 360ms allow-discrete,
      overlay 360ms allow-discrete;
  }
  .open[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .open[open] {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }
  .open::backdrop {
    background: rgb(10 17 40 / 0.45);
  }
  .open__close {
    position: sticky;
    top: 14px;
    z-index: 5;
    float: right;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 14px 14px -58px 0;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 4px 12px -6px rgb(10 17 40 / 0.4);
    cursor: pointer;
  }
  .open__item[hidden] {
    display: none;
  }
  .open__stage {
    height: 300px;
    padding: 64px 56px 0;
  }
  .open__demo {
    display: block;
    width: 100%;
    transform: translateY(10px);
  }
  .open__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 36px;
    padding: 32px 40px 8px;
  }
  .open__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 34px;
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
  .open__text {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .open__label {
    margin: 0 0 6px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.3;
  }
  .open__label--built {
    margin-top: 22px;
  }
  .open__pages {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .open__pages a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
  }
  .open__pages a:hover {
    border-color: var(--ink);
  }
  .built {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 10px;
  }
  .built li {
    flex: 1;
    min-width: 0;
    max-width: 180px;
  }
  .built a {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }
  .built :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line-soft);
    border-radius: 10px;
  }
  .built span {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    font-weight: 700;
  }
  .gets {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .gets li {
    padding: 10px 0;
    border-top: 1px solid var(--line-soft);
    font-size: 15px;
  }
  .tools {
    margin: 18px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
