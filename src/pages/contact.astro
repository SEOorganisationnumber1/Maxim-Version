---
import Base from '../layouts/Base.astro';
import BookCall from '../components/BookCall.astro';
import CallForm from '../components/CallForm.astro';
import { bookingUrl } from '../lib/integrations';
---

<Base
  title="Book a call"
  current="/contact"
  og="contact"
  description="Book a free 30-minute call about what you want to launch. Within two business days after it, you get our approach and a fixed price in writing."
>
  <div class="bg-paper contact">
    <BookCall mode="page" />
    {
      /* With a scheduling page the calendar is the main path; the written brief waits below it. */
      bookingUrl && (
        <section id="brief" class="brief" aria-labelledby="brief-title">
          <div class="brief__head">
            <h2 id="brief-title" class="h2">Prefer to write?</h2>
            <p class="brief__text">Send a short brief instead. We reply by email with our approach and a fixed price.</p>
          </div>
          <div class="brief__panel">
            <CallForm />
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .contact {
    padding-bottom: 96px;
  }
  .brief {
    max-width: var(--container);
    margin: 0 auto;
    padding: 64px var(--gutter) 0;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 32px 48px;
    scroll-margin-top: 16px;
  }
  .brief__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .brief__text {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .brief__panel {
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-tile);
    padding: clamp(20px, 3vw, 36px);
  }
  @media (max-width: 860px) {
    .brief {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Phones: the same rhythm as every page ---------- */
  @media (max-width: 639.98px) {
    .contact {
      padding-bottom: 0;
    }
    .brief {
      padding-top: 64px;
      gap: 24px;
    }
  }
</style>
