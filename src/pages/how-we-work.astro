---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Agreement from '../components/Agreement.astro';
import RibbonEnd from '../components/RibbonEnd.astro';
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
import { terms } from '../data/terms';

// How we work replaced the Company page (2026-10-22): who we are, shown through what we build
// (our own product first), how a project runs week by week, one team with its tools, and the
// full signed agreement. /company redirects here (astro.config.mjs).

const own = projects.find((p) => p.own && p.site && p.image);
/** Our other own products, such as the bots that run Leadity: one line each under it. */
const ownMore = projects.filter((p) => p.own && p !== own && p.plain);

/** "A car parts store", "An electronics store": names read as part of the sentence. */
const withArticle = (name: string) => {
  const lower = name.charAt(0).toLowerCase() + name.slice(1);
  return `${/^[aeiou]/i.test(name) ? 'an' : 'a'} ${lower}`;
};
/** "a, b and c" */
const listOf = (items: string[]) =>
  items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;
/** "A car parts store, an electronics store and a reviews site" */
const sentence = (items: string[]) => {
  const text = listOf(items);
  return text.charAt(0).toUpperCase() + text.slice(1);
};

/** What we have built, one plain sentence per kind of project, each with small real screens. */
const kindSlug = (kind: string) => kind.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const plural = (kind: string) => (kind.endsWith('s') ? kind : `${kind}s`).toLowerCase();
const built = [...new Set(projects.filter((p) => !p.own).map((p) => p.kind))].map((kind) => {
  const items = projects.filter((p) => !p.own && p.kind === kind);
  return {
    kind,
    names: items.map((p) => withArticle(p.name)),
    shots: items.filter((p) => p.image).slice(0, 3),
  };
});


// A project, week by week. Every promise here was confirmed by the owner on 2026-10-22.
type Step = { when: string; title: string; text: string; doc: 'proposal' | 'link' | 'note' | 'handover' | 'fixes' | 'report' };
const steps: Step[] = [
  {
    when: 'Before we start',
    title: 'A free call, then a fixed price',
    text: '30 minutes about what you want to launch. Within two business days you get the scope and a fixed price in writing.',
    doc: 'proposal',
  },
  {
    when: 'Week one',
    title: 'A build you can click',
    text: 'The first working version is up in the first week, on a private link only you can see.',
    doc: 'link',
  },
  { when: 'Every week', title: 'A short update, in writing', text: 'What we did, what is next, and anything we need from you.', doc: 'note' },
  {
    when: 'Launch day',
    title: 'It goes live, and it is yours',
    text: 'The second payment, and code, designs and accounts handed over in your name.',
    doc: 'handover',
  },
  { when: 'The next 30 days', title: 'Any bug fixed, free', text: 'If something we built breaks, we fix it at no cost.', doc: 'fixes' },
  {
    when: 'Every month, if you stay',
    title: 'A report in plain words',
    text: 'For care and search work: what shipped, what changed and what comes next.',
    doc: 'report',
  },
];

const team = [
  { name: 'Design', text: 'Every screen, for desktop and phone, before we write code.', tools: ['Figma', 'Design tokens', 'Component libraries'] },
  { name: 'Code', text: 'Sites, web apps, bots and extensions, built to last.', tools: ['Astro', 'Next.js', 'TypeScript', 'Tailwind CSS', 'Supabase'] },
  { name: 'Search', text: 'Found on Google and in answers from ChatGPT and Gemini.', tools: ['Search Console', 'Ahrefs', 'Schema.org', 'GA4'] },
];

const jump = [
  ...(own ? [{ href: '#own', label: 'Our own product' }] : []),
  { href: '#weeks', label: 'Week by week' },
  { href: '#team', label: 'One team' },
  { href: '#terms', label: 'In writing' },
];
---

<Base
  title="How We Work"
  current="/how-we-work"
  og="how-we-work"
  description="Who builds your product and how: our own product, what we have built, a project week by week, one team for design, code and search, and the terms we sign before any work starts."
>
  <section class="hero container">
    <h1 class="h1 hero__title">One team, from first call to <span class="highlight">launch.</span></h1>
    <p class="lede hero__lede">Who we are, how a project runs week by week, and what you get in writing before you pay anything.</p>
    <nav class="jump" aria-label="On this page">
      {
        jump.map((link) => (
          <a href={link.href} class="jump__link">
            {link.label}
          </a>
        ))
      }
    </nav>
  </section>

  {
    own && (
      <section id="own" class="block container" aria-labelledby="own-title">
        <h2 class="h2" id="own-title">
          We build our own, <span class="highlight">too.</span>
        </h2>
        <p class="intro">The best proof we can offer is a product we run ourselves.</p>
        <div class="own">
          <div class="stage">
            <svg class="ribbon" aria-hidden="true" viewBox="0 0 400 200" preserveAspectRatio="none">
              <path d="M-20 170 C 80 40, 180 200, 280 90 S 400 10, 440 40" />
            </svg>
            <span class="callout">Co-founded and built by us</span>
            <span class="browser" aria-hidden="true">
              <span class="browser__bar">
                <i />
                <i />
                <i />
              </span>
              <span class="browser__shot">
                <Image src={own.image!.src} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1240px) 640px, 92vw" />
              </span>
            </span>
          </div>
          <div>
            <h3 class="own__name">{own.name}</h3>
            <p class="own__text">{own.summary}</p>
            {ownMore.map((p) => (
              <p class="own__also">
                <strong>{p.name}.</strong> {p.plain}
              </p>
            ))}
            <a href={own.site!} class="btn btn--primary" target="_blank" rel="noopener">
              Visit {new URL(own.site!).hostname}
              <span class="visually-hidden"> (opens in a new tab)</span>
              <Icon name="arrow-up-right" />
            </a>
          </div>
        </div>
        {built.length > 0 && (
          <ul class="built" aria-label="What we have built">
            {built.map((group) => (
              <li>
                <a href={`/work?kind=${kindSlug(group.kind)}`} class="built__row">
                  <span class="built__line">
                    We build {plural(group.kind)}. <em>{sentence(group.names)}.</em>
                  </span>
                  <span class="thumbs" aria-hidden="true">
                    {group.shots.map((p) => (
                      <Image src={p.image!.src} alt="" widths={[200, 400]} sizes="96px" loading="lazy" class="thumb" />
                    ))}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    )
  }

  <section id="weeks" class="block container" aria-labelledby="weeks-title">
    <h2 class="h2" id="weeks-title">A project, week <span class="highlight">by week.</span></h2>
    <p class="intro">You see working software early and hear from us every week, not only at the end.</p>
    <ul class="weeks">
      {
        steps.map((step) => (
          <li class="wk">
            <span class="wk__when">{step.when}</span>
            <h3 class="wk__title">{step.title}</h3>
            <p class="wk__text">{step.text}</p>
            <span class="doc" aria-hidden="true">
              {step.doc === 'proposal' && (
                <>
                  <b>Proposal</b>
                  <i />
                  <i class="w70" />
                  <i class="w45" />
                </>
              )}
              {step.doc === 'link' && <span class="doc__link">Private preview link</span>}
              {step.doc === 'note' && (
                <>
                  <b>This week</b>
                  <i />
                  <i class="w60" />
                </>
              )}
              {step.doc === 'handover' && (
                <>
                  <b>Handover</b>
                  <i class="w80" />
                  <i class="w55" />
                </>
              )}
              {step.doc === 'fixes' && (
                <>
                  <b>Fix list</b>
                  <i class="w40" />
                </>
              )}
              {step.doc === 'report' && (
                <>
                  <b>Monthly report</b>
                  <span class="doc__heads">
                    <span>Shipped</span>
                    <span>Changed</span>
                    <span>Next</span>
                  </span>
                </>
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="team" class="block container" aria-labelledby="team-title">
    <h2 class="h2" id="team-title">One team, <span class="highlight">end to end.</span></h2>
    <p class="intro">
      You talk to the people who build it. Nothing gets lost between agencies, and the product that launches is the one that
      was designed.
    </p>
    <ul class="team">
      {
        team.map((part) => (
          <li class="tm">
            <h3 class="tm__name">{part.name}</h3>
            <p class="tm__text">{part.text}</p>
            <ul class="tools" aria-label={`${part.name} tools`}>
              {part.tools.map((tool) => (
                <li>{tool}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="terms" class="block container terms" aria-labelledby="terms-title">
    <div class="terms__side">
      <h2 class="h2" id="terms-title">What you get in <span class="highlight">writing.</span></h2>
      <p class="intro">Signed before any work starts.</p>
    </div>
    <Agreement terms={terms} />
  </section>

  <RibbonEnd from="how-we-work-end">Want a team that <span class="highlight">ships?</span></RibbonEnd>
</Base>

<style>
  .block {
    padding-top: 120px;
    scroll-margin-top: 80px;
  }
  .intro {
    max-width: 36em;
    margin: 12px 0 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* ---------- Hero ---------- */
  .hero {
    padding-top: 72px;
  }
  .hero__title {
    max-width: 12em;
  }
  .hero__lede {
    max-width: 34em;
    margin-top: 18px;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }
  .jump__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: border-color 160ms var(--ease-out);
  }
  .jump__link:hover {
    border-color: var(--ink);
  }

  /* ---------- Our own product ---------- */
  .own {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    margin-top: 32px;
  }
  .stage {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: end center;
    overflow: hidden;
    aspect-ratio: 1 / 0.7;
    padding: 66px 32px 0;
    border-radius: var(--radius-tile);
    background: linear-gradient(160deg, #e8f0ff 0%, #c6d9ff 100%);
  }
  .ribbon {
    position: absolute;
    inset: auto -10% -18% -10%;
    z-index: -1;
    width: 120%;
    height: 70%;
  }
  .ribbon path {
    fill: none;
    stroke: var(--white);
    stroke-opacity: 0.75;
    stroke-width: 46;
    stroke-linecap: round;
  }
  .callout {
    position: absolute;
    left: 22px;
    top: 20px;
    z-index: 3;
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--teal);
    color: var(--white);
    font: 700 15px/1.3 var(--font-display);
    transform: rotate(-2deg);
    transform-origin: left;
    box-shadow: 0 6px 14px -8px rgb(8 159 179 / 0.7);
  }
  .browser {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
    background: var(--surface);
    box-shadow:
      0 24px 44px -24px rgb(10 17 40 / 0.55),
      0 0 0 1px rgb(10 17 40 / 0.06);
    transform: translateY(16px);
  }
  .browser__bar {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 22px;
    padding: 0 10px;
    border-bottom: 1px solid var(--line-soft);
  }
  .browser__bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }
  .browser__shot {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .browser__shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .own__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 34px;
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
  .own__text {
    margin: 12px 0 22px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .own__also {
    margin: -8px 0 22px;
    padding-left: 14px;
    border-left: 3px solid var(--teal);
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .own__also strong {
    color: var(--ink);
  }
  .built {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .built__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .built__line {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .built__line em {
    font-style: normal;
    color: var(--muted);
  }
  .thumbs {
    display: flex;
    gap: 8px;
  }
  .thumbs :global(.thumb) {
    display: block;
    width: 96px;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line-soft);
    border-radius: 9px;
    box-shadow: 0 8px 18px -14px rgb(10 17 40 / 0.5);
    transition: transform 300ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .built__row:hover .built__line {
      color: var(--teal-ink);
    }
    .built__row:hover :global(.thumb) {
      transform: translateY(-3px) rotate(-1.5deg);
    }
  }

  /* ---------- A project, week by week ---------- */
  .weeks {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .wk {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-tile);
  }
  .wk__when {
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
    color: var(--teal-ink);
  }
  .wk__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .wk__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  /* A small drawing of the document each step produces. */
  .doc {
    display: grid;
    gap: 7px;
    margin-top: auto;
    padding: 12px 14px;
    border: 1px solid var(--line-soft);
    border-radius: 14px;
    background: var(--paper);
    font-size: 12px;
  }
  .doc b {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
  }
  .doc i {
    display: block;
    height: 7px;
    border-radius: 5px;
    background: var(--line);
  }
  .doc .w40 {
    width: 40%;
  }
  .doc .w45 {
    width: 45%;
  }
  .doc .w55 {
    width: 55%;
  }
  .doc .w60 {
    width: 60%;
  }
  .doc .w70 {
    width: 70%;
  }
  .doc .w80 {
    width: 80%;
  }
  .doc__link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-weight: 600;
    color: var(--ink-2);
  }
  .doc__link::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #12b76a;
  }
  .doc__heads {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .doc__heads span {
    padding: 3px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-weight: 700;
  }

  /* ---------- One team ---------- */
  .team {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .tm {
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-tile);
  }
  .tm__name {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.15;
  }
  .tm__text {
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tools li {
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--paper);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
  }

  /* ---------- Terms ---------- */
  .terms {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    align-items: start;
    gap: clamp(32px, 6vw, 88px);
  }
  .terms__side {
    position: sticky;
    top: 120px;
  }

  @media (max-width: 899.98px) {
    .own,
    .terms {
      grid-template-columns: minmax(0, 1fr);
    }
    .weeks,
    .team {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .terms__side {
      position: static;
    }
  }
  @media (max-width: 639.98px) {
    .block {
      padding-top: 64px;
    }
    .hero {
      padding-top: 40px;
    }
    .intro {
      font-size: 17px;
    }
    .weeks,
    .team {
      grid-template-columns: minmax(0, 1fr);
    }
    .stage {
      aspect-ratio: 1 / 0.85;
      padding: 58px 18px 0;
    }
    .own__name {
      font-size: 30px;
    }
    .own .btn {
      width: 100%;
    }
    .built__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    .thumbs :global(.thumb) {
      width: 120px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .jump__link,
    .thumbs :global(.thumb) {
      transition: none;
    }
  }
</style>
