---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import RibbonEnd from '../components/RibbonEnd.astro';
import { Picture } from 'astro:assets';
import { projects } from '../data/projects';
import { coverTerms, COVER_AT_REST } from '../data/terms';
import { site } from '../data/site';
import leadityPhone from '../assets/work/leadity-phone.webp';

// How we work replaced the Company page (2026-10-22). Since 2026-10-28 it is told by what a client
// gets from us, in the order it arrives, each thing shown as itself; then the agreement on one
// cover sheet, who does what, and our own product. /company redirects here (astro.config.mjs).
// Every promise here was confirmed by the owner; the examples are labeled as examples.

/**
 * Everything you get from us, in the order it arrives. On wide screens the list is a set of tabs
 * and the thing itself shows beside it; on phones each one opens as a sheet from the bottom.
 */
const arrivals = [
  { key: 'call', icon: 'video', title: 'A free call', when: 'Day one', line: '30 minutes about what you want to launch.' },
  { key: 'price', icon: 'doc', title: 'Your fixed price', when: 'Within two business days', line: 'Our approach and the scope, in writing.' },
  { key: 'preview', icon: 'link', title: 'Your first preview', when: 'First week of work', line: 'A clickable first version, on a private link.' },
  { key: 'update', icon: 'chat', title: 'A short update', when: 'Every week', line: 'What is done, what is next and what we need from you.' },
  { key: 'handover', icon: 'key', title: 'Everything handed over', when: 'Launch day', line: 'Code and design files, yours once paid in full.' },
  { key: 'fix', icon: 'wrench', title: 'Bugs fixed, free', when: '30 days after launch', line: 'If something we built breaks, we fix it.' },
  { key: 'report', icon: 'chart', title: 'A report', when: 'Every month', line: 'If we stay on for care or SEO.' },
] as const;
/** Open at rest on wide screens: the fixed price, the promise most people come for. */
const OPEN_AT_REST = 'price';
const on = (key: string) => (key === OPEN_AT_REST ? 'is-on' : undefined);

/** The studio's initials, on everything it sends. */
const initials = site.name
  .split(/\s+/)
  .map((word) => word.charAt(0))
  .join('');

/** The first preview's example: a real project of ours, opened on Work. */
const example = projects.find((p) => p.slug === 'car-parts-store' && p.image);

const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const showAll = `Show all ${NUMBER_WORDS[coverTerms.length] ?? coverTerms.length}`;

const team = [
  { name: 'Design', tools: ['Figma', 'Clickable prototypes'] },
  { name: 'Code', tools: ['React', 'React Native', 'Next.js', 'TypeScript', 'Supabase', 'Astro'] },
  { name: 'Search', tools: ['Google Search Console', 'Google Analytics', 'Ahrefs'] },
];

const own = projects.find((p) => p.own && p.site && p.image);
const bots = projects.find((p) => p.slug === 'leadity-telegram-bots');

/** More of our work: one row per kind of project we built for others, with its real screens. */
const kindSlug = (kind: string) => kind.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const plural = (kind: string) => (kind.endsWith('s') ? kind : `${kind}s`);
const built = [...new Set(projects.filter((p) => !p.own).map((p) => p.kind))].map((kind) => {
  const items = projects.filter((p) => !p.own && p.kind === kind);
  const labels = new Set(items.map((p) => p.label));
  return {
    href: `/work?kind=${kindSlug(kind)}`,
    name: `${plural(kind)} we built`,
    /** A tag such as 'Redesign concept', only when it is true of all of them. */
    label: labels.size === 1 ? [...labels][0] : null,
    shots: items.filter((p) => p.image).slice(0, 3),
  };
});
---

<Base
  title="How We Work"
  current="/how-we-work"
  og="how-we-work"
  description="What you get from us, and when: a free call, a fixed price in writing, a first preview in week one, weekly updates, and the terms we sign before any work starts."
>
  <section class="hero container">
    <h1 class="h1 hero__title">One team, from first call to <span class="highlight">launch.</span></h1>
    <p class="lede hero__lede">Everything you get from us, in the order it arrives.</p>
  </section>

  <!-- What arrives, and when -->
  <section id="weeks" class="container" aria-labelledby="weeks-title">
    <h2 class="visually-hidden" id="weeks-title">What arrives, and when</h2>
    <div class="inbox" data-inbox>
      <div class="arrivals" data-list aria-label="What arrives">
        {
          arrivals.map((a) => (
            <button type="button" class="arrival" data-art={a.key}>
              <span class="arrival__ic" aria-hidden="true">
                <Icon name={a.icon} size={21} strokeWidth={2} />
              </span>
              <span class="arrival__title">{a.title}</span>
              <span class="arrival__line">
                <span class="arrival__when">{a.when}</span> · {a.line}
              </span>
              <Icon name="chevron-right" size={20} strokeWidth={2.2} class="arrival__go" />
            </button>
          ))
        }
      </div>

      <div class="stage" data-stage>
        <svg class="stage__ribbon" aria-hidden="true" viewBox="0 0 400 200" preserveAspectRatio="none">
          <path d="M-20 170 C 80 40, 180 200, 280 90 S 400 10, 440 40" />
        </svg>

        <article class:list={['art', on('call')]} data-for="call" aria-labelledby="art-call-t">
          <div class="art__head">
            <span class="art__av" aria-hidden="true">{initials}</span>
            <span><b id="art-call-t">Free call</b><small>Booked from the site</small></span>
          </div>
          <dl>
            <dt>Length</dt>
            <dd>30 minutes, video</dd>
            <dt>With</dt>
            <dd>The people who will build it</dd>
            <dt>About</dt>
            <dd>What you want to launch</dd>
          </dl>
          <a class="art__btn" href="/contact" data-book-call data-umami-event="Book a call" data-umami-event-from="how-we-work-call">
            Book a call<Icon name="arrow-right" size={17} />
          </a>
        </article>

        <article class:list={['art', on('price')]} data-for="price" aria-labelledby="art-price-t">
          <div class="art__head">
            <span class="art__av" aria-hidden="true">{initials}</span>
            <span><b id="art-price-t">Your fixed price</b><small>Within two business days of the call</small></span>
          </div>
          <dl>
            <dt>Approach</dt>
            <dd>How we will build it</dd>
            <dt>Scope</dt>
            <dd>What is included</dd>
            <dt>Price</dt>
            <dd>Fixed for this scope</dd>
            <dt>Payment</dt>
            <dd>In two or three stages</dd>
          </dl>
          <p class="art__note">Nothing starts until you agree.</p>
        </article>

        <article class:list={['art', on('preview')]} data-for="preview" aria-labelledby="art-preview-t">
          <div class="art__head">
            <span class="art__av" aria-hidden="true">{initials}</span>
            <span><b id="art-preview-t">Your first preview</b><small>First week of work</small></span>
            <span class="art__tag">Example</span>
          </div>
          <span class="art__url"><i aria-hidden="true"></i>A private link, shared only with you</span>
          {
            example?.image && (
              <a class="art__shot" href={`/work#${example.slug}`}>
                <span class="art__img">
                  <Picture
                    src={example.image.src}
                    alt=""
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={[480, 800, 1120]}
                    sizes="(max-width: 899.98px) 92vw, 500px"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <small>Example: our {example.name.toLowerCase()}</small>
              </a>
            )
          }
        </article>

        <article class:list={['art', on('update')]} data-for="update" aria-labelledby="art-update-t">
          <div class="art__head">
            <span class="art__av" aria-hidden="true">{initials}</span>
            <span><b id="art-update-t">This week's update</b><small>From the developer building it</small></span>
            <span class="art__tag">Example</span>
          </div>
          <ul>
            <li><b>Done</b><span>Cart and checkout work on phones.</span></li>
            <li><b>Next</b><span>Account pages and order history.</span></li>
            <li><b>From you</b><span>Photos for the product pages.</span></li>
          </ul>
        </article>

        <article class:list={['art', on('handover')]} data-for="handover" aria-labelledby="art-handover-t">
          <div class="art__head">
            <span class="art__av" aria-hidden="true">{initials}</span>
            <span><b id="art-handover-t">It's live, and it's yours</b><small>Launch day</small></span>
          </div>
          <ul class="handover">
            <li><i class="dot" aria-hidden="true"></i><b>Code</b><span>In your account</span></li>
            <li><i class="dot" aria-hidden="true"></i><b>Design files</b><span>In your account</span></li>
            <li><i class="dot" aria-hidden="true"></i><b>Domain</b><span>In your name since day one</span></li>
            <li><i class="dot" aria-hidden="true"></i><b>Hosting</b><span>In your name since day one</span></li>
          </ul>
        </article>

        <article class:list={['art', on('fix')]} data-for="fix" aria-labelledby="art-fix-t">
          <div class="art__head">
            <span class="art__av" aria-hidden="true">{initials}</span>
            <span><b id="art-fix-t">Bug fixed, no charge</b><small>In the 30 days after launch</small></span>
            <span class="art__tag">Example</span>
          </div>
          <dl>
            <dt>You saw</dt>
            <dd>The menu covered the logo on small phones</dd>
            <dt>Status</dt>
            <dd><span class="pill">Fixed and live</span></dd>
            <dt>Cost</dt>
            <dd>Nothing</dd>
          </dl>
        </article>

        <article class:list={['art', on('report')]} data-for="report" aria-labelledby="art-report-t">
          <div class="art__head">
            <span class="art__av" aria-hidden="true">{initials}</span>
            <span><b id="art-report-t">Your monthly report</b><small>For care or SEO work</small></span>
            <span class="art__tag">Example</span>
          </div>
          <div class="art__cols">
            <div><b>Shipped</b><span>Gift cards at checkout</span></div>
            <div><b>Changed</b><span>Category pages rewritten for search</span></div>
            <div><b>Next</b><span>A spring sale page</span></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Phones: an arrival opens here, from the bottom of the screen -->
  <dialog class="sheet" data-sheet aria-labelledby="sheet-when">
    <div class="sheet__top">
      <span class="sheet__when" id="sheet-when" tabindex="-1"></span>
      <button type="button" class="sheet__close" data-sheet-close aria-label="Close"><Icon name="close" /></button>
    </div>
    <div data-sheet-body></div>
    <button type="button" class="sheet__next" data-sheet-next><span data-sheet-next-label></span><Icon name="arrow-right" /></button>
    <a class="sheet__book" href="/contact" data-book-call data-umami-event="Book a call" data-umami-event-from="how-we-work-sheet" data-sheet-book hidden>
      Book a call<Icon name="arrow-right" />
    </a>
  </dialog>

  <!-- What you get in writing: the cover of the agreement, signed -->
  <section id="terms" class="container block" aria-labelledby="terms-title">
    <div class="block__head">
      <h2 class="h2" id="terms-title">What you get in <span class="highlight">writing.</span></h2>
    </div>
    <div class="cover" data-cover>
      <div class="cover__head">
        <b>The {site.shortName} agreement</b>
        <span>Signed before any work starts</span>
      </div>
      <ul class="cover__terms" id="terms-list">
        {
          coverTerms.map((term, i) => (
            <li hidden={i >= COVER_AT_REST}>
              <b>{term.title}</b>
              <span>{term.text}</span>
            </li>
          ))
        }
      </ul>
      {
        coverTerms.length > COVER_AT_REST && (
          <button type="button" class="cover__more" aria-expanded="false" aria-controls="terms-list" data-more data-all={showAll}>
            <span data-more-label>{showAll}</span>
            <Icon name="chevron-down" size={16} />
          </button>
        )
      }
      <div class="cover__sign">
        <div>
          <svg viewBox="0 0 150 46" aria-hidden="true">
            <path d="M6 32c10-24 16-26 14-6-1 10 2 12 8 2 5-9 9-12 10-3 1 8 5 9 10 0 4-8 8-10 9-2 1 6 5 7 10 0 6-8 12-9 18-4 6 5 14 5 24-2 10-6 20-8 33-6" />
          </svg>
          <span>For {site.name}</span>
        </div>
        <div><span>For you</span></div>
      </div>
    </div>
  </section>

  <!-- Who does what -->
  <section id="team" class="container block" aria-labelledby="team-title">
    <div class="block__head">
      <h2 class="h2" id="team-title">Design, code and <span class="highlight">search.</span></h2>
      <p class="block__intro">The same people design it, build it and help customers find it on Google and in ChatGPT.</p>
    </div>
    <div class="team">
      {
        team.map((part) => (
          <div>
            <h3 class="team__name">{part.name}</h3>
            <ul aria-label={`${part.name} tools`}>
              {part.tools.map((tool) => (
                <li>{tool}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Our own product, and the rest of the work -->
  {
    own?.image && own.site && (
      <section id="own" class="container block" aria-labelledby="own-title">
        <div class="block__head">
          <h2 class="h2" id="own-title">
            We build our own, <span class="highlight">too.</span>
          </h2>
        </div>
        <div class="own">
          <div class="own__stage">
            <svg class="stage__ribbon" aria-hidden="true" viewBox="0 0 400 200" preserveAspectRatio="none">
              <path d="M-20 170 C 80 40, 180 200, 280 90 S 400 10, 440 40" />
            </svg>
            <span class="callout" aria-hidden="true">
              Our own product
            </span>
            <span class="frame frame--browser">
              <span class="frame__bar" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
              <span class="frame__shot">
                <Picture
                  src={own.image.src}
                  alt={own.image.alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[400, 640, 960, 1280]}
                  sizes="(max-width: 639.98px) 1px, (max-width: 1099.98px) 72vw, 480px"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </span>
            <span class="frame frame--phone">
              <Picture
                src={leadityPhone}
                alt={`The ${new URL(own.site).hostname} home page on a phone`}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[200, 300, 400, 600]}
                sizes="(max-width: 639.98px) 200px, (max-width: 1099.98px) 19vw, 130px"
                loading="lazy"
                decoding="async"
              />
            </span>
          </div>
          <div>
            <h3 class="own__name">{own.name}</h3>
            <p class="own__text">
              A lead generation platform that finds local businesses on Google Maps. We co-founded it and built the first
              version, then its website, user area and SEO.
            </p>
            {bots?.plain && (
              <p class="own__also">
                <b>{bots.name}.</b> {bots.plain}
              </p>
            )}
            <a href={own.site} class="btn btn--primary" target="_blank" rel="noopener">
              Visit {new URL(own.site).hostname}
              <span class="visually-hidden"> (opens in a new tab)</span>
              <Icon name="arrow-up-right" />
            </a>
          </div>
        </div>
        {built.length > 0 && (
          <div class="more">
            <h3 class="more__title">More of our work</h3>
            <ul class="kinds">
              {built.map((group) => (
                <li>
                  <a href={group.href}>
                    <span class="kinds__name">
                      {group.name}
                      {group.label && <span class="kinds__tag">{group.label}</span>}
                      <Icon name="arrow-right" size={20} />
                    </span>
                    <span class="thumbs" aria-hidden="true">
                      {group.shots.map((p) => (
                        <Picture
                          src={p.image!.src}
                          alt=""
                          formats={['avif']}
                          fallbackFormat="webp"
                          widths={[200, 300]}
                          sizes="96px"
                          loading="lazy"
                          decoding="async"
                        />
                      ))}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )
  }

  <RibbonEnd from="how-we-work-end">Want a team that <span class="highlight">ships?</span></RibbonEnd>
</Base>

<script>
  // ---------- What arrives: tabs beside the thing itself on wide screens, a sheet on phones.
  const inbox = document.querySelector<HTMLElement>('[data-inbox]');
  const sheet = document.querySelector<HTMLDialogElement>('[data-sheet]');
  const list = inbox?.querySelector<HTMLElement>('[data-list]');
  const sheetBody = sheet?.querySelector<HTMLElement>('[data-sheet-body]');
  const sheetWhen = sheet?.querySelector<HTMLElement>('#sheet-when');
  const nextButton = sheet?.querySelector<HTMLButtonElement>('[data-sheet-next]');
  const nextLabel = sheet?.querySelector<HTMLElement>('[data-sheet-next-label]');
  const bookLink = sheet?.querySelector<HTMLElement>('[data-sheet-book]');
  if (inbox && sheet && list && sheetBody && sheetWhen && nextButton && nextLabel && bookLink) {
    const items = [...list.querySelectorAll<HTMLButtonElement>('.arrival')];
    const arts = [...inbox.querySelectorAll<HTMLElement>('[data-stage] .art')];
    const phone = window.matchMedia('(max-width: 899.98px)');
    const artFor = (item: HTMLElement) => arts.find((art) => art.dataset.for === item.dataset.art);
    const textOf = (item: HTMLElement, part: string) => item.querySelector(part)?.textContent?.trim() ?? '';
    let current = Math.max(
      0,
      items.findIndex((item) => artFor(item)?.classList.contains('is-on')),
    );

    const show = (i: number, focus: boolean) => {
      current = i;
      items.forEach((item, k) => {
        item.setAttribute('aria-selected', String(k === i));
        item.tabIndex = k === i ? 0 : -1;
      });
      const shown = artFor(items[i]!);
      arts.forEach((art) => {
        art.classList.toggle('is-on', art === shown);
        art.inert = art !== shown;
      });
      if (focus) items[i]!.focus();
    };

    const setMode = () => {
      if (phone.matches) {
        list.setAttribute('role', 'group');
        list.removeAttribute('aria-orientation');
        items.forEach((item) => {
          ['role', 'aria-selected', 'aria-controls'].forEach((name) => item.removeAttribute(name));
          item.setAttribute('aria-haspopup', 'dialog');
          item.tabIndex = 0;
        });
      } else {
        list.setAttribute('role', 'tablist');
        list.setAttribute('aria-orientation', 'vertical');
        items.forEach((item) => {
          item.removeAttribute('aria-haspopup');
          item.setAttribute('role', 'tab');
          item.id = `tab-${item.dataset.art}`;
          item.setAttribute('aria-controls', `art-${item.dataset.art}`);
        });
        arts.forEach((art) => {
          art.id = `art-${art.dataset.for}`;
          art.setAttribute('role', 'tabpanel');
          // A panel with nothing to focus inside it can take focus itself, so Tab reaches its content.
          if (!art.querySelector('a, button')) art.tabIndex = 0;
        });
        show(current, false);
      }
    };

    const openSheet = (i: number) => {
      current = i;
      const item = items[i]!;
      const copy = artFor(item)?.cloneNode(true) as HTMLElement | undefined;
      if (!copy) return;
      copy.classList.add('is-on');
      copy.inert = false;
      ['id', 'role', 'tabindex', 'aria-labelledby'].forEach((name) => copy.removeAttribute(name));
      // The original stays on the page, so the copy keeps no ids.
      copy.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
      sheetBody.replaceChildren(copy);
      sheetWhen.textContent = textOf(item, '.arrival__when');
      const next = items[i + 1];
      nextButton.hidden = !next;
      bookLink.hidden = Boolean(next);
      if (next) nextLabel.textContent = `Next: ${textOf(next, '.arrival__title').toLowerCase()}`;
      if (!sheet.open) sheet.showModal();
      sheet.scrollTop = 0;
    };

    items.forEach((item, i) => item.addEventListener('click', () => (phone.matches ? openSheet(i) : show(i, false))));
    list.addEventListener('keydown', (event) => {
      if (phone.matches) return;
      const step = ({ ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 } as Record<string, number>)[event.key];
      if (step) {
        event.preventDefault();
        show((current + step + items.length) % items.length, true);
      } else if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        show(event.key === 'Home' ? 0 : items.length - 1, true);
      }
    });
    sheet.querySelector('[data-sheet-close]')?.addEventListener('click', () => sheet.close());
    // Next swaps what the sheet shows; focus moves to its new heading, so the change is heard.
    nextButton.addEventListener('click', () => {
      openSheet(current + 1);
      sheetWhen.focus();
    });
    // A tap on the dimmed page around the sheet closes it; a tap inside never does. Clicks on the
    // sheet's own buttons and links (Enter and Space make clicks with no position) target those
    // controls, so only a click on the dialog box itself, outside its edges, counts.
    sheet.addEventListener('click', (event) => {
      if (event.target !== sheet) return;
      const r = sheet.getBoundingClientRect();
      if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) sheet.close();
    });
    sheet.addEventListener('close', () => items[current]?.focus());
    phone.addEventListener('change', () => {
      if (!phone.matches && sheet.open) sheet.close();
      setMode();
    });
    setMode();
  }

  // ---------- The agreement: three terms at rest, all of them on request. Focus moves to the
  // first term that appears.
  const more = document.querySelector<HTMLButtonElement>('[data-more]');
  const moreLabel = more?.querySelector<HTMLElement>('[data-more-label]');
  if (more && moreLabel) {
    const extra = [...document.querySelectorAll<HTMLElement>('#terms-list li[hidden]')];
    more.addEventListener('click', () => {
      const open = more.getAttribute('aria-expanded') !== 'true';
      more.setAttribute('aria-expanded', String(open));
      moreLabel.textContent = open ? 'Show fewer' : (more.dataset.all ?? 'Show all');
      extra.forEach((li) => (li.hidden = !open));
      if (open && extra[0]) {
        extra[0].tabIndex = -1;
        extra[0].focus();
      }
    });
  }

  // The studio's signature writes itself once, when the agreement comes into view.
  const cover = document.querySelector<HTMLElement>('[data-cover]');
  if (cover) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      cover.classList.add('is-signed');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            cover.classList.add('is-signed');
            io.disconnect();
          }
        },
        { threshold: 0.4 },
      );
      io.observe(cover);
    }
  }
</script>

<style>
  /* ---------- Page rhythm ---------- */
  .hero {
    padding-top: 72px;
    padding-bottom: 8px;
  }
  .hero__title {
    max-width: 12em;
  }
  .hero__lede {
    max-width: 30em;
    margin-top: 18px;
  }
  .block {
    padding-top: 88px;
    scroll-margin-top: 80px;
  }
  .block__head {
    display: grid;
    gap: 12px;
    margin-bottom: 36px;
  }
  .block__intro {
    max-width: 36em;
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  #weeks {
    scroll-margin-top: 80px;
  }

  /* ---------- What arrives, and when ---------- */
  /* Wide screens: the list on the left, the thing itself on the right. */
  .inbox {
    display: grid;
    grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    align-items: stretch;
    gap: 20px;
    margin-top: 40px;
  }
  .arrivals {
    margin: 0;
    padding: 8px;
    border-radius: var(--radius-tile);
    background: var(--surface);
    box-shadow: var(--shadow-tile);
  }
  .arrival {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    gap: 2px 14px;
    width: 100%;
    min-height: 64px;
    padding: 11px 14px 11px 11px;
    border: 0;
    border-radius: 18px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 200ms var(--ease-out);
  }
  .arrival + .arrival {
    margin-top: 2px;
  }
  .arrival__ic {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: #eef2f6;
    color: var(--ink-2);
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }
  .arrival__title {
    grid-column: 2;
    font: 700 17px/1.25 var(--font-display);
  }
  .arrival__line {
    grid-column: 2;
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
  }
  /* When it arrives starts the line, in teal. */
  .arrival__when {
    font-weight: 700;
    color: var(--teal-ink);
  }
  .arrival :global(.arrival__go) {
    display: none;
  }
  .arrival[aria-selected='true'] {
    background: #eaf7f9;
  }
  .arrival[aria-selected='true'] .arrival__ic {
    background: var(--teal-ink);
    color: var(--white);
  }
  @media (hover: hover) and (pointer: fine) {
    .arrival:hover:not([aria-selected='true']) {
      background: #f4f8fa;
    }
  }

  .stage {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 40px;
    border-radius: var(--radius-tile);
    background: linear-gradient(160deg, #e3f8fb 0%, #bdeef5 100%);
  }
  .stage__ribbon {
    position: absolute;
    inset: auto -10% -24% -10%;
    z-index: -1;
    width: 120%;
    height: 64%;
  }
  .stage__ribbon path {
    fill: none;
    stroke: var(--white);
    stroke-opacity: 0.7;
    stroke-width: 46;
    stroke-linecap: round;
  }
  .stage > .art {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.985);
    transition:
      opacity 260ms var(--ease-out),
      transform 420ms var(--ease-out),
      visibility 0s 260ms;
  }
  .stage > .art.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 260ms var(--ease-out),
      transform 420ms var(--ease-out),
      visibility 0s;
  }

  /* ---------- The things that arrive, built in HTML. The only button is the real Book a call. ---------- */
  .art {
    width: 100%;
    max-width: 560px;
    padding: 28px;
    border-radius: 22px;
    background: var(--white);
    box-shadow:
      0 1px 2px rgb(10 17 40 / 0.05),
      0 24px 48px -28px rgb(10 17 40 / 0.42);
    font-size: 16.5px;
    line-height: 1.45;
  }
  .art:focus-visible {
    outline-offset: 4px;
  }
  .art__head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .art__av {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--tint-cyan);
    color: #06717f;
    font: 800 13px/1 var(--font-display);
  }
  .art__head b {
    display: block;
    font: 700 20px/1.2 var(--font-display);
  }
  .art__head small {
    display: block;
    font-size: 13.5px;
    color: var(--muted);
  }
  .art__tag {
    align-self: flex-start;
    margin-left: auto;
    padding: 2px 9px;
    border-radius: 999px;
    background: #f1f4f8;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
  }
  .art dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 9px 18px;
    margin: 0;
  }
  .art dt {
    font-weight: 600;
    color: var(--muted);
  }
  .art dd {
    margin: 0;
    font-weight: 600;
  }
  .art ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .art li {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 12px;
    padding: 10px 0;
  }
  .art li + li {
    border-top: 1px solid var(--line-soft);
  }
  .art li b {
    font-weight: 700;
  }
  .art .handover li {
    grid-template-columns: 10px 110px 1fr;
    align-items: baseline;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--teal);
  }
  .art__note {
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
    font-weight: 700;
  }
  .art__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    margin-top: 18px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-weight: 700;
    font-size: 15.5px;
    text-decoration: none;
    transition: background-color 160ms var(--ease-out);
  }
  .art__btn:hover {
    background: #1b2547;
    color: var(--white);
  }
  .art__url {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 12px;
    border-radius: 12px;
    background: #f1f5f9;
    font-size: 14px;
    color: var(--ink-2);
  }
  .art__url i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #12b76a;
  }
  .art__shot {
    display: block;
    margin-top: 12px;
    color: inherit;
    text-decoration: none;
  }
  .art__img {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line-soft);
    border-radius: 12px;
  }
  .art__img :global(picture) {
    display: contents;
  }
  .art__img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 1200ms var(--ease-out);
  }
  .art__shot small {
    display: block;
    margin-top: 8px;
    font-size: 13.5px;
    color: var(--muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .art__shot:hover small {
      color: var(--teal-ink);
    }
    .art__shot:hover .art__img :global(img) {
      transform: translateY(-4%);
    }
  }
  .pill {
    display: inline-flex;
    padding: 2px 10px;
    border-radius: 999px;
    background: #e7f6ee;
    color: #0f6b3e;
    font-size: 13px;
    font-weight: 700;
  }
  .art__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .art__cols div {
    padding: 12px;
    border-radius: 12px;
    background: #f6f9fb;
  }
  .art__cols b {
    display: block;
    font-size: 14px;
  }
  .art__cols span {
    display: block;
    margin-top: 2px;
    font-size: 14px;
    line-height: 1.35;
    color: var(--ink-2);
  }

  /* ---------- The sheet (phones only) ---------- */
  .sheet {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: 560px;
    max-height: 88vh;
    margin: 0 auto;
    padding: 16px 20px calc(20px + env(safe-area-inset-bottom));
    overflow: auto;
    overscroll-behavior: contain;
    border: 0;
    border-radius: 26px 26px 0 0;
    background: var(--paper);
    color: var(--ink);
  }
  .sheet::backdrop {
    background: rgb(10 17 40 / 0.46);
  }
  .sheet[open] {
    animation: sheet-in 380ms var(--ease-out);
  }
  .sheet[open]::backdrop {
    animation: sheet-fade 280ms var(--ease-out);
  }
  @keyframes sheet-in {
    from {
      transform: translateY(100%);
    }
  }
  @keyframes sheet-fade {
    from {
      opacity: 0;
    }
  }
  /* The page under an open sheet stays put. */
  :global(html:has(dialog[data-sheet][open])) {
    overflow: hidden;
  }
  .sheet__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .sheet__when {
    font-size: 15px;
    font-weight: 700;
    color: var(--teal-ink);
  }
  .sheet__when:focus-visible {
    outline-offset: 4px;
  }
  .sheet__close {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .sheet .art {
    max-width: none;
    padding: 20px;
    font-size: 15.5px;
    box-shadow: var(--shadow-tile);
  }
  .sheet .art__head b {
    font-size: 18px;
  }
  .sheet__next,
  .sheet__book {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 54px;
    margin-top: 14px;
    padding: 0 20px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: 700 16px/1.3 var(--font-body);
    text-decoration: none;
    cursor: pointer;
  }
  .sheet__book {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--white);
  }
  .sheet__book:hover {
    color: var(--white);
  }
  .sheet__next[hidden],
  .sheet__book[hidden] {
    display: none;
  }

  /* ---------- What you get in writing: a cover sheet, one line per term, signed ---------- */
  .cover {
    padding: 34px 38px 30px;
    border-radius: var(--radius-tile);
    background: var(--surface);
    box-shadow: var(--shadow-tile);
  }
  .cover__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 6px 20px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--ink);
  }
  .cover__head b {
    font: 800 22px/1.2 var(--font-display);
  }
  .cover__head span {
    font-size: 14px;
    color: var(--muted);
  }
  .cover__terms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cover__terms li {
    padding: 18px 0 16px;
    border-bottom: 1px solid var(--line-soft);
  }
  .cover__terms li[hidden] {
    display: none;
  }
  .cover__terms li:focus-visible {
    outline-offset: 4px;
    border-radius: 4px;
  }
  .cover__terms b {
    display: block;
    font: 700 17px/1.3 var(--font-display);
  }
  .cover__terms span {
    display: block;
    margin-top: 3px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .cover__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 16px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: 700 15px/1 var(--font-body);
    cursor: pointer;
    transition: border-color 160ms var(--ease-out);
  }
  .cover__more:hover {
    border-color: var(--ink);
  }
  .cover__more :global(svg) {
    transition: transform 300ms var(--ease-out);
  }
  .cover__more[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
  .cover__sign {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 28px;
  }
  .cover__sign div {
    display: grid;
    align-content: end;
    gap: 6px;
  }
  .cover__sign svg {
    width: 150px;
    height: 46px;
  }
  .cover__sign path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 520;
    stroke-dashoffset: 520;
    transition: stroke-dashoffset 1400ms var(--ease-out);
  }
  .cover.is-signed .cover__sign path {
    stroke-dashoffset: 0;
  }
  .cover__sign span {
    padding-top: 8px;
    border-top: 1.5px solid var(--ink);
    font-size: 13px;
    color: var(--muted);
  }

  /* ---------- Who does what ---------- */
  .team {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .team > div {
    padding: 20px 22px;
    border-radius: 22px;
    background: var(--surface);
    box-shadow: var(--shadow-tile);
  }
  .team__name {
    margin: 0;
    font: 700 19px/1.2 var(--font-display);
  }
  .team ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .team li {
    padding: 4px 11px;
    border-radius: 999px;
    background: #f1f5f9;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-2);
  }

  /* ---------- Our own product ---------- */
  .own {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
  }
  .own__stage {
    position: relative;
    isolation: isolate;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    height: 360px;
    overflow: hidden;
    padding: 64px 28px 0;
    border-radius: var(--radius-tile);
    background: linear-gradient(160deg, #e8f0ff 0%, #c6d9ff 100%);
  }
  .own__stage .stage__ribbon {
    inset: auto -10% -18% -10%;
    height: 70%;
  }
  .callout {
    position: absolute;
    left: 20px;
    top: 18px;
    z-index: 3;
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--teal-ink); /* 5.05:1 for the white text; --teal is 3.17:1 */
    color: var(--white);
    font: 700 15px/1.3 var(--font-display);
    transform: rotate(-2deg);
    transform-origin: left;
    box-shadow: 0 6px 14px -8px rgb(7 122 138 / 0.7);
  }
  .frame {
    position: relative;
    display: block;
    flex: none;
    overflow: hidden;
    background: var(--white);
  }
  .frame :global(picture) {
    display: contents;
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  /* A little taller than its stage, so it runs off the bottom edge. */
  .frame--browser {
    align-self: stretch;
    width: 78%;
    height: calc(100% + 28px);
    margin-right: 14%;
    border-radius: 12px 12px 0 0;
    box-shadow: 0 18px 40px -22px rgb(10 17 40 / 0.45);
  }
  .frame__bar {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 22px;
    padding: 0 10px;
    background: #f1f4f8;
    border-bottom: 1px solid var(--line-soft);
  }
  .frame__bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #cfd8e3;
  }
  .frame__shot {
    display: block;
    height: calc(100% - 22px);
    overflow: hidden;
  }
  .frame--phone {
    position: absolute;
    right: 7%;
    top: 96px;
    z-index: 2;
    width: 20%;
    aspect-ratio: 9 / 19.5;
    border: 6px solid var(--ink);
    border-radius: 26px;
    box-shadow: 0 22px 40px -22px rgb(10 17 40 / 0.55);
  }
  /* The island, and a status band so nothing sits under the round corner. */
  .frame--phone::after {
    content: '';
    position: absolute;
    z-index: 2;
    top: 1.4%;
    left: 50%;
    width: 30%;
    height: 2.6%;
    border-radius: 999px;
    background: var(--ink);
    transform: translateX(-50%);
  }
  .frame--phone :global(img) {
    position: absolute;
    inset: 6% 0 0;
    height: 94%;
  }
  .own__name {
    margin: 0;
    font: 800 34px/1.06 var(--font-display);
    letter-spacing: -0.02em;
  }
  .own__text {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .own__also {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .own__also b {
    color: var(--ink);
  }
  .own .btn {
    margin-top: 22px;
  }
  .more {
    margin-top: 48px;
  }
  .more__title {
    margin: 0 0 4px;
    font: 700 22px/1.2 var(--font-display);
  }
  .kinds {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .kinds a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    min-height: 76px;
    padding: 12px 4px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .kinds__name {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font: 700 clamp(1.2rem, 1.9vw, 1.5rem) / 1.25 var(--font-display);
    letter-spacing: -0.01em;
    transition: color 160ms var(--ease-out);
  }
  .kinds__name :global(svg) {
    transition: transform 200ms var(--ease-out);
  }
  .kinds__tag {
    padding: 2px 10px;
    border: 1px solid #d9d0fb;
    border-radius: 999px;
    background: #f4f1ff;
    color: #45369e;
    font: 700 13px/1.5 var(--font-body);
    letter-spacing: 0;
  }
  .thumbs {
    display: flex;
    flex: none;
    gap: 8px;
  }
  .thumbs :global(picture) {
    display: contents;
  }
  .thumbs :global(img) {
    display: block;
    width: 96px;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line-soft);
    border-radius: 9px;
    box-shadow: 0 8px 18px -14px rgb(10 17 40 / 0.5);
    transition: transform 300ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .kinds a:hover .kinds__name {
      color: var(--teal-ink);
    }
    .kinds a:hover .kinds__name :global(svg) {
      transform: translateX(3px);
    }
    .kinds a:hover .thumbs :global(img) {
      transform: translateY(-3px) rotate(-1.5deg);
    }
  }

  /* ---------- Tablets ---------- */
  @media (max-width: 1099.98px) {
    .inbox {
      grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    }
    .stage {
      padding: 28px;
    }
    .art {
      padding: 24px;
      font-size: 15.5px;
    }
    .art__head b {
      font-size: 18px;
    }
    /* One term per row, like the cover page of a contract. */
    .cover__terms {
      grid-template-columns: minmax(0, 1fr);
    }
    .cover__terms li {
      display: grid;
      grid-template-columns: minmax(150px, 220px) minmax(0, 1fr);
      align-items: baseline;
      gap: 4px 20px;
    }
    .cover__terms span {
      margin-top: 0;
    }
    .own {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }

  /* ---------- Phones: their own layout. A thread of what arrives, each one opening as a sheet. ---------- */
  @media (max-width: 899.98px) {
    .inbox {
      grid-template-columns: minmax(0, 1fr);
    }
    .stage {
      display: none;
    }
    .arrivals {
      display: grid;
      gap: 10px;
      padding: 0;
      background: none;
      box-shadow: none;
    }
    .arrival {
      grid-template-columns: 44px minmax(0, 1fr) 20px;
      min-height: 76px;
      padding: 14px;
      border-radius: 22px;
      background: var(--surface);
      box-shadow: var(--shadow-tile);
    }
    .arrival + .arrival {
      margin-top: 0;
    }
    .arrival__ic {
      align-self: start;
    }
    .arrival__title {
      font-size: 18px;
    }
    .arrival__line {
      font-size: 14.5px;
    }
    .arrival :global(.arrival__go) {
      display: block;
      grid-column: 3;
      grid-row: 1 / span 2;
      color: var(--muted);
    }
  }
  @media (max-width: 639.98px) {
