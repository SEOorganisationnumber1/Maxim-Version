---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { filled, numbers, team } from '../data/site';

/** The facts band shows only the figures that are set, and disappears without any. */
const facts = filled([
  { value: numbers.founded, label: 'founded' },
  { value: numbers.teamSize, label: 'people on the team' },
  { value: numbers.projectsShipped, label: 'projects shipped' },
  { value: numbers.marketsServed, label: 'markets served' },
]);

const rules = [
  {
    title: 'Modern or nothing',
    text: 'Current frameworks and current tooling. No legacy playbooks.',
  },
  {
    title: 'Efficient by design',
    text: 'Reusable systems, automation for the repetitive parts, people for the judgment calls.',
  },
  {
    title: 'Outcomes over output',
    text: 'Code is a means. We report on what shipped and what it changed for the business.',
  },
  {
    title: 'Show the numbers',
    text: 'Every month you see what we did, what it changed and what comes next.',
  },
];

// Photo wells without a photo cycle through the three tints.
const tints = ['cyan', 'blue', 'violet'] as const;
---

<Base
  title="Company"
  current="/company"
  og="company"
  description="A product studio for design, engineering and launch. We exist for one outcome: products that launch on time and keep working after they do."
>
  <section class="hero bg-paper">
    <div class="hero__art" aria-hidden="true">
      <svg viewBox="0 0 440 520" preserveAspectRatio="xMinYMid slice" fill="none">
        <defs>
          <linearGradient id="top-a" x1="440" y1="0" x2="60" y2="520" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#22D3DD"></stop>
            <stop offset="0.5" stop-color="#2F8CF6"></stop>
            <stop offset="1" stop-color="#5B4FE9"></stop>
          </linearGradient>
        </defs>
        <path d="M480 -30 C 300 0, 160 120, 260 250 C 340 350, 220 460, 480 560 Z" fill="#DFF6F9"></path>
        <path
          d="M500 30 C 320 40, 190 150, 290 260 C 370 350, 280 460, 500 530"
          stroke="url(#top-a)"
          stroke-width="76"
          stroke-linecap="round"></path>
      </svg>
    </div>
    <div class="container hero__inner">
      <h1 class="h1 hero__title">
        A product studio for design, engineering and <span class="highlight">launch.</span>
      </h1>
      <p class="lede hero__lede">
        We exist for one outcome: products that launch on time and keep working after they do.
      </p>
    </div>
  </section>

  {
    facts.length > 0 && (
      <section aria-label="Facts" class="bg-white border-top border-bottom">
        <dl class="stats">
          {facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class:list={['bg-paper', { 'border-top': facts.length === 0 }]}>
    <div class="container story">
      <div class="story__head">
        <h2 class="h2">Most agencies sell hours. We sell outcomes.</h2>
      </div>
      <div class="story__body">
        <p>
          Design, engineering and growth sit in one team here, on purpose. A product that looks good
          but breaks is a cost. A product that works but nobody finds is a leak. We build for both
          from the first sketch.
        </p>
        <p>
          We also keep our methods current. Frameworks, AI tooling and search all change every
          quarter. We test what works today, keep what performs and drop the rest.
        </p>
        <p>
          That is the whole model: modern tools, short release cycles, and a report every month that
          shows what shipped and what moved.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white border-top">
    <div class="container block block--rules">
      <div class="block__head">
        <h2 class="h2">Four rules we do not bend.</h2>
      </div>
      <ol class="rule-grid">
        {
          rules.map((rule, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{rule.title}</h3>
              <p>{rule.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    team.length > 0 && (
      <section class="bg-paper border-top">
        <div class="container block block--team">
          <div class="block__head">
            <h2 class="h2">The people who do the work.</h2>
          </div>
          <ul class="team">
            {team.map((member, i) => (
              <li class="team__member">
                {member.photo ? (
                  <img
                    class="team__photo team__photo--img"
                    src={member.photo}
                    alt={`Portrait of ${member.name}`}
                    width="480"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div aria-hidden="true" class:list={['team__photo', `team__photo--${tints[i % tints.length]}`]} />
                )}
                <div class="team__meta">
                  <span class="team__name">{member.name}</span>
                  <span class="team__role">{member.role}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand title="Work with a team that ships." borderTop pad="full" />
</Base>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero__art {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: max(0px, calc(100% - 960px));
    max-width: 440px;
  }
  .hero__art svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__inner {
    position: relative;
    padding-top: 88px;
    padding-bottom: 72px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero__title {
    max-width: 880px;
  }
  .hero__lede {
    max-width: 640px;
  }

  /* ---------- Story ---------- */

  .story {
    padding-top: 96px;
    padding-bottom: 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
  }
  .story__head {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .story__body {
    flex: 1.4 1 440px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .story__body p {
    margin: 0;
  }

  /* ---------- Rules and team ---------- */

  .block {
    padding-top: 96px;
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
  }
  .block--rules {
    gap: 56px;
  }
  .block--team {
    gap: 48px;
  }
  .block__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 760px;
  }

  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 24px;
  }
  .team__member {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .team__photo {
    aspect-ratio: 4 / 5;
    border: 1.5px solid var(--ink);
    border-radius: 16px;
    display: flex;
    align-items: flex-end;
    padding: 16px;
  }
  .team__photo--img {
    display: block;
    width: 100%;
    height: auto;
    padding: 0;
    object-fit: cover;
  }
  .team__photo--cyan {
    background: var(--tint-cyan);
  }
  .team__photo--blue {
    background: var(--tint-blue);
  }
  .team__photo--violet {
    background: var(--tint-violet);
  }
  .team__meta {
    display: flex;
    flex-direction: column;
  }
  .team__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
  }
  .team__role {
    font-size: 15px;
    color: var(--ink-2);
  }
</style>
