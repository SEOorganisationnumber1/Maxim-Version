---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Workbench from '../components/Workbench.astro';
import { Image } from 'astro:assets';
import { filled, numbers, site } from '../data/site';
import { cardLine, clients, projects, projectUrl, proofLink } from '../data/projects';

/** "Trusted by:" chips, clients only (never our own products). Past CHIP_LIMIT the rest are behind "+ more brands". */
const CHIP_LIMIT = 4;
const chips = clients.slice(0, CHIP_LIMIT);

/** The numbers band shows only the figures that are set, and disappears without any. */
const stats = filled([
  { value: numbers.projectsShipped, label: 'projects shipped' },
  { value: numbers.yearsInBusiness, label: 'years in business' },
  { value: numbers.marketsServed, label: 'markets served' },
  { value: numbers.retention, label: 'clients who stay past year one' },
]);

/** Written promises from the Services terms: the trust we can offer without faces or logos. */
const promises = ['Fixed price in writing', 'You own the code', '30 days of free fixes'];

/** The terms that matter most before a first call. The full list lives on Services. */
const terms = [
  {
    title: 'A fixed price, in writing',
    text: 'After a free call you get our approach and a fixed price for a written scope within two business days. Anything new gets its own price, and you approve it first.',
  },
  { title: 'Pay in stages', text: '50% to start and 50% at launch. Larger projects pay in three stages, tied to the design and the launch.' },
  {
    title: 'Everything is yours',
    text: 'Code, design files and accounts are yours after the final payment. Domain, hosting and store accounts are in your name from day one.',
  },
  { title: '30 days of free fixes', text: 'For 30 days after launch we fix any bug in what we built, at no cost.' },
];

// The first project gets the large card with its own art; the next two get small cards in the
// Work page looks. Cards link once their case study is written.
const [featured, ...others] = projects;
const featuredUrl = featured ? projectUrl(featured) : null;
const featuredResult = featured?.caseStudy?.results[0];
const FeaturedCard = featuredUrl ? 'a' : 'article';
const smallCards = others.slice(0, 2).map((project) => ({ project, url: projectUrl(project) }));

// Public tools a visitor can point at this site. They always show live results, so no score is
// typed into the page and nothing can go stale. The URL follows the site's own address.
const home = new URL('/', Astro.site).href;
const checks = [
  {
    name: 'Speed and Core Web Vitals',
    text: 'Google PageSpeed Insights, run on this page now.',
    href: `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(home)}`,
    external: true,
  },
  {
    name: 'Structured data',
    text: 'The Schema.org validator reads what this page tells search engines about us.',
    href: `https://validator.schema.org/#url=${encodeURIComponent(home)}`,
    external: true,
  },
  {
    name: 'Ready for AI assistants',
    text: 'Our llms.txt: a plain-text map of the site for AI assistants and crawlers.',
    href: '/llms.txt',
    external: false,
  },
];
---

<Base
  title={`${site.name} · Digital Products, Built to Launch`}
  fullTitle
  description={`${site.name} designs and builds websites, web and mobile apps, desktop apps, Telegram bots and browser extensions, then helps them grow through search.`}
>
  <!-- Hero: one sentence, two actions, three written promises -->
  <section class="hero bg-paper">
    <div class="container hero__inner">
      <h1 class="hero__title">We build the parts of your product <span class="highlight">people touch.</span></h1>
      <p class="hero__lede">
        Websites, web and mobile apps, Telegram bots, browser extensions and AI features. One team designs them, builds
        them and launches them, then helps them get found.
      </p>
      <div class="hero__actions">
        <a href="/contact" class="btn btn--primary btn--lg" data-book-call data-umami-event="Book a call" data-umami-event-from="hero">
          Book a free call<Icon name="arrow-right" />
        </a>
        <a href={proofLink.href} class="btn btn--outline btn--lg">{proofLink.label}</a>
      </div>
      <ul class="hero__promises">
        {
          promises.map((promise) => (
            <li>
              <Icon name="check" size={16} strokeWidth={2.8} />
              {promise}
            </li>
          ))
        }
      </ul>
      {
        chips.length > 0 && (
          <div class="hero__proof">
            <span>Trusted by</span>
            <ul class="chip-list">
              {chips.map((project) => <><li class="chip">{project.name}</li>{'\n'}</>)}
            </ul>
            {clients.length > chips.length && <a href="/clients" class="hero__more">+ more brands</a>}
          </div>
        )
      }
    </div>
  </section>

  <!-- What we build: a working piece of each kind of project -->
  <section id="what-we-do" class="bg-paper">
    <div class="container block block--bench">
      <div class="block__head">
        <div class="block__title">
          <h2 class="h2">What we build.</h2>
          <p class="block__intro">Each tile is a small working piece of the kind of thing we make. Go ahead, touch them.</p>
        </div>
        <a href="/services" class="text-link">All services<Icon name="arrow-right" /></a>
      </div>
      <Workbench />
    </div>
  </section>

  <!-- In numbers -->
  {
    stats.length > 0 && (
      <section aria-label="In numbers" class="bg-white border-top">
        <dl class="stats">
          {stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <!-- Recent work -->
  {
    featured && (
      <section class="bg-paper">
        <div class="container block">
          <div class="block__head">
            <div class="block__title">
              <h2 class="h2">Recent work.</h2>
            </div>
            <a href="/work" class="text-link">All work<Icon name="arrow-right" /></a>
          </div>

          <div class="work">
            <FeaturedCard
              href={featuredUrl ?? undefined}
              class:list={['card', 'featured', { 'featured--compact': !featured.summary && !featuredResult && !featuredUrl }]}
            >
              <div class="shot shot--cyan featured__shot">
                <svg aria-hidden="true" viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" fill="none">
                  <defs>
                    <linearGradient id="work-a" x1="0" y1="0" x2="600" y2="400" gradientUnits="userSpaceOnUse">
                      <stop offset="0" stop-color="#22D3DD" />
                      <stop offset="1" stop-color="#2F8CF6" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M-40 300 C 120 180, 220 420, 360 280 C 480 160, 520 60, 660 90"
                    stroke="url(#work-a)"
                    stroke-width="72"
                    stroke-linecap="round"
                  />
                </svg>
                {featured.image && (
                  <Image
                    src={featured.image.src}
                    alt={featured.image.alt}
                    widths={[640, 960, 1280, 1600]}
                    sizes="(min-width: 1240px) 720px, (min-width: 800px) 58vw, 88vw"
                    class="shot__img"
                  />
                )}
              </div>
              <div class="featured__body">
                <div class="featured__copy">
                  <span class="tagline">{cardLine(featured)}</span>
                  <h3 class="featured__name">{featured.name}</h3>
                  {featured.summary && <p class="featured__summary">{featured.summary}</p>}
                </div>
                {(featuredResult || featuredUrl || featured.site) && (
                  <div class="featured__foot">
                    {featuredResult && (
                      <div class="featured__metric">
                        <span class="featured__value">{featuredResult.value}</span>
                        <span class="featured__label">{featuredResult.label}</span>
                      </div>
                    )}
                    {featuredUrl ? (
                      <span class="featured__read">
                        Read the case
                        <Icon name="arrow-right" />
                      </span>
                    ) : (
                      featured.site && (
                        <a href={featured.site} class="featured__read" target="_blank" rel="noopener">
                          Visit {new URL(featured.site).hostname}
                          <span class="visually-hidden"> (opens in a new tab)</span>
                          <Icon name="arrow-up-right" />
                        </a>
                      )
                    )}
                  </div>
                )}
              </div>
            </FeaturedCard>

            {smallCards.length > 0 && (
              <div class="work__grid">
                {smallCards.map(({ project, url }) => {
                  const Card = url ? 'a' : 'article';
                  const gradientId = `work-${project.slug}`;
                  return (
                    <Card href={url ?? undefined} class="card">
                      <div class:list={['shot', `shot--${project.look.tone}`, 'small__shot']}>
                        <svg aria-hidden="true" viewBox="0 0 600 240" preserveAspectRatio="xMidYMid slice" fill="none">
                          <defs>
                            <linearGradient id={gradientId} x1="0" y1="0" x2="600" y2="240" gradientUnits="userSpaceOnUse">
                              <stop offset="0" stop-color={project.look.gradient[0]} />
                              <stop offset="1" stop-color={project.look.gradient[1]} />
                            </linearGradient>
                          </defs>
                          <path d={project.look.path} stroke={`url(#${gradientId})`} stroke-width="60" stroke-linecap="round" />
                        </svg>
                        {project.image && (
                          <Image
                            src={project.image.src}
                            alt={project.image.alt}
                            widths={[480, 800, 1200]}
                            sizes="(min-width: 1240px) 560px, (min-width: 800px) 45vw, 88vw"
                            class="shot__img"
                          />
                        )}
                      </div>
                      <div class="small__body">
                        <span class="tagline">{cardLine(project)}</span>
                        <h3 class="small__name">{project.name}</h3>
                        {project.summary && <p class="small__summary">{project.summary}</p>}
                        {!url && project.site && (
                          <a href={project.site} class="small__visit" target="_blank" rel="noopener">
                            Visit {new URL(project.site).hostname}
                            <span class="visually-hidden"> (opens in a new tab)</span>
                            <Icon name="arrow-up-right" />
                          </a>
                        )}
                      </div>
                    </Card>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- Checks a visitor can run on this site: proof that needs no client permission -->
  <section class="bg-paper">
    <div class="container block">
      <div class="block__head">
        <div class="block__title">
          <h2 class="h2">Check our work on this site.</h2>
          <p class="block__intro">Don't take our word for it. Run the checks a developer would, on this site, live.</p>
        </div>
      </div>
      <ul class="checks">
        {
          checks.map((check) => (
            <li>
              <a
                href={check.href}
                class="checks__link"
                {...(check.external ? { target: '_blank', rel: 'noopener' } : {})}
                data-umami-event="Site check"
                data-umami-event-check={check.name}
              >
                <span class="checks__name">{check.name}</span>
                <span class="checks__text">
                  <span>
                    {check.text}
                    {check.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                  </span>
                  <Icon name={check.external ? 'arrow-up-right' : 'arrow-right'} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Terms: what is promised in writing before anyone pays -->
  <section class="bg-paper">
    <div class="container block">
      <div class="block__head">
        <div class="block__title">
          <h2 class="h2">What you get in writing.</h2>
          <p class="block__intro">How every project works, before you sign anything.</p>
        </div>
        <a href="/services#terms" class="text-link">All terms<Icon name="arrow-right" /></a>
      </div>
      <dl class="terms">
        {
          terms.map((term) => (
            <div class="terms__row">
              <dt class="terms__title">{term.title}</dt>
              <dd class="terms__text">{term.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand title="Tell us what you want to launch." text="A free 30-minute call. You leave with a clear next step, and a fixed price follows in writing." pad="bottom" />
</Base>

<style>
  /* ---------- Hero ---------- */

  .hero__inner {
    padding-top: clamp(64px, 9vw, 112px);
    padding-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* One sentence; as in every page title, its last words sit in the highlight. */
  .hero__title {
    margin: 0;
    max-width: 14em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero__lede {
    margin: 24px 0 0;
    max-width: 38em;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .hero__actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__promises {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .hero__promises li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero__promises :global(svg) {
    color: var(--teal);
  }
  .hero__proof {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    font-weight: 700;
    font-size: 14px;
    color: var(--ink-2);
  }
  .hero__more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: 15px;
  }

  /* ---------- Section blocks ---------- */

  .block {
    padding-top: 72px;
    padding-bottom: 72px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .block--bench {
    padding-top: 40px;
  }
  .block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
  }
  .block__title {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ---------- Recent work ---------- */

  .work {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .featured {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0;
  }
  .featured__shot {
    flex: 3 1 480px;
    min-height: 400px;
  }
  /* Until the project has a summary, a result or a case study, the card is only its name: keep it short. */
  .featured--compact .featured__shot {
    min-height: 240px;
  }
  .featured__body {
    flex: 2 1 320px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 40px;
  }
  .featured__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .featured__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.05;
  }
  .featured__summary {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .featured__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .featured__metric {
    display: flex;
    flex-direction: column;
  }
  .featured__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
  }
  .featured__label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .featured__read {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 16px;
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 24px;
  }
  .small__shot {
    min-height: 240px;
  }
  .small__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
  }
  .small__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.1;
  }
  .small__summary {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .small__visit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 700;
    font-size: 15px;
  }

  /* ---------- Checks on this site ---------- */

  /* One line under a section title. */
  .block__intro {
    margin: 0;
    max-width: 640px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .checks {
    list-style: none;
    margin: 0;
    padding: 8px clamp(20px, 3vw, 36px);
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-tile);
  }
  .checks li + li .checks__link {
    border-top: 1px solid var(--line-soft);
  }
  .checks__link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 40px;
    padding: 22px 0;
    color: var(--ink);
    text-decoration: none;
  }
  .checks__name {
    flex: 1 1 300px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.15;
  }
  .checks__text {
    flex: 2 1 360px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .checks__text :global(svg) {
    flex: none;
    color: var(--ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .checks__link:hover .checks__name {
      color: var(--teal-ink);
    }
  }

  /* ---------- Terms ---------- */

  .terms {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-tile);
    padding: 8px clamp(20px, 3vw, 36px);
  }
  .terms__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 8px 40px;
    padding: 22px 0;
  }
  .terms__row + .terms__row {
    border-top: 1px solid var(--line-soft);
  }
  .terms__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.25;
  }
  .terms__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  @media (max-width: 720px) {
    .terms__row {
      grid-template-columns: 1fr;
    }
  }
</style>
