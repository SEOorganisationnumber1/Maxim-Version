---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { filled, numbers, services, site, type Service } from '../data/site';
import { projects, projectUrl, serviceLine } from '../data/projects';
import { ribbonPath } from '../scripts/hero-ribbons';

/** "Companies we scaled:" chips. Past CHIP_LIMIT the rest are behind "+ more brands". */
const CHIP_LIMIT = 4;
const chips = projects.slice(0, CHIP_LIMIT);

/** The numbers band shows only the figures that are set, and disappears without any. */
const stats = filled([
  { value: numbers.projectsShipped, label: 'projects shipped' },
  { value: numbers.yearsInSearch, label: 'years in search' },
  { value: numbers.marketsServed, label: 'markets served' },
  { value: numbers.retention, label: 'clients who stay past year one' },
]);

// Home keeps its own discipline copy (it differs slightly from the Services page).
const disciplineCopy: Record<Service, string> = {
  Design:
    'Brand and interface design in Figma. A system of components, not a pile of pages, so the build is fast and every new page stays on-brand.',
  'Web Development':
    'Sites and web apps on modern frameworks. Server-rendered, typed and fast by default. Core Web Vitals are a build requirement, not an afterthought.',
  SEO: 'Search Engine Optimization. Technical audits, search-intent mapping, content and authority. We go after the queries that bring buyers, not just visitors.',
  GEO: 'Generative Engine Optimization. We structure your site and content so ChatGPT, Gemini and Perplexity can read, trust and cite your brand.',
  AEO: 'Answer Engine Optimization. Clear, structured answers that win featured snippets, AI Overviews and voice results.',
};

const pad = (n: number): string => String(n).padStart(2, '0');

// The first project gets the large card with its own art; the next two get small cards in the
// Work page looks. Cards link once their case study is written.
const [featured, ...others] = projects;
const featuredUrl = featured ? projectUrl(featured) : null;
const featuredResult = featured?.caseStudy?.results[0];
const FeaturedCard = featuredUrl ? 'a' : 'article';
const smallCards = others.slice(0, 2).map((project) => ({ project, url: projectUrl(project) }));

const methods = [
  {
    title: 'Audit',
    text: 'A full technical crawl, a content gap map, and a check of how Google and AI engines describe you today.',
  },
  {
    title: 'Build',
    text: 'Design and development on a modern stack: semantic markup, structured data and fast pages from the first commit.',
  },
  {
    title: 'Publish',
    text: 'Content mapped to search intent and to the real questions people put to AI assistants.',
  },
  {
    title: 'Measure',
    text: "Rankings, AI citations and qualified leads in one monthly report. What works gets more budget. What doesn't gets cut.",
  },
];
---

<Base
  title={`${site.name} · SEO That Brings Qualified Leads`}
  fullTitle
  description="More visibility. Better traffic. Qualified leads. We design, build and optimise so that when people ask Google, ChatGPT or Gemini, the answer is you."
>
  <!-- Hero -->
  <section class="hero bg-paper border-bottom" data-hero-ribbons>
    <div aria-hidden="true" class="hero__art hero__art--left" data-ribbon-art="left">
      <svg viewBox="0 0 400 640" preserveAspectRatio="xMaxYMid slice" fill="none">
        <defs>
          <linearGradient id="hero-a" data-ribbon-gradient x1="0" y1="0" x2="400" y2="640" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#22D3DD"></stop>
            <stop offset="0.6" stop-color="#2FB4F0"></stop>
            <stop offset="1" stop-color="#2F8CF6"></stop>
          </linearGradient>
          <linearGradient id="hero-b" data-ribbon-gradient x1="0" y1="440" x2="220" y2="660" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#2F8CF6"></stop>
            <stop offset="1" stop-color="#5B4FE9"></stop>
          </linearGradient>
        </defs>
        <path data-ribbon="left-blob" d={ribbonPath('left-blob')} fill="#DFF6F9"></path>
        <path
          data-ribbon="left-ribbon"
          d={ribbonPath('left-ribbon')}
          stroke="url(#hero-a)"
          stroke-width="78"
          stroke-linecap="round"></path>
        <path
          data-ribbon="left-accent"
          d={ribbonPath('left-accent')}
          stroke="url(#hero-b)"
          stroke-width="104"
          stroke-linecap="round"></path>
      </svg>
    </div>
    <div aria-hidden="true" class="hero__art hero__art--right" data-ribbon-art="right">
      <svg viewBox="0 0 260 640" preserveAspectRatio="xMinYMid slice" fill="none">
        <defs>
          <linearGradient id="hero-c" data-ribbon-gradient x1="260" y1="0" x2="60" y2="640" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#2F8CF6"></stop>
            <stop offset="0.5" stop-color="#2FB4F0"></stop>
            <stop offset="1" stop-color="#22D3DD"></stop>
          </linearGradient>
        </defs>
        <path data-ribbon="right-blob" d={ribbonPath('right-blob')} fill="#E4EEFF"></path>
        <path
          data-ribbon="right-ribbon"
          d={ribbonPath('right-ribbon')}
          stroke="url(#hero-c)"
          stroke-width="70"
          stroke-linecap="round"></path>
      </svg>
    </div>

    <div class="hero__content">
      <h1 class="hero__title">
        <span>SEO That Brings</span>
        <span><span class="highlight">Qualified</span> <span class="hero__accent">Leads.</span></span>
      </h1>

      <div class="hero__row">
        <span class="hero__label">We do</span>
        <ul class="chip-list">
          {services.map((service) => <><li class="chip">{service}</li>{'\n'}</>)}
        </ul>
      </div>

      <p class="hero__tagline">{site.tagline}</p>

      {
        chips.length > 0 && (
          <div class="hero__row">
            <span class="hero__label">Companies we scaled:</span>
            <ul class="chip-list">
              {chips.map((project) => <><li class="chip chip--dark">{project.name}</li>{'\n'}</>)}
            </ul>
            {projects.length > chips.length && <a href="/clients" class="hero__more">+ more brands</a>}
          </div>
        )
      }

      <div class="hero__actions">
        <a href="/contact" class="btn btn--primary" data-umami-event="Start a project" data-umami-event-from="hero">
          Start a project<Icon name="arrow-right" />
        </a>
        <a href="/work" class="btn btn--outline" data-motion-fallback>See the work</a>
      </div>
    </div>

    <!-- Pause control for the ambient ribbon motion (WCAG 2.2.2). Revealed by the script only when motion can run. -->
    <button
      type="button"
      class="hero__motion"
      data-motion-toggle
      data-state="playing"
      aria-label="Pause background animation"
      hidden
    >
      <svg class="hero__motion-pause" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
        <path d="M9 6v12"></path>
        <path d="M15 6v12"></path>
      </svg>
      <svg class="hero__motion-play" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5z"></path>
      </svg>
    </button>
  </section>

  <!-- In numbers -->
  {
    stats.length > 0 && (
      <section aria-label="In numbers" class="bg-white border-bottom">
        <dl class="stats">
          {stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <!-- Statement -->
  <section class="bg-paper">
    <div class="container statement">
      <p class="statement__text">
        Search has changed. People put the same question to Google, ChatGPT and Gemini. We design, build
        and optimise so that <span class="statement__accent">the answer is you.</span>
      </p>
      <a href="/company" class="text-link statement__link">About the company<Icon name="arrow-right" /></a>
    </div>
  </section>

  <!-- Five disciplines -->
  <section class="bg-white border-top">
    <div class="container block">
      <div class="block__head">
        <div class="block__title">
          <h2 class="h2">Five disciplines. One team.</h2>
        </div>
        <a href="/services" class="text-link">All services<Icon name="arrow-right" /></a>
      </div>
      <ol class="disciplines">
        {
          services.map((service, i) => (
            <li class="discipline">
              <div class="discipline__name">
                <span class="num">{pad(i + 1)}</span>
                <h3>{service}</h3>
              </div>
              <p class="discipline__text">{disciplineCopy[service]}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Companies we scaled -->
  {
    featured && (
      <section class="bg-paper border-top">
        <div class="container block">
          <div class="block__head">
            <div class="block__title">
              <h2 class="h2">Companies we scaled.</h2>
            </div>
            <a href="/work" class="text-link">All work<Icon name="arrow-right" /></a>
          </div>

          <div class="work">
            <FeaturedCard
              href={featuredUrl ?? undefined}
              class:list={['card', 'featured', { 'featured--compact': !featured.summary && !featuredResult && !featuredUrl }]}
            >
              <div class="shot shot--cyan featured__shot">
                <svg aria-hidden="true" viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" fill="none">
                  <defs>
                    <linearGradient id="work-a" x1="0" y1="0" x2="600" y2="400" gradientUnits="userSpaceOnUse">
                      <stop offset="0" stop-color="#22D3DD" />
                      <stop offset="1" stop-color="#2F8CF6" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M-40 300 C 120 180, 220 420, 360 280 C 480 160, 520 60, 660 90"
                    stroke="url(#work-a)"
                    stroke-width="72"
                    stroke-linecap="round"
                  />
                </svg>
              </div>
              <div class="featured__body">
                <div class="featured__copy">
                  <span class="tagline">{serviceLine(featured.services)}</span>
                  <h3 class="featured__name">{featured.name}</h3>
                  {featured.summary && <p class="featured__summary">{featured.summary}</p>}
                </div>
                {(featuredResult || featuredUrl) && (
                  <div class="featured__foot">
                    {featuredResult && (
                      <div class="featured__metric">
                        <span class="featured__value">{featuredResult.value}</span>
                        <span class="featured__label">{featuredResult.label}</span>
                      </div>
                    )}
                    {featuredUrl && (
                      <span class="featured__read">
                        Read the case
                        <Icon name="arrow-right" />
                      </span>
                    )}
                  </div>
                )}
              </div>
            </FeaturedCard>

            {smallCards.length > 0 && (
              <div class="work__grid">
                {smallCards.map(({ project, url }) => {
                  const Card = url ? 'a' : 'article';
                  const gradientId = `work-${project.slug}`;
                  return (
                    <Card href={url ?? undefined} class="card">
                      <div class:list={['shot', `shot--${project.look.tone}`, 'small__shot']}>
                        <svg aria-hidden="true" viewBox="0 0 600 240" preserveAspectRatio="xMidYMid slice" fill="none">
                          <defs>
                            <linearGradient id={gradientId} x1="0" y1="0" x2="600" y2="240" gradientUnits="userSpaceOnUse">
                              <stop offset="0" stop-color={project.look.gradient[0]} />
                              <stop offset="1" stop-color={project.look.gradient[1]} />
                            </linearGradient>
                          </defs>
                          <path d={project.look.path} stroke={`url(#${gradientId})`} stroke-width="60" stroke-linecap="round" />
                        </svg>
                      </div>
                      <div class="small__body">
                        <span class="tagline">{serviceLine(project.services)}</span>
                        <h3 class="small__name">{project.name}</h3>
                        {project.summary && <p class="small__summary">{project.summary}</p>}
                      </div>
                    </Card>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- Modern methods -->
  <section class="bg-white border-top">
    <div class="container block block--methods">
      <div class="methods__head">
        <h2 class="h2">Modern methods. Nothing wasted.</h2>
        <p class="methods__intro">
          We only use approaches that work in search right now, and we drop them the moment they stop.
        </p>
      </div>
      <ol class="rule-grid">
        {
          methods.map((step, i) => (
            <li>
              <span class="num">{pad(i + 1)}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand title="Tell us what you want to rank for." tone="white" pad="full" />
</Base>

<script>
  import { startHeroRibbons } from '../scripts/hero-ribbons';

  const hero = document.querySelector<HTMLElement>('[data-hero-ribbons]');
  if (hero) startHeroRibbons(hero);
</script>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero__art {
    position: absolute;
    top: 0;
    bottom: 0;
  }
  .hero__art--left {
    left: 0;
    width: max(0px, calc((100% - 820px) * 0.6));
  }
  .hero__art--right {
    right: 0;
    width: max(0px, calc((100% - 820px) * 0.4));
  }
  .hero__art svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Pause control for the ribbon motion: an opaque disc so the moving art never shows through it. */
  .hero__motion {
    position: absolute;
    right: 20px;
    bottom: 20px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1.5px solid rgb(10 17 40 / 0.72);
    border-radius: 50%;
    background: var(--white);
    color: rgb(10 17 40 / 0.72);
    cursor: pointer;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .hero__motion[hidden] {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero__motion:hover {
      color: var(--ink);
      border-color: var(--ink);
    }
  }
  /* Two-tone ring: readable over paper and every stop of the ribbon gradient. */
  .hero__motion:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    outline: 3px solid var(--ink);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--white);
  }
  .hero__motion:active {
    transform: scale(0.96);
  }
  .hero__motion[data-state='playing'] .hero__motion-play,
  .hero__motion[data-state='paused'] .hero__motion-pause {
    display: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin-left: max(0px, calc((100% - 820px) * 0.6));
    padding: 96px var(--gutter) 104px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 5.6vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    display: flex;
    flex-direction: column;
    gap: 0.08em;
  }
  .hero__accent {
    color: var(--teal);
  }
  .hero__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
  }
  .hero__label {
    font-weight: 700;
    font-size: 15px;
  }
  .hero__tagline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.3;
  }
  .hero__more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: 15px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ---------- Statement ---------- */

  .statement {
    padding-top: 112px;
    padding-bottom: 112px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .statement__text {
    margin: 0;
    max-width: 1040px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 3.6vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .statement__accent {
    color: var(--teal);
  }
  .statement__link {
    align-self: flex-start;
  }

  /* ---------- Section blocks ---------- */

  .block {
    padding-top: 96px;
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .block--methods {
    gap: 56px;
  }
  .block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
  }
  .block__title {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ---------- Five disciplines ---------- */

  .disciplines {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1.5px solid var(--ink);
  }
  .discipline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 40px;
    padding: 28px 0;
    border-top: 1.5px solid var(--ink);
  }
  .discipline__name {
    flex: 1 1 300px;
    display: flex;
    align-items: baseline;
    gap: 20px;
  }
  .discipline__name h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.1;
  }
  .discipline__text {
    flex: 2 1 360px;
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* ---------- Companies we scaled ---------- */

  .work {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .featured {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0;
  }
  .featured__shot {
    flex: 3 1 480px;
    min-height: 400px;
  }
  /* Until the project has a summary, a result or a case study, the card is only its name: keep it short. */
  .featured--compact .featured__shot {
    min-height: 240px;
  }
  .featured__body {
    flex: 2 1 320px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 40px;
  }
  .featured__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .featured__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.05;
  }
  .featured__summary {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .featured__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .featured__metric {
    display: flex;
    flex-direction: column;
  }
  .featured__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
  }
  .featured__label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .featured__read {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 16px;
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 24px;
  }
  .small__shot {
    min-height: 240px;
  }
  .small__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
  }
  .small__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.1;
  }
  .small__summary {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* ---------- Modern methods ---------- */

  .methods__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 760px;
  }
  .methods__intro {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
  }
</style>
