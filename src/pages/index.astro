---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Workbench from '../components/Workbench.astro';
import { Image } from 'astro:assets';
import { filled, numbers, site } from '../data/site';
import { cardLine, clients, projects, projectUrl } from '../data/projects';
import { ribbonPath } from '../scripts/hero-ribbons';

/** "Trusted by:" chips, clients only (never our own products). Past CHIP_LIMIT the rest are behind "+ more brands". */
const CHIP_LIMIT = 4;
const chips = clients.slice(0, CHIP_LIMIT);

/** The numbers band shows only the figures that are set, and disappears without any. */
const stats = filled([
  { value: numbers.projectsShipped, label: 'projects shipped' },
  { value: numbers.yearsInBusiness, label: 'years in business' },
  { value: numbers.marketsServed, label: 'markets served' },
  { value: numbers.retention, label: 'clients who stay past year one' },
]);

/** Written promises from the Services terms: the trust we can offer without faces or logos. */
const promises = ['Free 30-minute call', 'Fixed price in writing', 'You own the code'];

/** The terms that matter most before a first call. The full list lives on Services. */
const terms = [
  { title: 'A fixed price, in writing', text: 'Agreed before any work starts.' },
  { title: 'Pay in stages', text: 'Half to start, half at launch.' },
  { title: 'Everything is yours', text: 'Code, designs and accounts, in your name.' },
  { title: '30 days of free fixes', text: 'Any bug after launch, fixed at no cost.' },
];
// Work we built for others leads: the first gets the large card with its own art, the next two get
// small cards in the Work page looks. Cards link once their case study is written. Our own product
// follows as one line, never as the lead case.
const built = projects.filter((project) => !project.own);
const ownProduct = projects.find((project) => project.own && project.site);
const [featured, ...others] = built;
const featuredUrl = featured ? projectUrl(featured) : null;
const featuredResult = featured?.caseStudy?.results[0];
const FeaturedCard = featuredUrl ? 'a' : 'article';
const smallCards = others.slice(0, 2).map((project) => ({ project, url: projectUrl(project) }));

---

<Base
  title={`${site.name} · Digital Products, Built to Launch`}
  fullTitle
  description={`${site.name} designs and builds websites, web and mobile apps, desktop apps, Telegram bots and browser extensions, then helps them grow through search.`}
>
  <!-- Hero: the brand's ribbons, one sentence, two actions, three written promises -->
  <section class="hero" data-hero-ribbons>
    <div aria-hidden="true" class="hero__art hero__art--left" data-ribbon-art="left">
      <svg viewBox="0 0 400 640" preserveAspectRatio="xMaxYMid slice" fill="none">
        <defs>
          <linearGradient id="hero-a" data-ribbon-gradient x1="0" y1="0" x2="400" y2="640" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#22D3DD"></stop>
            <stop offset="0.6" stop-color="#2FB4F0"></stop>
            <stop offset="1" stop-color="#2F8CF6"></stop>
          </linearGradient>
          <linearGradient id="hero-b" data-ribbon-gradient x1="0" y1="440" x2="220" y2="660" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#2F8CF6"></stop>
            <stop offset="1" stop-color="#5B4FE9"></stop>
          </linearGradient>
        </defs>
        <path data-ribbon="left-blob" d={ribbonPath('left-blob')} fill="#DFF6F9"></path>
        <path
          data-ribbon="left-ribbon"
          pathLength="1"
          class="ribbon-stroke"
          d={ribbonPath('left-ribbon')}
          stroke="url(#hero-a)"
          stroke-width="78"
          stroke-linecap="round"></path>
        <path
          data-ribbon="left-accent"
          pathLength="1"
          class="ribbon-stroke"
          d={ribbonPath('left-accent')}
          stroke="url(#hero-b)"
          stroke-width="104"
          stroke-linecap="round"></path>
      </svg>
    </div>
    <div aria-hidden="true" class="hero__art hero__art--right" data-ribbon-art="right">
      <svg viewBox="0 0 260 640" preserveAspectRatio="xMinYMid slice" fill="none">
        <defs>
          <linearGradient id="hero-c" data-ribbon-gradient x1="260" y1="0" x2="60" y2="640" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#2F8CF6"></stop>
            <stop offset="0.5" stop-color="#2FB4F0"></stop>
            <stop offset="1" stop-color="#22D3DD"></stop>
          </linearGradient>
        </defs>
        <path data-ribbon="right-blob" d={ribbonPath('right-blob')} fill="#E4EEFF"></path>
        <path
          data-ribbon="right-ribbon"
          pathLength="1"
          class="ribbon-stroke"
          d={ribbonPath('right-ribbon')}
          stroke="url(#hero-c)"
          stroke-width="70"
          stroke-linecap="round"></path>
      </svg>
    </div>

    <div class="hero__content">
      <h1 class="hero__title">We design, build and launch <span class="highlight hero__mark">websites and apps.</span></h1>
      <p class="hero__lede">Plus Telegram bots, browser extensions and AI tools. One team, from first sketch to launch day.</p>
      <div class="hero__actions">
        <a href="/contact" class="btn btn--primary btn--lg" data-book-call data-umami-event="Book a call" data-umami-event-from="hero">
          Book a call<Icon name="arrow-right" />
        </a>
        <a href="/work" class="btn btn--outline btn--lg" data-motion-fallback>See our work</a>
      </div>
      <ul class="hero__promises">
        {
          promises.map((promise) => (
            <li>
              <Icon name="check" size={16} strokeWidth={2.8} />
              {promise}
            </li>
          ))
        }
      </ul>
      {
        chips.length > 0 && (
          <div class="hero__proof">
            <span>Trusted by</span>
            <ul class="chip-list">
              {chips.map((project) => <><li class="chip">{project.name}</li>{'\n'}</>)}
            </ul>
            {clients.length > chips.length && <a href="/clients" class="hero__more">+ more brands</a>}
          </div>
        )
      }
    </div>

    <!-- Pause control for the ambient ribbon motion (WCAG 2.2.2). Revealed by the script only when motion can run. -->
    <button
      type="button"
      class="hero__motion"
      data-motion-toggle
      data-state="playing"
      aria-label="Pause background animation"
      hidden
    >
      <svg class="hero__motion-pause" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
        <path d="M9 6v12"></path>
        <path d="M15 6v12"></path>
      </svg>
      <svg class="hero__motion-play" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5z"></path>
      </svg>
    </button>
  </section>

  <!-- What we build: a working piece of each kind of project -->
  <section id="what-we-do" class="bg-paper">
    <div class="container block block--bench">
      <div class="block__head">
        <div class="block__title">
          <h2 class="h2">What we build.</h2>
          <p class="block__intro">Try them. They work.</p>
        </div>
        <a href="/services" class="text-link">All services<Icon name="arrow-right" /></a>
      </div>
      <Workbench />
    </div>
  </section>

  <!-- In numbers -->
  {
    stats.length > 0 && (
      <section aria-label="In numbers" class="bg-white border-top">
        <dl class="stats">
          {stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <!-- Recent work -->
  {
    featured && (
      <section class="bg-paper">
        <div class="container block">
          <div class="block__head">
            <div class="block__title">
              <h2 class="h2">Recent work.</h2>
            </div>
            <a href="/work" class="text-link">All work<Icon name="arrow-right" /></a>
          </div>

          <div class="work">
            <FeaturedCard
              href={featuredUrl ?? undefined}
              class:list={['card', 'featured', { 'featured--compact': !featured.summary && !featuredResult && !featuredUrl }]}
            >
              <div class="shot shot--cyan featured__shot">
                <svg aria-hidden="true" viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" fill="none">
                  <defs>
                    <linearGradient id="work-a" x1="0" y1="0" x2="600" y2="400" gradientUnits="userSpaceOnUse">
                      <stop offset="0" stop-color="#22D3DD" />
                      <stop offset="1" stop-color="#2F8CF6" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M-40 300 C 120 180, 220 420, 360 280 C 480 160, 520 60, 660 90"
                    stroke="url(#work-a)"
                    stroke-width="72"
                    stroke-linecap="round"
                  />
                </svg>
                {featured.image && (
                  <Image
                    src={featured.image.src}
                    alt={featured.image.alt}
                    widths={[640, 960, 1280, 1600]}
                    sizes="(min-width: 1240px) 720px, (min-width: 800px) 58vw, 88vw"
                    class="shot__img"
                  />
                )}
              </div>
              <div class="featured__body">
                <div class="featured__copy">
                  <span class="tagline">{cardLine(featured)}</span>
                  <h3 class="featured__name">{featured.name}</h3>
                  {featured.plain && <p class="featured__summary">{featured.plain}</p>}
                </div>
                {featured.facts.length > 0 && (
                  <ul class="facts" aria-label="What's in it">
                    {featured.facts.map((fact) => (
                      <li>
                        <Icon name="check" size={16} strokeWidth={2.8} />
                        {fact}
                      </li>
                    ))}
                  </ul>
                )}
                {(featuredResult || featuredUrl || featured.site) && (
                  <div class="featured__foot">
                    {featuredResult && (
                      <div class="featured__metric">
                        <span class="featured__value">{featuredResult.value}</span>
                        <span class="featured__label">{featuredResult.label}</span>
                      </div>
                    )}
                    {featuredUrl ? (
                      <span class="featured__read">
                        Read the case
                        <Icon name="arrow-right" />
                      </span>
                    ) : (
                      featured.site && (
                        <a href={featured.site} class="featured__read" target="_blank" rel="noopener">
                          Visit {new URL(featured.site).hostname}
                          <span class="visually-hidden"> (opens in a new tab)</span>
                          <Icon name="arrow-up-right" />
                        </a>
                      )
                    )}
                  </div>
                )}
              </div>
            </FeaturedCard>

            {smallCards.length > 0 && (
              <div class="work__grid">
                {smallCards.map(({ project, url }) => {
                  const Card = url ? 'a' : 'article';
                  const gradientId = `work-${project.slug}`;
                  return (
                    <Card href={url ?? undefined} class="card">
                      <div class:list={['shot', `shot--${project.look.tone}`, 'small__shot']}>
                        <svg aria-hidden="true" viewBox="0 0 600 240" preserveAspectRatio="xMidYMid slice" fill="none">
                          <defs>
                            <linearGradient id={gradientId} x1="0" y1="0" x2="600" y2="240" gradientUnits="userSpaceOnUse">
                              <stop offset="0" stop-color={project.look.gradient[0]} />
                              <stop offset="1" stop-color={project.look.gradient[1]} />
                            </linearGradient>
                          </defs>
                          <path d={project.look.path} stroke={`url(#${gradientId})`} stroke-width="60" stroke-linecap="round" />
                        </svg>
                        {project.image && (
                          <Image
                            src={project.image.src}
                            alt={project.image.alt}
                            widths={[480, 800, 1200]}
                            sizes="(min-width: 1240px) 560px, (min-width: 800px) 45vw, 88vw"
                            class="shot__img"
                          />
                        )}
                      </div>
                      <div class="small__body">
                        <span class="tagline">{cardLine(project)}</span>
                        <h3 class="small__name">{project.name}</h3>
                        {project.plain && <p class="small__summary">{project.plain}</p>}
                        {project.facts.length > 0 && (
                          <ul class="facts facts--small" aria-label="What's in it">
                            {project.facts.map((fact) => (
                              <li>
                                <Icon name="check" size={15} strokeWidth={2.8} />
                                {fact}
                              </li>
                            ))}
                          </ul>
                        )}
                        {!url && project.site && (
                          <a href={project.site} class="small__visit" target="_blank" rel="noopener">
                            Visit {new URL(project.site).hostname}
                            <span class="visually-hidden"> (opens in a new tab)</span>
                            <Icon name="arrow-up-right" />
                          </a>
                        )}
                      </div>
                    </Card>
                  );
                })}
              </div>
            )}

            {ownProduct && ownProduct.site && (
              <div class="own">
                {ownProduct.image && (
                  <Image
                    src={ownProduct.image.src}
                    alt=""
                    widths={[160, 320]}
                    sizes="160px"
                    class="own__img"
                  />
                )}
                <p class="own__text">
                  <b>We run our own product too.</b> {ownProduct.name} {ownProduct.plain?.replace(/^./, (c) => c.toLowerCase())}
                </p>
                <a href={ownProduct.site} class="own__link" target="_blank" rel="noopener">
                  Visit {new URL(ownProduct.site).hostname}
                  <span class="visually-hidden"> (opens in a new tab)</span>
                  <Icon name="arrow-up-right" />
                </a>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- Terms: what is promised in writing before anyone pays -->
  <section class="bg-paper">
    <div class="container block">
      <div class="block__head">
        <div class="block__title">
          <h2 class="h2">What you get in writing.</h2>
          <p class="block__intro">How every project works, before you sign anything.</p>
        </div>
        <a href="/services#terms" class="text-link">All terms<Icon name="arrow-right" /></a>
      </div>
      <dl class="terms">
        {
          terms.map((term) => (
            <div class="terms__row">
              <dt class="terms__title">
                <Icon name="check" size={18} strokeWidth={2.8} />
                {term.title}
              </dt>
              <dd class="terms__text">{term.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand title="Tell us what you want to launch." text="You talk to the people who will build it. We reply within one business day." pad="bottom" />
</Base>

<script>
  import { startHeroRibbons } from '../scripts/hero-ribbons';

  const hero = document.querySelector<HTMLElement>('[data-hero-ribbons]');
  if (hero) {
    startHeroRibbons(hero);
    // The ribbons lean a few pixels toward the pointer (fine pointers only, never with reduced motion).
    // Only two custom properties change; CSS eases the panels after them.
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    let queued = false;
    let x = 0;
    let y = 0;
    hero.addEventListener('pointermove', (event) => {
      if (!fine.matches || still.matches) return;
      const r = hero.getBoundingClientRect();
      x = ((event.clientX - r.left) / r.width) * 2 - 1;
      y = ((event.clientY - r.top) / r.height) * 2 - 1;
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        hero.style.setProperty('--hx', x.toFixed(3));
        hero.style.setProperty('--hy', y.toFixed(3));
      });
    });
    hero.addEventListener('pointerleave', () => {
      hero.style.setProperty('--hx', '0');
      hero.style.setProperty('--hy', '0');
    });
  }
</script>

<style>
  /* ---------- Hero ---------- */

  /* The brand's ribbons on both sides, the sentence centred between them, tall enough to own the first screen. */
  .hero {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    /* A little shorter than the screen, so the next section peeks in and invites the scroll. */
    min-height: clamp(560px, calc(100svh - 77px - 72px), 860px);
    background: var(--paper);
  }
  .hero__art {
    position: absolute;
    top: 0;
    bottom: 0;
  }
  /* Wide panels that run in behind the sentence and fade out before they reach it. They drift a
     few pixels with the pointer, left and right in opposite directions. */
  .hero__art--left {
    left: -24px;
    width: min(664px, max(0px, calc((100% - 940px) / 2 + 244px)));
    -webkit-mask-image: linear-gradient(to right, #000 52%, transparent 96%);
    mask-image: linear-gradient(to right, #000 52%, transparent 96%);
    transform: translate3d(calc(var(--hx, 0) * 14px), calc(var(--hy, 0) * 10px), 0);
  }
  .hero__art--right {
    right: -24px;
    width: min(584px, max(0px, calc((100% - 940px) / 2 + 194px)));
    -webkit-mask-image: linear-gradient(to left, #000 50%, transparent 96%);
    mask-image: linear-gradient(to left, #000 50%, transparent 96%);
    transform: translate3d(calc(var(--hx, 0) * -12px), calc(var(--hy, 0) * -8px), 0);
  }
  .hero__art--left,
  .hero__art--right {
    transition: transform 1200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* The ribbons draw themselves in on load, before the highlight sweeps in. */
  .hero__art :global(.ribbon-stroke) {
    stroke-dasharray: 1;
    animation: ribbon-draw 1300ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .hero__art--left :global(.ribbon-stroke + .ribbon-stroke) {
    animation-delay: 140ms;
  }
  .hero__art--right :global(.ribbon-stroke) {
    animation-delay: 220ms;
  }
  @keyframes ribbon-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .hero__art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 940px;
    padding: 72px var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__title {
    margin: 0;
    max-width: 11.5em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.9rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  /* The one authored moment: the highlight sweeps in behind its words like a marker. The words are
     readable from the first frame (ink), and turn white as the teal arrives. */
  .hero__mark {
    background: linear-gradient(var(--teal), var(--teal)) no-repeat 0 0 / 100% 100%;
    animation: mark 900ms 250ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes mark {
    from {
      background-size: 0% 100%;
      color: var(--ink);
    }
    55% {
      color: var(--ink);
    }
  }
  .hero__lede {
    margin: 26px 0 0;
    max-width: 34em;
    font-size: clamp(1.0625rem, 1.5vw, 1.3rem);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: balance;
  }
  .hero__actions {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .hero__promises {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .hero__promises li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  /* Too narrow for three in a row: a short stack reads better than one line, then two. */
  @media (max-width: 479.98px) {
    .hero__promises {
      display: grid;
      justify-content: center;
      justify-items: start;
      gap: 8px;
    }
  }
  .hero__promises :global(svg) {
    color: var(--teal);
  }
  /* After the highlight lands, the three checks draw in, one after another. */
  .hero__promises :global(svg path) {
    stroke-dasharray: 24;
    stroke-dashoffset: 0;
    animation: check-draw 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero__promises li:nth-child(1) :global(svg path) { animation-delay: 900ms; }
  .hero__promises li:nth-child(2) :global(svg path) { animation-delay: 1000ms; }
  .hero__promises li:nth-child(3) :global(svg path) { animation-delay: 1100ms; }
  @keyframes check-draw {
    from {
      stroke-dashoffset: 24;
    }
  }
  .hero__proof {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 12px;
    font-weight: 700;
    font-size: 14px;
    color: var(--ink-2);
  }
  .hero__more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: 15px;
  }
  /* Pause control for the ribbon motion (WCAG 2.2.2): an opaque disc so the moving art never shows through. */
  .hero__motion {
    position: absolute;
    right: 20px;
    bottom: 20px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color 160ms var(--ease-out),
      border-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .hero__motion[hidden] {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero__motion:hover {
      color: var(--ink);
      border-color: var(--ink);
    }
  }
  .hero__motion:active {
    transform: scale(0.96);
  }
  .hero__motion[data-state='playing'] .hero__motion-play,
  .hero__motion[data-state='paused'] .hero__motion-pause {
    display: none;
  }
  /* Phones: the highlight hugs each wrapped line like a marker instead of filling a slab, and the
     buttons share one width. */
  @media (max-width: 559.98px) {
    .hero__title {
      line-height: 1.12;
    }
    .hero__mark {
      display: inline;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
    .hero__actions {
      flex-direction: column;
      width: 100%;
      max-width: 340px;
    }
  }
  /* Phones: the ribbons become a band under the sentence instead of framing it. */
  @media (max-width: 899.98px) {
    .hero {
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .hero__content {
      order: 1;
      padding-top: 56px;
      padding-bottom: 8px;
    }
    .hero__art--left {
      order: 2;
      position: relative;
      width: 100%;
      height: 190px;
      -webkit-mask-image: none;
      mask-image: none;
      transform: none;
    }
    .hero__art--right {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__mark,
    .hero__promises :global(svg path),
    .hero__art :global(.ribbon-stroke) {
      animation: none;
    }
    .hero__art--left,
    .hero__art--right {
      transform: none;
    }
  }

  /* ---------- Section blocks ---------- */

  .block {
