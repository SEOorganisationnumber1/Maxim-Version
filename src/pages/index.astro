---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Workbench from '../components/Workbench.astro';
import RibbonEnd from '../components/RibbonEnd.astro';
import { Image } from 'astro:assets';
import { filled, numbers, site } from '../data/site';
import { clients, realProjects, projectUrl } from '../data/projects';
import { ribbonPath } from '../scripts/hero-ribbons';

/** "Trusted by:" chips, clients only (never our own products). Past CHIP_LIMIT the rest are behind "+ more brands". */
const CHIP_LIMIT = 4;
const chips = clients.slice(0, CHIP_LIMIT);

/** The numbers band shows only the figures that are set, and disappears without any. */
const stats = filled([
  { value: numbers.projectsShipped, label: 'projects shipped' },
  { value: numbers.yearsInBusiness, label: 'years in business' },
  { value: numbers.marketsServed, label: 'markets served' },
  { value: numbers.retention, label: 'clients who stay past year one' },
]);

/** The terms that matter most before a first call, written as the clauses of an agreement. The full list lives on Services. */
const terms = [
  { title: 'A fixed price, in writing.', text: 'Agreed before any work starts.' },
  { title: 'Pay in stages.', text: 'Half to start, half at launch.' },
  { title: 'Everything is yours.', text: 'Code, designs and accounts, in your name.' },
  { title: '30 days of free fixes.', text: 'Any bug after launch, fixed at no cost.' },
];

// Recent work is a log of real, named projects: work we built for others first, our own product last.
// Each row opens in place to the real screenshot and what we built. With a fine pointer, the
// screenshot also trails the pointer down the list.
const log = [...realProjects.filter((project) => !project.own), ...realProjects.filter((project) => project.own)];

---

<Base
  title={`${site.name} · Digital Products, Built to Launch`}
  fullTitle
  description={`${site.name} designs and builds websites, web and mobile apps, desktop apps, Telegram bots and browser extensions, then helps them grow through search.`}
>
  <!-- Hero: the brand's ribbons, one sentence, two actions -->
  <section class="hero" data-hero-ribbons>
    <div aria-hidden="true" class="hero__art hero__art--left" data-ribbon-art="left">
      <svg viewBox="0 0 400 640" preserveAspectRatio="xMaxYMid slice" fill="none">
        <defs>
          <linearGradient id="hero-a" data-ribbon-gradient x1="0" y1="0" x2="400" y2="640" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#22D3DD"></stop>
            <stop offset="0.6" stop-color="#2FB4F0"></stop>
            <stop offset="1" stop-color="#2F8CF6"></stop>
          </linearGradient>
          <linearGradient id="hero-b" data-ribbon-gradient x1="0" y1="440" x2="220" y2="660" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#2F8CF6"></stop>
            <stop offset="1" stop-color="#5B4FE9"></stop>
          </linearGradient>
        </defs>
        <path data-ribbon="left-blob" d={ribbonPath('left-blob')} fill="#DFF6F9"></path>
        <path
          data-ribbon="left-ribbon"
          pathLength="1"
          class="ribbon-stroke"
          d={ribbonPath('left-ribbon')}
          stroke="url(#hero-a)"
          stroke-width="78"
          stroke-linecap="round"></path>
        <path
          data-ribbon="left-accent"
          pathLength="1"
          class="ribbon-stroke"
          d={ribbonPath('left-accent')}
          stroke="url(#hero-b)"
          stroke-width="104"
          stroke-linecap="round"></path>
      </svg>
    </div>
    <div aria-hidden="true" class="hero__art hero__art--right" data-ribbon-art="right">
      <svg viewBox="0 0 260 640" preserveAspectRatio="xMinYMid slice" fill="none">
        <defs>
          <linearGradient id="hero-c" data-ribbon-gradient x1="260" y1="0" x2="60" y2="640" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#2F8CF6"></stop>
            <stop offset="0.5" stop-color="#2FB4F0"></stop>
            <stop offset="1" stop-color="#22D3DD"></stop>
          </linearGradient>
        </defs>
        <path data-ribbon="right-blob" d={ribbonPath('right-blob')} fill="#E4EEFF"></path>
        <path
          data-ribbon="right-ribbon"
          pathLength="1"
          class="ribbon-stroke"
          d={ribbonPath('right-ribbon')}
          stroke="url(#hero-c)"
          stroke-width="70"
          stroke-linecap="round"></path>
      </svg>
    </div>

    <div class="hero__content">
      <h1 class="hero__title">We design, build and launch <span class="highlight hero__mark">websites and apps.</span></h1>
      <div class="hero__actions">
        <a href="/contact" class="btn btn--primary btn--lg" data-book-call data-umami-event="Book a call" data-umami-event-from="hero">
          Book a call<Icon name="arrow-right" />
        </a>
        <a href="/work" class="btn btn--outline btn--lg" data-motion-fallback>See our work</a>
      </div>
      {
        chips.length > 0 && (
          <div class="hero__proof">
            <span>Trusted by</span>
            <ul class="chip-list">
              {chips.map((project) => <><li class="chip">{project.name}</li>{'\n'}</>)}
            </ul>
            {clients.length > chips.length && <a href="/clients" class="hero__more">+ more brands</a>}
          </div>
        )
      }
    </div>

    <!-- Pause control for the ambient ribbon motion (WCAG 2.2.2). Revealed by the script only when motion can run. -->
    <button
      type="button"
      class="hero__motion"
      data-motion-toggle
      data-state="playing"
      aria-label="Pause background animation"
      hidden
    >
      <svg class="hero__motion-pause" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
        <path d="M9 6v12"></path>
        <path d="M15 6v12"></path>
      </svg>
      <svg class="hero__motion-play" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5z"></path>
      </svg>
    </button>
  </section>

  <!-- What we build: a working piece of each kind of project -->
  <section id="what-we-do" class="bg-paper">
    <div class="container block block--bench">
      <div class="block__head">
        <div class="block__title">
          <h2 class="h2">What we build.</h2>
        </div>
        <a href="/services" class="text-link see-all">All services<Icon name="arrow-right" /></a>
      </div>
      <Workbench />
    </div>
  </section>

  <!-- In numbers -->
  {
    stats.length > 0 && (
      <section aria-label="In numbers" class="bg-white border-top">
        <dl class="stats">
          {stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <!-- Recent work: a log of real, named projects -->
  {
    log.length > 0 && (
      <section class="bg-paper" aria-labelledby="work-title">
        <div class="container block">
          <div class="block__head">
            <h2 class="h2" id="work-title">Recent work.</h2>
            <a href="/work" class="text-link see-all">All work<Icon name="arrow-right" /></a>
          </div>
          <div class="log-wrap" data-log-wrap>
            <ol class="log" data-log>
              {log.map((project) => {
                const url = projectUrl(project);
                const id = `log-${project.slug}`;
                return (
                  <li class="log__row" data-log-row={project.slug}>
                    <button type="button" class="log__toggle" aria-expanded="false" aria-controls={id}>
                      <span class="log__name">
                        {project.name}
                      </span>
                      <span class="log__what">{project.own ? `Our own product. ${project.plain ?? ''}` : project.plain}</span>
                      <span class="log__kind">{project.kind}</span>
                      <span class="log__plus" aria-hidden="true" />
                    </button>
                    <div class="log__open" id={id} inert>
                      <div class="log__inner">
                        <div class="log__detail">
                          {project.image && (
                            <div class="log__shot">
                              <Image
                                src={project.image.src}
                                alt={project.image.alt}
                                widths={[640, 960, 1280]}
                                sizes="(min-width: 1240px) 620px, (min-width: 800px) 52vw, 92vw"
                                loading="lazy"
                              />
                            </div>
                          )}
                          <div class="log__about">
                            {project.summary && <p class="log__summary">{project.summary}</p>}
                            {url && (
                              <a href={url} class="text-link">
                                Read the case
                                <Icon name="arrow-right" />
                              </a>
                            )}
                            {project.site && (
                              <a href={project.site} class="text-link" target="_blank" rel="noopener">
                                Visit {new URL(project.site).hostname}
                                <span class="visually-hidden"> (opens in a new tab)</span>
                                <Icon name="arrow-up-right" />
                              </a>
                            )}
                          </div>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
            <div class="peek" aria-hidden="true" data-peek>
              <div class="peek__card">
                {log.map(
                  (project) =>
                    project.image && (
                      <Image src={project.image.src} alt="" widths={[400, 800]} sizes="320px" loading="lazy" class="peek__img" data-peek-for={project.slug} />
                    ),
                )}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Terms: a written agreement, signed before any work starts -->
  <section class="bg-paper" aria-labelledby="terms-title">
    <div class="container block terms">
      <div class="terms__side">
        <h2 class="h2" id="terms-title">What you get in writing.</h2>
        <p class="block__intro">How every project works, before you sign anything.</p>
        <a href="/services#terms" class="text-link see-all">All terms<Icon name="arrow-right" /></a>
      </div>
      <article class="doc" data-doc aria-labelledby="doc-title">
        <div class="doc__head">
          <h3 class="doc__title" id="doc-title">The {site.shortName} agreement</h3>
          <p class="doc__sub">Signed before any work starts</p>
        </div>
        <dl class="clauses">
          {
            terms.map((term) => (
              <div class="clause">
                <dt>{term.title}</dt>
                <dd>{term.text}</dd>
              </div>
            ))
          }
        </dl>
        <div class="sign" aria-hidden="true">
          <div class="sign__line">
            <svg style="--w: 190px" viewBox="0 0 190 56" fill="none">
              <path
                class="sign__ink sign__ink--us"
                pathLength="1"
                d="M22 8 C 12 22, 6 40, 12 46 C 18 50, 30 40, 38 42 C 44 44, 40 50, 48 46 C 56 42, 58 30, 64 34 C 70 38, 64 46, 72 44 C 80 42, 82 32, 88 36 C 94 40, 90 46, 98 44 C 106 42, 108 30, 116 34 C 122 38, 118 46, 128 42 C 136 38, 140 30, 146 34 C 152 38, 150 46, 158 42 C 166 38, 172 30, 184 28 M 30 52 C 70 46, 120 46, 176 40"
              ></path>
            </svg>
            For {site.name}
          </div>
          <div class="sign__line">
            <svg style="--w: 130px" viewBox="0 0 130 56" fill="none">
              <path
                class="sign__ink sign__ink--you"
                pathLength="1"
                d="M8 14 C 12 24, 18 30, 24 28 C 30 26, 32 16, 34 12 C 30 28, 26 44, 20 50 C 16 54, 12 50, 18 44 C 26 36, 36 34, 44 36 C 52 38, 48 46, 56 44 C 64 42, 66 34, 72 36 C 78 38, 74 46, 82 44 C 90 42, 94 36, 100 38 C 108 40, 112 36, 124 32"
              ></path>
            </svg>
            For you
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Closing: the hero ribbons come back around the last question -->
  <RibbonEnd from="home-end">Tell us what you want to <span class="highlight">launch.</span></RibbonEnd>
</Base>

<script>
  import { startHeroRibbons } from '../scripts/hero-ribbons';

  const hero = document.querySelector<HTMLElement>('[data-hero-ribbons]');
  if (hero) {
    startHeroRibbons(hero);
    // The ribbons lean a few pixels toward the pointer (fine pointers only, never with reduced motion).
    // Only two custom properties change; CSS eases the panels after them.
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    let queued = false;
    let x = 0;
    let y = 0;
    hero.addEventListener('pointermove', (event) => {
      if (!fine.matches || still.matches) return;
      const r = hero.getBoundingClientRect();
      x = ((event.clientX - r.left) / r.width) * 2 - 1;
      y = ((event.clientY - r.top) / r.height) * 2 - 1;
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        hero.style.setProperty('--hx', x.toFixed(3));
        hero.style.setProperty('--hy', y.toFixed(3));
      });
    });
    hero.addEventListener('pointerleave', () => {
      hero.style.setProperty('--hx', '0');
      hero.style.setProperty('--hy', '0');
    });
  }

  // ---------- Recent work: rows open in place; a glance trails the pointer down the list.
  const wrap = document.querySelector<HTMLElement>('[data-log-wrap]');
  if (wrap) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const peek = wrap.querySelector<HTMLElement>('[data-peek]');
    wrap.querySelectorAll<HTMLButtonElement>('.log__toggle').forEach((button) => {
      const row = button.closest<HTMLElement>('.log__row');
      const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (!row || !panel) return;
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        row.classList.toggle('is-open', open);
        panel.inert = !open;
        if (open) peek?.classList.remove('is-on');
      });
    });

    const shots = new Map<string, HTMLElement>();
    peek?.querySelectorAll<HTMLElement>('[data-peek-for]').forEach((img) => shots.set(img.dataset.peekFor ?? '', img));
    if (peek && shots.size > 0) {
      const W = 320;
      const H = 200;
      let x = 0;
      let y = 0;
      let tx = 0;
      let ty = 0;
      let raf = 0;
      let active: HTMLElement | null = null;
      // A little lag and a tilt in the direction of travel, settling when the pointer rests.
      const frame = () => {
        const dx = tx - x;
        x += dx * 0.16;
        y += (ty - y) * 0.16;
        peek.style.setProperty('--px', `${x.toFixed(1)}px`);
        peek.style.setProperty('--py', `${y.toFixed(1)}px`);
        peek.style.setProperty('--pr', `${Math.max(-6, Math.min(6, dx * 0.04)).toFixed(2)}deg`);
        raf = Math.abs(dx) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(frame) : 0;
      };
      const hide = () => {
        peek.classList.remove('is-on');
        active = null;
      };
      wrap.addEventListener('pointermove', (event) => {
        if (!fine.matches || still.matches) return;
        const row = (event.target as Element).closest<HTMLElement>('.log__row');
        const img = row ? shots.get(row.dataset.logRow ?? '') : undefined;
        // No glance over an opened row: its screenshot is already on the page.
        if (!row || !img || row.classList.contains('is-open')) return hide();
        const r = wrap.getBoundingClientRect();
        tx = Math.min(event.clientX - r.left + 28, r.width - W);
        ty = event.clientY - r.top - H / 2;
        if (active !== row) {
          if (!active) {
            x = tx;
            y = ty;
          }
          shots.forEach((el) => el.classList.toggle('is-on', el === img));
          active = row;
        }
        peek.classList.add('is-on');
        if (!raf) raf = requestAnimationFrame(frame);
      });
      wrap.addEventListener('pointerleave', hide);
    }
  }

  // ---------- The agreement signs itself once, when most of it is on screen.
  const doc = document.querySelector<HTMLElement>('[data-doc]');
  if (doc) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          doc.classList.add('is-signed');
          io.disconnect();
        }
      },
      { threshold: 0.6 },
    );
    io.observe(doc);
  }
</script>

<style>
  /* ---------- Hero ---------- */

  /* The brand's ribbons on both sides, the sentence centred between them, tall enough to own the first screen. */
  .hero {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    /* A little shorter than the screen, so the next section peeks in and invites the scroll. It
       starts under the open header bar, so the ribbons run behind it. */
    min-height: clamp(636px, calc(100svh - 72px), 936px);
    margin-top: -76px;
    padding-top: 76px;
    background: var(--paper);
  }
  .hero__art {
    position: absolute;
    top: 0;
    bottom: 0;
  }
  /* Wide panels that run in behind the sentence and fade out before they reach it. They drift a
     few pixels with the pointer, left and right in opposite directions. */
  .hero__art--left {
    left: -24px;
    width: min(664px, max(0px, calc((100% - 940px) / 2 + 244px)));
    -webkit-mask-image: linear-gradient(to right, #000 52%, transparent 96%);
    mask-image: linear-gradient(to right, #000 52%, transparent 96%);
    transform: translate3d(calc(var(--hx, 0) * 14px), calc(var(--hy, 0) * 10px), 0);
  }
  .hero__art--right {
    right: -24px;
    width: min(584px, max(0px, calc((100% - 940px) / 2 + 194px)));
    -webkit-mask-image: linear-gradient(to left, #000 50%, transparent 96%);
    mask-image: linear-gradient(to left, #000 50%, transparent 96%);
    transform: translate3d(calc(var(--hx, 0) * -12px), calc(var(--hy, 0) * -8px), 0);
  }
  .hero__art--left,
  .hero__art--right {
    transition: transform 1200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* The ribbons draw themselves in on load, before the highlight sweeps in. */
  .hero__art :global(.ribbon-stroke) {
    stroke-dasharray: 1;
    animation: ribbon-draw 1300ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .hero__art--left :global(.ribbon-stroke + .ribbon-stroke) {
    animation-delay: 140ms;
  }
  .hero__art--right :global(.ribbon-stroke) {
    animation-delay: 220ms;
  }
  @keyframes ribbon-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .hero__art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 940px;
    padding: 72px var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__title {
    margin: 0;
    max-width: 11.5em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.9rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  /* The one authored moment: the highlight sweeps in behind its words like a marker. The words are
     readable from the first frame (ink), and turn white as the teal arrives. */
  .hero__mark {
    background: linear-gradient(var(--teal), var(--teal)) no-repeat 0 0 / 100% 100%;
    animation: mark 900ms 250ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes mark {
    from {
      background-size: 0% 100%;
      color: var(--ink);
    }
    55% {
      color: var(--ink);
    }
  }
  .hero__actions {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .hero__proof {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 12px;
    font-weight: 700;
    font-size: 14px;
    color: var(--ink-2);
  }
  .hero__more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: 15px;
  }
  /* Pause control for the ribbon motion (WCAG 2.2.2): an opaque disc so the moving art never shows through. */
  .hero__motion {
    position: absolute;
    right: 20px;
    bottom: 20px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color 160ms var(--ease-out),
      border-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .hero__motion[hidden] {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero__motion:hover {
      color: var(--ink);
      border-color: var(--ink);
    }
  }
  .hero__motion:active {
    transform: scale(0.96);
  }
  .hero__motion[data-state='playing'] .hero__motion-play,
  .hero__motion[data-state='paused'] .hero__motion-pause {
    display: none;
  }
  /* Phones: the highlight hugs each wrapped line like a marker instead of filling a slab, and the
     buttons share one width. */
  @media (max-width: 559.98px) {
    .hero__title {
      line-height: 1.12;
    }
    .hero__mark {
      display: inline;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
    .hero__actions {
      flex-direction: column;
      width: 100%;
      max-width: 340px;
    }
  }
  /* Phones: the ribbons become a band under the sentence instead of framing it. */
  @media (max-width: 899.98px) {
    .hero {
      margin-top: -68px;
      padding-top: 68px;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .hero__content {
      order: 1;
      padding-top: 56px;
      padding-bottom: 8px;
    }
    .hero__art--left {
      order: 2;
      position: relative;
      width: 100%;
      height: 190px;
      -webkit-mask-image: none;
      mask-image: none;
      transform: none;
    }
    .hero__art--right {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__mark,
    .hero__art :global(.ribbon-stroke) {
      animation: none;
    }
    .hero__art--left,
    .hero__art--right {
      transform: none;
    }
  }

  /* ---------- Section blocks ---------- */

  .block {
    padding-top: 72px;
    padding-bottom: 72px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .block--bench {
    padding-top: 40px;
  }
  .block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
  }
  .block__title {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ---------- Recent work: a log of real projects ---------- */

  .log-wrap {
    position: relative;
  }
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .log__row {
    border-bottom: 1px solid var(--line);
