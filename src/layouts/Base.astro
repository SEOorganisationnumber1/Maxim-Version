---
import '@fontsource-variable/outfit';
import '@fontsource-variable/manrope';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { services, site } from '../data/site';

interface Props {
  /** Page name; " · {agency}" is appended unless `fullTitle` is set. */
  title: string;
  fullTitle?: boolean;
  description: string;
  /** Header link to mark as current, e.g. '/work'. */
  current?: string;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD objects for this page (FAQPage, Article...). */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  fullTitle = false,
  description,
  current,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} · ${site.name}`;
// Pages build to files (work.html), so the build-time pathname carries ".html";
// canonical URLs use the clean, slashless form that links and the sitemap use.
const cleanPath =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '/')
    .replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(cleanPath, Astro.site);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: Astro.site?.href,
  slogan: site.tagline,
  knowsAbout: [...services],
};
const ld = [organization, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0A1128" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <div class="site">
      <a class="skip-link" href="#main">Skip to content</a>
      <Header current={current} />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
